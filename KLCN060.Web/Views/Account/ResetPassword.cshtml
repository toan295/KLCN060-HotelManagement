@model KLCN060.Web.Models.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="auth-shell">
    <aside class="auth-aside">
        <partial name="_Pines" />
        <div>
            <span class="eyebrow" style="color:#f0c987;">Khôi phục tài khoản</span>
            <h2>Tạo mật khẩu mới cho tài khoản của bạn</h2>
            <ul>
                <li><partial name="_Icon" model='"check"' /> Tối thiểu 8 ký tự</li>
                <li><partial name="_Icon" model='"check"' /> Nên kết hợp chữ hoa, chữ thường, số và ký hiệu</li>
                <li><partial name="_Icon" model='"check"' /> Các phiên đăng nhập cũ sẽ bị đăng xuất</li>
            </ul>
        </div>
    </aside>

    <section class="auth-form">
        <h1>Đặt lại mật khẩu</h1>
        <p class="sub">Mã xác nhận chính xác. Nhập mật khẩu mới cho tài khoản của bạn.</p>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <form asp-controller="Account" asp-action="ResetPassword" method="post">
            <input type="hidden" asp-for="Token" />

            <div class="mb-3">
                <label asp-for="MatKhauMoi" class="form-label"></label>
                <input asp-for="MatKhauMoi" class="form-control" data-strength autocomplete="new-password" autofocus />
                <span asp-validation-for="MatKhauMoi" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="XacNhanMatKhau" class="form-label"></label>
                <input asp-for="XacNhanMatKhau" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="XacNhanMatKhau" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">Đặt lại mật khẩu</button>
        </form>
    </section>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
