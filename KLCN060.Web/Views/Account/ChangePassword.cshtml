@model KLCN060.Web.Models.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="page-head">
            <span class="eyebrow">Tài khoản của tôi</span>
            <h1>Đổi mật khẩu</h1>
            <p>Để bảo mật, sau khi đổi mật khẩu bạn sẽ được đăng xuất khỏi mọi thiết bị và cần đăng nhập lại.</p>
        </div>

        <div class="card">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <form asp-controller="Account" asp-action="ChangePassword" method="post">
                    <div class="mb-3">
                        <label asp-for="MatKhauCu" class="form-label"></label>
                        <input asp-for="MatKhauCu" class="form-control" autocomplete="current-password" autofocus />
                        <span asp-validation-for="MatKhauCu" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MatKhauMoi" class="form-label"></label>
                        <input asp-for="MatKhauMoi" class="form-control" data-strength autocomplete="new-password" />
                        <span asp-validation-for="MatKhauMoi" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="XacNhanMatKhau" class="form-label"></label>
                        <input asp-for="XacNhanMatKhau" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="XacNhanMatKhau" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
                        <a asp-action="Profile" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>

                <hr class="my-4" />
                <p class="small text-muted mb-0">Quên mật khẩu hiện tại? Hãy đăng xuất rồi chọn &ldquo;Quên mật khẩu&rdquo; ở trang đăng nhập.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
