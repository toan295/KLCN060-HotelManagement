@model KLCN060.Web.Models.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="auth-shell">
    <aside class="auth-aside">
        <partial name="_Pines" />
        <div>
            <span class="eyebrow" style="color:#f0c987;">Khôi phục tài khoản</span>
            <h2>Đừng lo, chúng tôi giúp bạn lấy lại mật khẩu</h2>
            <ul>
                <li><partial name="_Icon" model='"mail"' /> Mã xác nhận gửi tới email đã đăng ký</li>
                <li><partial name="_Icon" model='"clock"' /> Mã có hiệu lực trong 10 phút</li>
                <li><partial name="_Icon" model='"shield"' /> Nhập đúng mã mới đổi được mật khẩu</li>
            </ul>
        </div>
    </aside>

    <section class="auth-form">
        <h1>Quên mật khẩu</h1>
        <p class="sub">Nhập email bạn đã dùng để đăng ký tài khoản. Chúng tôi sẽ gửi mã xác nhận gồm 6 chữ số tới hộp thư đó.</p>

        @if (TempData["ErrorMessage"] is string loiPhien)
        {
            <div class="alert alert-warning">@loiPhien</div>
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            <div class="mb-4">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" type="email" class="form-control" placeholder="ten@example.com" autofocus autocomplete="email" inputmode="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
                <div class="form-text">Chỉ dùng email để xác minh, không cần số điện thoại.</div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">Tiếp tục</button>
        </form>

        <p class="text-center mt-4 mb-0">
            Nhớ ra mật khẩu rồi? <a asp-action="Login" class="fw-semibold">Đăng nhập</a>
        </p>
    </section>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
