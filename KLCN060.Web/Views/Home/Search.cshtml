@using KLCN060.Web.Helpers
@model KLCN060.Web.Models.Home.SearchViewModel
@{
    ViewData["Title"] = "Kết quả tìm kiếm";
}

<div class="page-head">
    <span class="eyebrow">Tìm phòng</span>
    <h1>Kết quả tìm kiếm</h1>
    <p>Chọn loại phòng phù hợp, xem chi tiết rồi đặt phòng chỉ với vài bước.</p>
</div>

@if (Model.NgayNhan is not null && Model.NgayTra is not null)
{
    <div class="search-summary">
        <span class="chip"><partial name="_Icon" model='"calendar"' /> Nhận phòng: <strong>@Model.NgayNhan?.ToString("dd/MM/yyyy")</strong></span>
        <span class="chip"><partial name="_Icon" model='"calendar"' /> Trả phòng: <strong>@Model.NgayTra?.ToString("dd/MM/yyyy")</strong></span>
        <span class="chip"><partial name="_Icon" model='"users"' /> Số khách: <strong>@Model.SoKhach</strong></span>
    </div>
    @if (!Model.DaLocTheoNgay)
    {
        <p class="text-muted small">* Ngày trả phải sau ngày nhận — đang hiển thị toàn bộ danh mục loại phòng.</p>
    }
}

<div class="row g-4">
    <div class="col-lg-3">
        <div class="card filter-card">
            <div class="card-body">
                <h5 class="card-title mb-3">Bộ lọc</h5>

                <div class="mb-3">
                    <label class="form-label">Loại phòng</label>
                    <select id="filterLoaiPhong" class="form-select">
                        <option value="">Tất cả</option>
                        @foreach (var ten in Model.DanhSachLoaiPhong.Select(x => x.TenLoai).Distinct())
                        {
                            <option value="@ten">@ten</option>
                        }
                    </select>
                </div>

                <div class="mb-1">
                    <label class="form-label">Mức giá/đêm</label>
                    <select id="filterMucGia" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="0-500000">Dưới 500.000đ</option>
                        <option value="500000-1000000">500.000đ - 1.000.000đ</option>
                        <option value="1000000-999999999">Trên 1.000.000đ</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-9">
        <div id="ketQuaContainer">
            @if (!Model.DanhSachLoaiPhong.Any())
            {
                <p class="text-muted">Hiện chưa tải được danh sách loại phòng. Vui lòng thử lại sau.</p>
            }
            else
            {
                var stt = 0;
                @foreach (var loaiPhong in Model.DanhSachLoaiPhong)
                {
                    var hetPhong = Model.DaLocTheoNgay && loaiPhong.SoPhongTrong <= 0;
                    <div class="card mb-3 result-card ket-qua-item reveal" style="--d:@(stt++ * 70)ms" data-loai="@loaiPhong.TenLoai" data-gia="@loaiPhong.DonGia">
                        <div class="row g-0">
                            <div class="col-md-4">
                                <partial name="_Photo" model='new PhotoViewModel(loaiPhong.MaLoai, "", loaiPhong.TenLoai)' />
                            </div>
                            <div class="col-md-8">
                                <div class="card-body p-4 d-flex flex-column h-100">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <h5 class="card-title mb-1 fs-4">@loaiPhong.TenLoai</h5>
                                        @if (Model.DaLocTheoNgay)
                                        {
                                            @if (hetPhong)
                                            {
                                                <span class="badge bg-danger align-self-start">Hết phòng</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success align-self-start">Còn @loaiPhong.SoPhongTrong phòng</span>
                                            }
                                        }
                                    </div>
                                    <div class="meta-row mb-3">
                                        <span><partial name="_Icon" model='"users"' /> Sức chứa tiêu chuẩn: @loaiPhong.SoNguoiTieuChuan khách</span>
                                        <span><partial name="_Icon" model='"wifi"' /> Wifi miễn phí</span>
                                        <span><partial name="_Icon" model='"wind"' /> Điều hòa</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-end mt-auto flex-wrap gap-2">
                                        <div class="price">@loaiPhong.DonGia.ToVnd() <small>/ đêm</small></div>
                                        @if (hetPhong)
                                        {
                                            <button type="button" class="btn btn-secondary btn-sm" disabled>Hết phòng trong khoảng ngày này</button>
                                        }
                                        else
                                        {
                                            <a asp-controller="Home" asp-action="Detail" asp-route-maLoai="@loaiPhong.MaLoai" class="btn btn-primary">Xem &amp; đặt phòng <partial name="_Icon" model='"arrow"' /></a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
        <p id="khongCoKetQua" class="text-muted d-none">Không tìm thấy loại phòng phù hợp với bộ lọc.</p>
    </div>
</div>

@section Scripts {
    <script>
        // Lọc PHÍA CLIENT trên danh sách đã tải, chưa cần gọi lại API mỗi lần đổi lọc (Mục 5).
        (function () {
            var filterLoaiPhong = document.getElementById('filterLoaiPhong');
            var filterMucGia = document.getElementById('filterMucGia');
            var items = document.querySelectorAll('.ket-qua-item');
            var khongCoKetQua = document.getElementById('khongCoKetQua');

            function apDungLoc() {
                var loai = filterLoaiPhong.value;
                var giaRange = filterMucGia.value.split('-');
                var giaMin = giaRange.length === 2 ? parseFloat(giaRange[0]) : null;
                var giaMax = giaRange.length === 2 ? parseFloat(giaRange[1]) : null;
                var soHienThi = 0;

                items.forEach(function (item) {
                    var khopLoai = !loai || item.dataset.loai === loai;
                    var gia = parseFloat(item.dataset.gia);
                    var khopGia = giaMin === null || (gia >= giaMin && gia <= giaMax);
                    var hienThi = khopLoai && khopGia;
                    item.classList.toggle('d-none', !hienThi);
                    if (hienThi) soHienThi++;
                });

                khongCoKetQua.classList.toggle('d-none', soHienThi !== 0);
            }

            filterLoaiPhong.addEventListener('change', apDungLoc);
            filterMucGia.addEventListener('change', apDungLoc);
        })();
    </script>
}
