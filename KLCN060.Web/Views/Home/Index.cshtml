@using KLCN060.Web.Helpers
@model List<KLCN060.Web.Models.Home.RoomTypeViewModel>
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="p-5 mb-4 bg-light rounded-3">
    <div class="container-fluid py-3">
        <h1 class="display-6">KLCN060 Hotel</h1>
        <p class="lead">Đặt phòng nhanh chóng, tiện nghi và giá tốt nhất.</p>

        <form asp-controller="Home" asp-action="Search" method="get" class="row g-2 align-items-end bg-white p-3 rounded-3 shadow-sm">
            <div class="col-md-3">
                <label class="form-label">Ngày nhận phòng</label>
                <input type="date" name="ngayNhan" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Ngày trả phòng</label>
                <input type="date" name="ngayTra" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Số khách</label>
                <input type="number" name="soKhach" value="1" min="1" class="form-control" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Tìm phòng</button>
            </div>
        </form>
    </div>
</div>

<h2 class="mb-3">Các loại phòng</h2>

@if (!Model.Any())
{
    <p class="text-muted">Hiện chưa tải được danh sách loại phòng. Vui lòng thử lại sau.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
        @foreach (var loaiPhong in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@loaiPhong.TenLoai</h5>
                        <p class="card-text text-muted mb-1">Sức chứa tiêu chuẩn: @loaiPhong.SoNguoiTieuChuan khách</p>
                        <p class="card-text fw-bold fs-5 mb-1">@loaiPhong.DonGia.ToVnd() / đêm</p>
                        @if (loaiPhong.PhuThu > 0)
                        {
                            <p class="card-text text-muted small">Phụ thu: @loaiPhong.PhuThu.ToVnd()</p>
                        }
                    </div>
                    <div class="card-footer bg-white border-top-0">
                        <a asp-controller="Home" asp-action="Detail" asp-route-maLoai="@loaiPhong.MaLoai" class="btn btn-outline-primary w-100">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
