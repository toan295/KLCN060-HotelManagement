@model KLCN060.Web.Models.Booking.BookGroupViewModel
@{
    ViewData["Title"] = "Đặt phòng theo đoàn";
    var homNay = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <partial name="_BookingSteps" model="1" />
        <h1 class="h3 mb-4">Đặt phòng theo đoàn</h1>

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <form asp-controller="Booking" asp-action="BookGroup" method="post" id="formDatDoan">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="NgayNhan" class="form-label"></label>
                    <input asp-for="NgayNhan" type="text" autocomplete="off" class="form-control date-picker-vi-linked" data-min="@homNay" />
                    <span asp-validation-for="NgayNhan" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="NgayTra" class="form-label"></label>
                    <input asp-for="NgayTra" type="text" autocomplete="off" class="form-control date-picker-vi-linked" data-min="@homNay" />
                    <span asp-validation-for="NgayTra" class="text-danger"></span>
                </div>
            </div>

            <h5 class="mt-3">Các loại phòng cần đặt</h5>
            <div id="danhSachDong">
                @for (var i = 0; i < Model.PhongCanDat.Count; i++)
                {
                    <div class="row g-2 align-items-center mb-2 dong-phong">
                        <div class="col-7">
                            <select name="PhongCanDat[@i].MaLoai" class="form-select">
                                <option value="">-- Chọn loại phòng --</option>
                                @foreach (var loaiPhong in Model.DanhSachLoaiPhong)
                                {
                                    <option value="@loaiPhong.MaLoai" selected="@(loaiPhong.MaLoai == Model.PhongCanDat[i].MaLoai)">@loaiPhong.TenLoai (@loaiPhong.DonGia.ToVnd()/đêm)</option>
                                }
                            </select>
                        </div>
                        <div class="col-3">
                            <input type="number" name="PhongCanDat[@i].SoLuong" value="@Model.PhongCanDat[i].SoLuong" min="1" max="50" class="form-control" placeholder="Số lượng" />
                        </div>
                        <div class="col-2">
                            <button type="button" class="btn btn-outline-danger btn-nut-xoa-dong">Xóa</button>
                        </div>
                    </div>
                }
            </div>

            <button type="button" id="btnThemDong" class="btn btn-outline-secondary btn-sm mt-2">+ Thêm loại phòng</button>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary w-100">Xác nhận đặt phòng</button>
            </div>
        </form>
    </div>
</div>

<template id="mauDongPhong">
    <div class="row g-2 align-items-center mb-2 dong-phong">
        <div class="col-7">
            <select name="PhongCanDat[__INDEX__].MaLoai" class="form-select">
                <option value="">-- Chọn loại phòng --</option>
                @foreach (var loaiPhong in Model.DanhSachLoaiPhong)
                {
                    <option value="@loaiPhong.MaLoai">@loaiPhong.TenLoai (@loaiPhong.DonGia.ToVnd()/đêm)</option>
                }
            </select>
        </div>
        <div class="col-3">
            <input type="number" name="PhongCanDat[__INDEX__].SoLuong" value="1" min="1" max="50" class="form-control" placeholder="Số lượng" />
        </div>
        <div class="col-2">
            <button type="button" class="btn btn-outline-danger btn-nut-xoa-dong">Xóa</button>
        </div>
    </div>
</template>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Ô ngày dùng flatpickr để LUÔN hiển thị dd/mm/yyyy bất kể ngôn ngữ trình duyệt (input[type=date] gốc
        // của HTML5 theo locale trình duyệt, không nghe theo lang="vi" của trang).
        (function () {
            var ngayNhanEl = document.getElementById('NgayNhan');
            var ngayTraEl = document.getElementById('NgayTra');
            var fpNhan = flatpickr(ngayNhanEl, { locale: 'vn', disableMobile: true, dateFormat: 'Y-m-d', altInput: true, altFormat: 'd/m/Y', altInputClass: 'form-control', minDate: ngayNhanEl.dataset.min, allowInput: true });
            var fpTra = flatpickr(ngayTraEl, { locale: 'vn', disableMobile: true, dateFormat: 'Y-m-d', altInput: true, altFormat: 'd/m/Y', altInputClass: 'form-control', minDate: ngayTraEl.dataset.min, allowInput: true });
            fpNhan.config.onChange.push(function (selectedDates) {
                if (selectedDates[0]) {
                    var minTra = new Date(selectedDates[0]);
                    minTra.setDate(minTra.getDate() + 1);
                    fpTra.set('minDate', minTra);
                }
            });
        })();

        // Thêm/bớt dòng động bằng jQuery, không cần reload trang (Mục 5B).
        $(function () {
            var mauHtml = document.getElementById('mauDongPhong').innerHTML;

            function danhLaiChiSo() {
                $('#danhSachDong .dong-phong').each(function (idx) {
                    $(this).find('select').attr('name', 'PhongCanDat[' + idx + '].MaLoai');
                    $(this).find('input[type=number]').attr('name', 'PhongCanDat[' + idx + '].SoLuong');
                });
            }

            $('#btnThemDong').on('click', function () {
                var soDong = $('#danhSachDong .dong-phong').length;
                var htmlMoi = mauHtml.replaceAll('__INDEX__', soDong);
                $('#danhSachDong').append(htmlMoi);
            });

            $('#danhSachDong').on('click', '.btn-nut-xoa-dong', function () {
                if ($('#danhSachDong .dong-phong').length > 1) {
                    $(this).closest('.dong-phong').remove();
                    danhLaiChiSo();
                }
            });
        });
    </script>
}
