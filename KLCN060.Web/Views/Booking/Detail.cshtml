@model KLCN060.Web.Models.Booking.BookingViewModel
@{
    ViewData["Title"] = "Chi tiết đặt phòng";
    var trangThaiHienThi = Model.TrangThai switch
    {
        "CHO_XAC_NHAN" => ("Chờ xác nhận đặt cọc", "warning"),
        "DA_XAC_NHAN" => ("Đã xác nhận, chờ ngày nhận phòng", "primary"),
        "DA_NHAN_PHONG" => ("Đã nhận phòng", "success"),
        "DA_HUY" => ("Đã hủy", "secondary"),
        "KHONG_DEN" => ("Không đến", "secondary"),
        _ => (Model.TrangThai, "secondary")
    };

    // Chỉ được hủy qua kênh tự phục vụ khi đơn đang CHO_XAC_NHAN hoặc DA_XAC_NHAN (Mục 5B).
    var choPhepHuy = Model.TrangThai is "CHO_XAC_NHAN" or "DA_XAC_NHAN";
    var soNgayConLai = (Model.NgayDonDuKien.ToDateTime(TimeOnly.MinValue) - DateTime.Today).Days;
    var duocHoanCoc = soNgayConLai >= 30;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <h1 class="h3 mb-1">Chi tiết đặt phòng</h1>
        <p class="text-muted mb-4">Mã phiếu đặt: <strong>@Model.MaPhieuDat</strong></p>

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="d-flex align-items-center gap-2 mb-3">
            <span>Trạng thái:</span>
            <span class="badge bg-@trangThaiHienThi.Item2">@trangThaiHienThi.Item1</span>
        </div>

        <p class="text-muted mb-3">
            Ngày nhận: <strong>@Model.NgayDonDuKien.ToString("dd/MM/yyyy")</strong> —
            Ngày trả: <strong>@Model.NgayTraDuKien.ToString("dd/MM/yyyy")</strong>
        </p>

        <h5>Danh sách phòng đã giữ</h5>
        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Phòng</th>
                    <th>Loại phòng</th>
                    <th>Đơn giá áp dụng</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var phong in Model.PhongDaGiu)
                {
                    <tr>
                        <td>@phong.MaPhong</td>
                        <td>@phong.MaLoai</td>
                        <td>@phong.DonGiaApDung.ToVnd()</td>
                        <td>@phong.ThanhTien.ToVnd()</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="card bg-light border-0 mb-4">
            <div class="card-body">
                <p class="mb-1">Tổng tiền dự kiến: <strong>@Model.TongTienDuKien.ToVnd()</strong></p>
                @if (Model.TongKhuyenMai > 0)
                {
                    <p class="mb-1 text-success">Khuyến mãi: -@Model.TongKhuyenMai.ToVnd()</p>
                }
                <p class="mb-0 fs-5">Tiền cọc: <strong>@Model.TienCoc.ToVnd()</strong></p>
            </div>
        </div>

        @if (choPhepHuy)
        {
            <div class="card border-warning mb-3">
                <div class="card-body">
                    <h5 class="card-title">Hủy đặt phòng</h5>
                    @if (duocHoanCoc)
                    {
                        <p class="text-success mb-3">Bạn sẽ được hoàn cọc.</p>
                    }
                    else
                    {
                        <p class="text-danger mb-3">
                            Theo chính sách, đơn hủy trong vòng 30 ngày trước ngày nhận phòng sẽ KHÔNG được hoàn cọc.
                        </p>
                    }

                    <form asp-controller="Booking" asp-action="Cancel" method="post"
                          onsubmit="return confirm('Bạn có chắc chắn muốn hủy đặt phòng này không?');">
                        <input type="hidden" name="maPhieuDat" value="@Model.MaPhieuDat" />
                        <button type="submit" class="btn btn-outline-danger">Hủy đặt phòng</button>
                    </form>
                </div>
            </div>
        }

        <a asp-controller="Booking" asp-action="MyBookings" class="d-inline-block mt-2">&larr; Quay lại lịch sử đặt phòng</a>
    </div>
</div>
