@model KLCN060.Web.Models.Booking.BookViewModel
@{
    ViewData["Title"] = "Đặt phòng cá nhân";
    var homNay = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <partial name="_BookingSteps" model="1" />
        <h1 class="h3 mb-1">Đặt phòng cá nhân</h1>
        <p class="text-muted mb-4">@Model.TenLoai — @Model.DonGia?.ToVnd() / đêm</p>

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="card"><div class="card-body p-4">
            <form asp-controller="Booking" asp-action="Book" method="post">
            <input type="hidden" asp-for="MaLoai" />

            <div class="mb-3">
                <label asp-for="NgayNhan" class="form-label"></label>
                <input asp-for="NgayNhan" type="text" autocomplete="off" class="form-control date-picker-vi-linked" data-min="@homNay" />
                <span asp-validation-for="NgayNhan" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NgayTra" class="form-label"></label>
                <input asp-for="NgayTra" type="text" autocomplete="off" class="form-control date-picker-vi-linked" data-min="@homNay" />
                <span asp-validation-for="NgayTra" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SoKhach" class="form-label"></label>
                <input asp-for="SoKhach" type="number" min="1" max="20" class="form-control" />
                <span asp-validation-for="SoKhach" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Xác nhận đặt phòng</button>
        </form>
        </div></div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Ngày trả phải sau ngày nhận (validate phía client) - Mục 5B. Ô ngày dùng flatpickr để LUÔN hiển thị
        // dd/mm/yyyy bất kể ngôn ngữ trình duyệt (input[type=date] gốc của HTML5 theo locale trình duyệt,
        // không nghe theo lang="vi" của trang - không sửa được bằng CSS/HTML thuần).
        document.addEventListener('DOMContentLoaded', function () {
            var ngayNhanEl = document.getElementById('NgayNhan');
            var ngayTraEl = document.getElementById('NgayTra');
            var fpNhan = flatpickr(ngayNhanEl, { locale: 'vn', disableMobile: true, dateFormat: 'Y-m-d', altInput: true, altFormat: 'd/m/Y', altInputClass: 'form-control', minDate: ngayNhanEl.dataset.min, allowInput: true });
            var fpTra = flatpickr(ngayTraEl, { locale: 'vn', disableMobile: true, dateFormat: 'Y-m-d', altInput: true, altFormat: 'd/m/Y', altInputClass: 'form-control', minDate: ngayTraEl.dataset.min, allowInput: true });
            fpNhan.config.onChange.push(function (selectedDates) {
                if (selectedDates[0]) {
                    var minTra = new Date(selectedDates[0]);
                    minTra.setDate(minTra.getDate() + 1);
                    fpTra.set('minDate', minTra);
                }
            });
        });
    </script>
}
