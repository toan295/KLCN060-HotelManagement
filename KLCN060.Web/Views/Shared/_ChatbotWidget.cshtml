@* Widget chatbot nổi, hiển thị trên MỌI trang qua _Layout.cshtml (Giai đoạn 7, Mục 5B). *@
<div id="chatbotWidget">
    <button id="chatbotToggleBtn" type="button" aria-label="Mở trợ lý ảo AI"><partial name="_Icon" model='"chat"' /></button>

    <div id="chatbotPanel" class="d-none">
        <div id="chatbotHeader">
            <span>Trợ lý ảo AI</span>
            <button id="chatbotCloseBtn" type="button" aria-label="Đóng trợ lý ảo">&times;</button>
        </div>
        <div id="chatbotMessages"></div>
        <form id="chatbotForm">
            <input type="text" id="chatbotInput" placeholder="Nhập câu hỏi..." autocomplete="off" maxlength="500" />
            <button type="submit">Gửi</button>
        </form>
    </div>
</div>

<style>
    #chatbotWidget { position: fixed; bottom: 22px; right: 22px; z-index: 1050; font-family: var(--font-body); }
    #chatbotToggleBtn {
        width: 58px; height: 58px; border-radius: 50%; border: none; display: grid; place-items: center;
        background: linear-gradient(150deg, var(--accent), var(--accent-strong)); color: #fff;
        box-shadow: 0 14px 28px -10px rgba(147, 100, 31, .9), 0 0 0 4px rgba(255, 255, 255, .7);
        cursor: pointer; transition: transform .25s var(--ease), box-shadow .25s;
    }
    #chatbotToggleBtn:hover { transform: translateY(-3px) scale(1.04); }
    #chatbotToggleBtn .ico { width: 26px; height: 26px; }
    #chatbotPanel {
        position: absolute; bottom: 74px; right: 0; width: 380px; max-width: 92vw; height: 520px; max-height: 80vh;
        background: #fff; border-radius: 20px; border: 1px solid var(--border);
        box-shadow: 0 30px 60px -20px rgba(18, 51, 40, .45);
        display: flex; flex-direction: column; overflow: hidden;
        animation: chatbot-in .28s var(--ease);
    }
    #chatbotPanel.d-none { display: none !important; }
    @@keyframes chatbot-in { from { opacity: 0; transform: translateY(12px) scale(.97); } }
    #chatbotHeader {
        background: linear-gradient(150deg, var(--brand-2), var(--brand-strong)); color: #fff; padding: .85rem 1.1rem;
        display: flex; align-items: center; justify-content: space-between; font-weight: 600;
    }
    #chatbotHeader button { background: rgba(255,255,255,.14); border: none; color: #fff; width: 28px; height: 28px; border-radius: 50%; font-size: 1.1rem; cursor: pointer; line-height: 1; }
    #chatbotHeader button:hover { background: rgba(255,255,255,.28); }
    #chatbotMessages { flex: 1; overflow-y: auto; padding: 1rem; background: var(--bg); }
    /* pre-wrap giữ nguyên xuống dòng / dòng trống / gạch đầu dòng trong câu trả lời nên câu trả lời dài vẫn dễ đọc. */
    .chatbot-msg { margin-bottom: .6rem; max-width: 92%; padding: .6rem .85rem; border-radius: 14px; font-size: .9rem; line-height: 1.55; white-space: pre-wrap; overflow-wrap: anywhere; }
    .chatbot-msg-user { background: var(--brand); color: #fff; margin-left: auto; border-bottom-right-radius: 4px; }
    .chatbot-msg-bot { background: #fff; color: var(--ink); margin-right: auto; border: 1px solid var(--border); border-bottom-left-radius: 4px; }
    .chatbot-chips { display: flex; flex-wrap: wrap; gap: .4rem; margin: 0 0 .8rem; }
    .chatbot-chip {
        border: 1px solid var(--brand); background: #fff; color: var(--brand-strong); border-radius: 999px;
        padding: .3rem .75rem; font-size: .8rem; line-height: 1.3; cursor: pointer; transition: background .15s, color .15s;
    }
    .chatbot-chip:hover { background: var(--brand); color: #fff; }
    #chatbotForm { display: flex; border-top: 1px solid var(--border); background: #fff; }
    #chatbotInput { flex: 1; border: none; padding: .8rem 1rem; outline: none; background: transparent; }
    #chatbotForm button { border: none; background: transparent; color: var(--accent-strong); font-weight: 700; padding: 0 1.1rem; cursor: pointer; }
    #chatbotForm button:hover { color: var(--brand-strong); }
</style>

<script>
    (function () {
        // Base URL API đọc từ <meta> do _Layout.cshtml render từ IConfiguration["Api:BaseUrl"] (KHÔNG hard-code) - Mục 5B.
        var apiBaseUrl = document.querySelector('meta[name="api-base-url"]').content;

        var toggleBtn = document.getElementById('chatbotToggleBtn');
        var closeBtn = document.getElementById('chatbotCloseBtn');
        var panel = document.getElementById('chatbotPanel');
        var form = document.getElementById('chatbotForm');
        var input = document.getElementById('chatbotInput');
        var messages = document.getElementById('chatbotMessages');

        // Lịch sử hội thoại giữ trong biến JS phía client, mất khi tải lại trang - Mục 5B.
        function themTinNhan(noiDung, laNguoiDung) {
            var div = document.createElement('div');
            div.className = 'chatbot-msg ' + (laNguoiDung ? 'chatbot-msg-user' : 'chatbot-msg-bot');
            div.textContent = noiDung;
            messages.appendChild(div);
            messages.scrollTop = messages.scrollHeight;
            return div;
        }

        // Câu hỏi gợi ý: chỉ giữ bộ gợi ý của câu trả lời mới nhất; bấm vào gợi ý là gửi câu hỏi đó.
        function xoaGoiY() {
            var cu = messages.querySelectorAll('.chatbot-chips');
            for (var i = 0; i < cu.length; i++) cu[i].parentNode.removeChild(cu[i]);
        }

        function themGoiY(danhSach) {
            xoaGoiY();
            if (!danhSach || !danhSach.length) return;
            var khung = document.createElement('div');
            khung.className = 'chatbot-chips';
            danhSach.forEach(function (cau) {
                var nut = document.createElement('button');
                nut.type = 'button';
                nut.className = 'chatbot-chip';
                nut.textContent = cau;
                nut.addEventListener('click', function () { guiCauHoi(cau); });
                khung.appendChild(nut);
            });
            messages.appendChild(khung);
            messages.scrollTop = messages.scrollHeight;
        }

        function taiGoiYMacDinh() {
            fetch(new URL('api/v1/chatbot/suggestions', apiBaseUrl).toString())
                .then(function (res) { return res.json(); })
                .then(function (json) { if (json && json.success) themGoiY(json.data); })
                .catch(function () { /* không có gợi ý thì khách vẫn tự gõ câu hỏi được */ });
        }

        function guiCauHoi(cauHoi) {
            cauHoi = (cauHoi || '').trim();
            if (!cauHoi || input.disabled) return;

            xoaGoiY();
            themTinNhan(cauHoi, true);
            input.value = '';
            input.disabled = true;
            // Mô hình ngôn ngữ có thể mất vài giây: hiện dòng chờ để khách biết hệ thống đang trả lời.
            var dangCho = themTinNhan('Đang soạn câu trả lời…', false);

            var url = new URL('api/v1/chatbot/ask', apiBaseUrl).toString();

            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cauHoi: cauHoi })
            })
                .then(function (res) { return res.json(); })
                .then(function (json) {
                    if (json && json.success && json.data && json.data.cauTraLoi) {
                        themTinNhan(json.data.cauTraLoi, false);
                        themGoiY(json.data.goiY);
                    } else {
                        themTinNhan((json && json.error && json.error.message) || 'Xin lỗi, trợ lý hiện chưa trả lời được câu hỏi này.', false);
                        taiGoiYMacDinh();
                    }
                })
                .catch(function () {
                    themTinNhan('Không thể kết nối tới hệ thống hỗ trợ, vui lòng thử lại sau.', false);
                })
                .finally(function () {
                    if (dangCho.parentNode) dangCho.parentNode.removeChild(dangCho);
                    input.disabled = false;
                    input.focus();
                });
        }

        toggleBtn.addEventListener('click', function () {
            var dangAn = panel.classList.contains('d-none');
            panel.classList.toggle('d-none');
            if (dangAn && messages.children.length === 0) {
                themTinNhan('Xin chào! Mình là trợ lý ảo AI của KLCN060 Hotel. Quý khách muốn hỏi về điều gì? Có thể chọn một gợi ý bên dưới hoặc tự nhập câu hỏi.', false);
                taiGoiYMacDinh();
            }
            if (dangAn) input.focus();
        });

        closeBtn.addEventListener('click', function () {
            panel.classList.add('d-none');
        });

        form.addEventListener('submit', function (ev) {
            ev.preventDefault();
            guiCauHoi(input.value);
        });
    })();
</script>
