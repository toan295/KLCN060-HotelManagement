<Application x:Class="KLCN060.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="MauChinh" Color="#1F4E79" />
        <SolidColorBrush x:Key="MauNen" Color="#F4F7FB" />
        <SolidColorBrush x:Key="MauChuPhu" Color="#64748B" />

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="{StaticResource MauChinh}" />
            <Setter Property="BorderBrush" Value="{StaticResource MauChinh}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Margin" Value="0,5,10,0" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,5,10,0" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EAF1F8" />
            <Setter Property="Foreground" Value="#1E3A5F" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </Application.Resources>
</Application>
