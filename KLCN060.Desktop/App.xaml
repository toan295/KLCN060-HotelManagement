<Application x:Class="KLCN060.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:KLCN060.Desktop.Converters">
    <Application.Resources>
        <conv:VndMoneyConverter x:Key="VndMoneyConverter" />
        <!-- Bảng màu khớp Hệ thống thiết kế (bản UI Prototype): brand = xanh rêu đậm, accent = vàng đồng. -->
        <SolidColorBrush x:Key="MauChinh" Color="#1F4D3D" />
        <SolidColorBrush x:Key="MauChinhDam" Color="#123328" />
        <SolidColorBrush x:Key="MauNhan" Color="#C08A3E" />
        <SolidColorBrush x:Key="MauNhanDam" Color="#93641F" />
        <SolidColorBrush x:Key="MauNen" Color="#F5F6F0" />
        <SolidColorBrush x:Key="MauNenPhu" Color="#EAEEE4" />
        <SolidColorBrush x:Key="MauVien" Color="#D7DDCE" />
        <SolidColorBrush x:Key="MauChu" Color="#16241D" />
        <SolidColorBrush x:Key="MauChuPhu" Color="#647A6C" />
        <SolidColorBrush x:Key="MauNguyHiem" Color="#C8452F" />

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="{StaticResource MauChinh}" />
            <Setter Property="BorderBrush" Value="{StaticResource MauChinh}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Margin" Value="0,5,10,0" />
            <Setter Property="BorderBrush" Value="{StaticResource MauVien}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,5,10,0" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource MauVien}" />
            <Setter Property="BorderBrush" Value="{StaticResource MauVien}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource MauNenPhu}" />
            <Setter Property="Foreground" Value="{StaticResource MauChinhDam}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </Application.Resources>
</Application>
