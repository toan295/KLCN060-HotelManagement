<UserControl x:Class="KLCN060.Desktop.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Tiêu đề trang dùng chung cho mọi màn hình: vạch nhấn vàng đồng + tiêu đề + mô tả ngắn; bên phải là khu vực nút thao tác (Actions). -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <Border Width="36" Height="4" CornerRadius="2" Background="{StaticResource MauNhan}" HorizontalAlignment="Left" Margin="0,0,0,10" />
            <TextBlock Text="{Binding DisplayTitle, ElementName=Root}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource MauChinhDam}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Subtitle, ElementName=Root}" Margin="0,5,0,0" FontSize="13" Foreground="{StaticResource MauChuNhat}" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <ContentPresenter Grid.Column="1" Content="{Binding Actions, ElementName=Root}" VerticalAlignment="Bottom" Margin="16,0,0,0" />
    </Grid>
</UserControl>
