<Window x:Class="KLCN060.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:KLCN060.Desktop.ViewModels" xmlns:views="clr-namespace:KLCN060.Desktop.Views" Title="KLCN060 Hotel Management" Height="720" Width="1120" MinWidth="960" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#F5F6F0">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DangNhapViewModel}"><views:D1DangNhapView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuanLyKhachHangViewModel}"><views:D9QuanLyKhachHangView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:D2DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DatPhongViewModel}"><views:D3DatPhongView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NhanPhongViewModel}"><views:D4NhanPhongView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuanLyDanhMucPhongViewModel}"><views:D11QuanLyDanhMucPhongView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuanLyKhuyenMaiViewModel}"><views:D12QuanLyKhuyenMaiView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuanLyDichVuViewModel}"><views:D13QuanLyDichVuView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuanLyCoSoVatChatViewModel}"><views:D14QuanLyCoSoVatChatView /></DataTemplate>

        <!-- Nút điều hướng trên sidebar: nền trong suốt, bo tròn khi hover - khác nút hành động chính (App.xaml). -->
        <Style x:Key="NavItemStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#3C4C40" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="12.8" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DDE4D7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavItemD11" TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding LaQuanLy}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding ManHinhDangChon}" Value="d11">
                    <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#123328" /><Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavItemD12" TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding LaQuanLy}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding ManHinhDangChon}" Value="d12">
                    <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#123328" /><Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavItemD13" TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding LaQuanLy}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding ManHinhDangChon}" Value="d13">
                    <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#123328" /><Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavItemD14" TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding LaQuanLy}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding ManHinhDangChon}" Value="d14">
                    <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#123328" /><Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavItemD9" TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CoTheQuanLyKhachHang}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding ManHinhDangChon}" Value="d9">
                    <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#123328" /><Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- D1: màn hình độc lập, không app-chrome/sidebar - đúng bản thiết kế
             ("D1: standalone, no app chrome/sidebar - login screen precedes the main app shell"). -->
        <ContentControl Content="{Binding CurrentViewModel}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DaDangNhap}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <!-- Shell chính: app-chrome (thanh trên) + sidebar (trái) + nội dung - chỉ hiện sau khi đăng nhập. -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DaDangNhap}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#123328" Padding="18,11">
                <Grid>
                    <TextBlock Text="KLCN060 Hotel Manager" Foreground="White" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center" />
                    <Border HorizontalAlignment="Right" Background="#1F4D3D" CornerRadius="12" Padding="11,5">
                        <TextBlock Text="{Binding VaiTroHienThi}" Foreground="White" FontSize="11.5" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="216" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#EAEEE4" BorderBrush="#D7DDCE" BorderThickness="0,0,1,0">
                    <DockPanel LastChildFill="False" Margin="10,16,10,14">
                        <TextBlock DockPanel.Dock="Top" Text="CHỨC NĂNG" FontSize="10" FontWeight="Bold" Foreground="#647A6C" Margin="10,0,0,8" />
                        <StackPanel DockPanel.Dock="Top">
                            <Button Content="▦ Sơ đồ phòng" Style="{StaticResource NavItemStyle}" Command="{Binding HienThiDashboardCommand}" />
                            <Button Content="＋ Đặt phòng" Style="{StaticResource NavItemStyle}" Command="{Binding HienThiDatPhongCommand}" />
                            <Button Content="✓ Nhận phòng" Style="{StaticResource NavItemStyle}" Command="{Binding HienThiNhanPhongCommand}" />
                            <Button Content="👤 Khách hàng" Style="{StaticResource NavItemD9}" Command="{Binding HienThiKhachHangCommand}" />
                            <Button Content="🛏️ Danh mục phòng" Style="{StaticResource NavItemD11}" Command="{Binding HienThiPhongCommand}" />
                            <Button Content="🏷️ Khuyến mãi" Style="{StaticResource NavItemD12}" Command="{Binding HienThiKhuyenMaiCommand}" />
                            <Button Content="🧾 Danh mục dịch vụ" Style="{StaticResource NavItemD13}" Command="{Binding HienThiDichVuCommand}" />
                            <Button Content="🧰 Cơ sở vật chất" Style="{StaticResource NavItemD14}" Command="{Binding HienThiCoSoVatChatCommand}" />
                        </StackPanel>
                        <Button DockPanel.Dock="Bottom" Content="← Đăng xuất" Style="{StaticResource NavItemStyle}" Command="{Binding DangXuatCommand}" Foreground="#C8452F" />
                    </DockPanel>
                </Border>

                <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
