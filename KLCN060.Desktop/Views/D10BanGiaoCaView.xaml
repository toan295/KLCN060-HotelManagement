<UserControl x:Class="KLCN060.Desktop.Views.D10BanGiaoCaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28" Background="#F5F6F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Bàn giao ca" FontSize="26" FontWeight="Bold" Foreground="#123328" />

        <Border Grid.Row="1" Margin="0,18,0,14" Padding="20" Background="White" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Tài khoản nhận ca" />
                    <ComboBox Height="34"
                              Margin="0,6,0,0"
                              ItemsSource="{Binding NhanVienLeTan}"
                              DisplayMemberPath="HoTen"
                              SelectedItem="{Binding NguoiNhanCa}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Tổng tiền mặt cuối ca" />
                    <TextBox Height="34" Margin="0,6,0,0" Text="{Binding TongTienMatCuoiCa}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Ghi chú sự cố trong ca" />
                    <TextBox Height="56" Margin="0,6,0,0" AcceptsReturn="True" Text="{Binding GhiChu}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <WrapPanel>
                <TextBlock VerticalAlignment="Center" Text="Sổ bàn giao từ ngày" />
                <DatePicker Width="135" Margin="8,0,16,0" SelectedDate="{Binding TuNgay}" />
                <TextBlock VerticalAlignment="Center" Text="đến ngày" />
                <DatePicker Width="135" Margin="8,0,16,0" SelectedDate="{Binding DenNgay}" />
                <Button Content="Xem lịch sử" Command="{Binding TaiLichSuCommand}" />
            </WrapPanel>
            <Border Grid.Row="1" Margin="0,12,0,0" Padding="18" Background="White" CornerRadius="10">
                <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding LichSuBanGiao}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="145" Header="Thời gian" Binding="{Binding ThoiGianBanGiao, StringFormat=dd/MM/yyyy HH:mm}" />
                        <DataGridTextColumn Width="110" Header="Người giao" Binding="{Binding MaTaiKhoanGiao}" />
                        <DataGridTextColumn Width="110" Header="Người nhận" Binding="{Binding MaTaiKhoanNhan}" />
                        <DataGridTextColumn Width="130" Header="Tiền đầu ca" Binding="{Binding TongTienMatDauCa, Converter={StaticResource VndMoneyConverter}}" />
                        <DataGridTextColumn Width="130" Header="Tiền cuối ca" Binding="{Binding TongTienMatCuoiCa, Converter={StaticResource VndMoneyConverter}}" />
                        <DataGridTextColumn Width="90" Header="Số phiếu" Binding="{Binding SoLuongPhieuTrongCa}" />
                        <DataGridTextColumn Width="*" Header="Ghi chú" Binding="{Binding GhiChu}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,16,0,0" HorizontalAlignment="Center">
            <TextBlock Foreground="#C8452F" Text="{Binding ThongBao}" TextAlignment="Center" TextWrapping="Wrap" />
            <Button MinWidth="170" Margin="0,10,0,0" Content="Xác nhận bàn giao ca" Command="{Binding TaoBanGiaoCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
