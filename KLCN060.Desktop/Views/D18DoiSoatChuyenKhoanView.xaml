<UserControl x:Class="KLCN060.Desktop.Views.D18DoiSoatChuyenKhoanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:KLCN060.Desktop.Controls">
    <UserControl.Resources>
        <Style x:Key="TheStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource MauVien}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource MauChu}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource MauNhan}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DongStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource MauChuPhu}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <DataTemplate x:Key="LichSuMau">
            <StackPanel Margin="0,0,0,5">
                <TextBlock Text="{Binding HienThi}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhu}" />
                <TextBlock Text="{Binding ChiTiet}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MauChuNhat}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="28,20,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="480" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ctl:PageHeader Title="Đối soát chuyển khoản" ManagerTitle="Quản lý đối soát chuyển khoản" Subtitle="Từ thông báo ngân hàng đến yêu cầu thanh toán, booking/hóa đơn: khớp thì tự ghi nhận, lệch thì dừng lại cho bạn xử lý tại đây." />

        <!-- Bức tranh tiền -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <Border Background="{StaticResource MauLoiNhat}" CornerRadius="6" Padding="10,6" Margin="0,0,0,8" Visibility="{Binding DuLieuCu, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Không tải được dữ liệu mới - số liệu bên dưới có thể đã cũ. Bấm &quot;Làm mới&quot; để thử lại." FontWeight="SemiBold" Foreground="{StaticResource MauNguyHiem}" />
            </Border>
            <WrapPanel Visibility="{Binding CoTongQuan, Converter={StaticResource BoolToVis}}">
                <Border Background="White" BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="10" Padding="11,6" Margin="0,0,8,8" MinWidth="170">
                    <StackPanel>
                        <TextBlock Text="NGÂN HÀNG BÁO ĐÃ NHẬN" FontSize="11" Foreground="{StaticResource MauChuNhat}" />
                        <TextBlock Text="{Binding TongQuan.TongTienNganHangNhan, StringFormat={}{0:N0}đ}" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="{Binding TongQuan.TongThongBao, StringFormat={}{0} thông báo trong kỳ}" FontSize="11" Foreground="{StaticResource MauChuNhat}" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource TheStyle}" Command="{Binding LocNhanhCommand}" CommandParameter="KHOP" ToolTip="Bấm để xem các khoản đã khớp">
                    <StackPanel>
                        <TextBlock Text="ĐÃ KHỚP" FontSize="11" Foreground="{StaticResource MauChuNhat}" />
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource MauThanhCong}"><Run Text="{Binding TongQuan.SoKhop, Mode=OneWay}" /><Run Text=" khoản" FontSize="12" /></TextBlock>
                        <TextBlock Text="{Binding TongQuan.TongTienDaKhop, StringFormat={}{0:N0}đ đã ghi nhận}" FontSize="11" Foreground="{StaticResource MauChuNhat}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TheStyle}" Command="{Binding LocNhanhCommand}" CommandParameter="CAN_XU_LY" ToolTip="Bấm để xem các khoản đang chờ xử lý">
                    <StackPanel>
                        <TextBlock Text="CẦN XỬ LÝ" FontSize="11" Foreground="{StaticResource MauChuNhat}" />
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource MauCanhBao}"><Run Text="{Binding TongQuan.SoChuaXuLy, Mode=OneWay}" /><Run Text=" khoản" FontSize="12" /></TextBlock>
                        <TextBlock Text="{Binding TongQuan.TongTienCanXuLy, StringFormat={}{0:N0}đ chưa ghi nhận}" FontSize="11" Foreground="{StaticResource MauChuNhat}" />
                    </StackPanel>
                </Button>
                <Border Background="White" BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="10" Padding="11,6" Margin="0,0,8,8" MinWidth="150">
                    <StackPanel>
                        <TextBlock Text="CHƯA KHỚP (NGOẠI LỆ)" FontSize="11" Foreground="{StaticResource MauChuNhat}" />
                        <TextBlock FontSize="18" FontWeight="Bold"><Run Text="{Binding TongQuan.SoChuaKhop, Mode=OneWay}" /><Run Text=" khoản" FontSize="12" /></TextBlock>
                        <TextBlock FontSize="11" Foreground="{StaticResource MauChuNhat}"><Run Text="đã xử lý " /><Run Text="{Binding TongQuan.SoDaXuLy, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TongQuan.SoChuaXuLyQuaHan, Mode=OneWay}" Foreground="{StaticResource MauNguyHiem}" FontWeight="SemiBold" /><Run Text=" chờ quá " Foreground="{StaticResource MauNguyHiem}" /><Run Text="{Binding TongQuan.NgayQuaHan, Mode=OneWay}" Foreground="{StaticResource MauNguyHiem}" /><Run Text=" ngày" Foreground="{StaticResource MauNguyHiem}" /></TextBlock>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="10" Padding="11,6" Margin="0,0,8,8" MinWidth="150">
                    <StackPanel>
                        <TextBlock Text="TỔNG CHÊNH LỆCH" FontSize="11" Foreground="{StaticResource MauChuNhat}" />
                        <TextBlock Text="{Binding TongQuan.TongChenhLech, StringFormat={}{0:N0}đ}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource MauNguyHiem}" />
                        <TextBlock Text="tổng |chênh lệch| các khoản lệch" FontSize="11" Foreground="{StaticResource MauChuNhat}" />
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="10" Padding="11,6" Margin="0,0,8,8" MinWidth="150">
                    <StackPanel>
                        <TextBlock Text="YÊU CẦU CHUYỂN KHOẢN" FontSize="11" Foreground="{StaticResource MauChuNhat}" />
                        <TextBlock FontSize="18" FontWeight="Bold"><Run Text="{Binding TongQuan.SoYeuCauChoThanhToan, Mode=OneWay}" /><Run Text=" chờ · " FontSize="12" /><Run Text="{Binding TongQuan.SoYeuCauHetHan, Mode=OneWay}" /><Run Text=" hết hạn" FontSize="12" /></TextBlock>
                        <TextBlock Text="{Binding TongQuan.TienYeuCauChoThanhToan, StringFormat=đang chờ khách chuyển {0:N0}đ}" FontSize="11" Foreground="{StaticResource MauChuNhat}" />
                    </StackPanel>
                </Border>
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding NhomNgoaiLe}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,6,6" Padding="9,3" FontSize="12" Style="{StaticResource OutlineButtonStyle}" Content="{Binding HienThi}"
                                Command="{Binding DataContext.LocNhanhCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Loai}" ToolTip="Bấm để lọc theo loại ngoại lệ này" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource MauChuPhu}" Visibility="{Binding CoTongQuan, Converter={StaticResource BoolToVis}}">
                <Run Text="{Binding TongQuan.KyHienThi, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding TongQuan.CongThucHienThi, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TongQuan.CapNhatHienThi, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <!-- Bộ lọc -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,10,0,10" Padding="16,8">
            <StackPanel>
            <WrapPanel>
                <HeaderedContentControl Header="Tìm kiếm" Width="250" Margin="0,0,10,8">
                    <TextBox Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding TaiCommand}" /></TextBox.InputBindings>
                    </TextBox>
                </HeaderedContentControl>
                <HeaderedContentControl Header="Loại khoản" Width="190" Margin="0,0,10,8">
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding LocLoai}">
                        <ComboBoxItem Tag="" Content="Tất cả" IsSelected="True" />
                        <ComboBoxItem Tag="KHOP" Content="Đã khớp" />
                        <ComboBoxItem Tag="THIEU_TIEN" Content="Thiếu tiền" />
                        <ComboBoxItem Tag="THUA_TIEN" Content="Thừa tiền" />
                        <ComboBoxItem Tag="SAI_NOI_DUNG" Content="Sai nội dung" />
                        <ComboBoxItem Tag="CHUA_XAC_DINH" Content="Chưa xác định" />
                        <ComboBoxItem Tag="HET_HAN" Content="Chuyển sau hết hạn" />
                        <ComboBoxItem Tag="DA_HUY" Content="Yêu cầu đã hủy" />
                        <ComboBoxItem Tag="THANH_TOAN_NHIEU_LAN" Content="Thanh toán nhiều lần" />
                        <ComboBoxItem Tag="SAI_TAI_KHOAN" Content="Sai tài khoản nhận" />
                        <ComboBoxItem Tag="KHONG_AP_DUNG" Content="Không áp dụng được" />
                    </ComboBox>
                </HeaderedContentControl>
                <HeaderedContentControl Header="Tình trạng xử lý" Width="170" Margin="0,0,10,8">
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding LocXuLy}">
                        <ComboBoxItem Tag="" Content="Tất cả" IsSelected="True" />
                        <ComboBoxItem Tag="CAN_XU_LY" Content="Chờ xử lý" />
                        <ComboBoxItem Tag="DA_XU_LY" Content="Đã xử lý" />
                        <ComboBoxItem Tag="KHONG_CAN" Content="Tự khớp" />
                    </ComboBox>
                </HeaderedContentControl>
                <HeaderedContentControl Header="Từ ngày" Width="150" Margin="0,0,10,8"><DatePicker SelectedDate="{Binding TuNgay}" /></HeaderedContentControl>
                <HeaderedContentControl Header="Đến ngày" Width="150" Margin="0,0,10,8"><DatePicker SelectedDate="{Binding DenNgay}" /></HeaderedContentControl>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <Button Content="Làm mới" Command="{Binding TaiCommand}" IsDefault="True" Margin="0" MinWidth="86" />
                    <Button Content="Xóa lọc" Command="{Binding XoaBoLocCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="8,0,0,0" />
                    <Button Content="Xuất Excel" Command="{Binding XuatCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="8,0,0,0" ToolTip="Xuất các dòng đang lọc ra tệp Excel (.xlsx) gồm trang Tổng hợp (chỉ số, phân loại ngoại lệ) và trang Chi tiết xử lý (có nút lọc)" />
                </StackPanel>
            </WrapPanel>
            <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                       Text="Ô Tìm kiếm: gõ mã giao dịch ngân hàng, nội dung chuyển khoản, mã booking, mã hóa đơn, tên khách hoặc số tiền, rồi nhấn Enter. Danh sách lọc theo ngày hệ thống nhận thông báo." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="460" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="12">
                <TabControl SelectedIndex="{Binding TabDangChon}" BorderThickness="0" Background="Transparent">
                    <TabItem Header="Thông báo từ ngân hàng">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="{Binding TieuDeDanhSach}" FontWeight="SemiBold" Foreground="{StaticResource MauChinh}" Margin="0,8,0,6" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding DanhSach}" SelectedItem="{Binding DongDaChon}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" RowHeight="NaN" CanUserSortColumns="False">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QuaHanXuLy}" Value="True"><Setter Property="Background" Value="{StaticResource MauLoiNhat}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Khoản tiền" Width="*" MinWidth="170">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,3">
                                                    <TextBlock Text="{Binding DongDauHienThi}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding DongHaiHienThi}" FontSize="11.5" Foreground="{StaticResource MauChuPhu}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DoiTuongHienThi}" FontSize="11" Foreground="{StaticResource MauChuNhat}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Kết quả" Width="170">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,3">
                                                    <TextBlock Text="{Binding TenLoai}" FontWeight="SemiBold" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource MauCanhBao}" />
                                                                <Style.Triggers><DataTrigger Binding="{Binding Loai}" Value="KHOP"><Setter Property="Foreground" Value="{StaticResource MauThanhCong}" /></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding ChenhLechHienThi, StringFormat=chênh lệch {0}}" FontSize="11" Foreground="{StaticResource MauChuPhu}" />
                                                    <TextBlock Text="{Binding XuLyHienThi}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MauChuNhat}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" Style="{StaticResource HintTextStyle}"
                                       Visibility="{Binding TrongDanhSach, Converter={StaticResource BoolToVis}}" Text="Không có thông báo ngân hàng nào khớp bộ lọc và khoảng ngày này. Bấm &quot;Xóa lọc&quot; để xem lại tất cả." />
                        </Grid>
                    </TabItem>
                    <TabItem Header="Yêu cầu chuyển khoản">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <HeaderedContentControl Header="Lọc theo trạng thái yêu cầu" Margin="0,8,0,8" Width="240" HorizontalAlignment="Left">
                                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding LocGiaoDich}">
                                    <ComboBoxItem Tag="" Content="Tất cả" IsSelected="True" />
                                    <ComboBoxItem Tag="CHO_THANH_TOAN" Content="Chờ thanh toán" />
                                    <ComboBoxItem Tag="THANH_CONG" Content="Thành công" />
                                    <ComboBoxItem Tag="HET_HAN" Content="Hết hạn" />
                                    <ComboBoxItem Tag="DA_HUY" Content="Đã hủy" />
                                </ComboBox>
                            </HeaderedContentControl>
                            <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding GiaoDich}" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã yêu cầu" Width="140" Binding="{Binding MaGiaoDich}" />
                                    <DataGridTextColumn Header="Khoản thanh toán" Width="*" MinWidth="130" Binding="{Binding KhoanThanhToan}" />
                                    <DataGridTextColumn Header="Số tiền" Width="100" Binding="{Binding SoTien, Converter={StaticResource VndMoneyConverter}}" />
                                    <DataGridTextColumn Header="Tạo lúc" Width="120" Binding="{Binding NgayTao, StringFormat=dd/MM HH:mm}" />
                                    <DataGridTextColumn Header="Trạng thái" Width="110" Binding="{Binding TrangThaiHienThi}" />
                                    <DataGridTextColumn Header="Mã GD ngân hàng" Width="120" Binding="{Binding MaGiaoDichNganHang}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Chi tiết + xử lý -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Chi tiết khoản tiền" Style="{StaticResource CardTitleStyle}" />
                        <Border Style="{StaticResource DividerStyle}" />
                        <TextBlock TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding CoChiTiet}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="Chọn một thông báo ở bảng bên trái để xem: tiền ngân hàng thực nhận, yêu cầu thanh toán, booking/hóa đơn, số phải thu, chênh lệch, lý do và cách xử lý." />
                        </TextBlock>

                        <StackPanel Visibility="{Binding CoChiTiet, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ChiTiet.TenLoai}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource MauChinhDam}" />
                            <TextBlock Text="{Binding ChiTiet.XuLyHienThi}" FontWeight="SemiBold" Foreground="{StaticResource MauChinh}" />
                            <Border Background="{StaticResource MauCanhBaoNhat}" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                                <TextBlock Text="{Binding ChiTiet.LyDo}" TextWrapping="Wrap" />
                            </Border>
                            <Border Background="{StaticResource MauThongTinNhat}" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers><DataTrigger Binding="{Binding ChiTiet.ThongTinXuLyHienThi}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ChiTiet.ThongTinXuLyHienThi}" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="Ngân hàng" Style="{StaticResource SubTitleStyle}" Margin="0,12,0,3" />
                            <TextBlock Style="{StaticResource DongStyle}"><Run Text="Mã GD ngân hàng: " /><Run Text="{Binding ChiTiet.MaGiaoDichNganHang, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                            <TextBlock Style="{StaticResource DongStyle}"><Run Text="Số tiền thực nhận: " /><Run Text="{Binding ChiTiet.SoTienNganHang, StringFormat={}{0:N0}đ, ConverterCulture=vi-VN, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                            <TextBlock Style="{StaticResource DongStyle}"><Run Text="Nội dung chuyển khoản: " /><Run Text="{Binding ChiTiet.NoiDung, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                            <TextBlock Style="{StaticResource DongStyle}"><Run Text="Giờ NH: " /><Run Text="{Binding ChiTiet.ThoiGianNganHang, StringFormat=dd/MM/yyyy HH:mm, Mode=OneWay}" /><Run Text=" · hệ thống nhận: " /><Run Text="{Binding ChiTiet.ThoiGianNhan, StringFormat=dd/MM/yyyy HH:mm, Mode=OneWay}" /><Run Text=" · TK nhận " /><Run Text="{Binding ChiTiet.SoTaiKhoanNhan, Mode=OneWay}" /></TextBlock>

                            <TextBlock Text="Yêu cầu thanh toán - booking / hóa đơn" Style="{StaticResource SubTitleStyle}" Margin="0,12,0,3" />
                            <TextBlock Text="{Binding ChiTiet.DoiTuongHienThi}" Style="{StaticResource DongStyle}" FontWeight="SemiBold" Foreground="{StaticResource MauChu}" />
                            <TextBlock Style="{StaticResource DongStyle}" Visibility="{Binding CoYeuCau, Converter={StaticResource BoolToVis}}"><Run Text="Khách: " /><Run Text="{Binding ChiTiet.TenKhach, Mode=OneWay}" /><Run Text=" · Booking: " /><Run Text="{Binding ChiTiet.MaPhieuDat, Mode=OneWay}" /><Run Text=" · Hóa đơn: " /><Run Text="{Binding ChiTiet.MaHoaDon, Mode=OneWay}" /></TextBlock>
                            <TextBlock Style="{StaticResource DongStyle}" Visibility="{Binding CoYeuCau, Converter={StaticResource BoolToVis}}"><Run Text="Trạng thái yêu cầu: " /><Run Text="{Binding ChiTiet.TrangThaiGiaoDich, Mode=OneWay}" /><Run Text=" · tạo " /><Run Text="{Binding ChiTiet.NgayTaoYeuCau, StringFormat=dd/MM HH:mm, Mode=OneWay}" /><Run Text=" bởi " /><Run Text="{Binding ChiTiet.NguoiTaoYeuCau, Mode=OneWay}" /><Run Text=" · hạn " /><Run Text="{Binding ChiTiet.HanThanhToan, StringFormat=dd/MM HH:mm, Mode=OneWay}" /></TextBlock>

                            <TextBlock Text="Số tiền" Style="{StaticResource SubTitleStyle}" Margin="0,12,0,3" />
                            <TextBlock Style="{StaticResource DongStyle}" Visibility="{Binding CoYeuCau, Converter={StaticResource BoolToVis}}"><Run Text="Phải thu: " /><Run Text="{Binding ChiTiet.SoTienPhaiThu, StringFormat={}{0:N0}đ, ConverterCulture=vi-VN, Mode=OneWay}" /><Run Text=" · Hệ thống đã ghi nhận: " /><Run Text="{Binding ChiTiet.SoTienDaGhiNhan, StringFormat={}{0:N0}đ, ConverterCulture=vi-VN, Mode=OneWay}" /><Run Text=" · Chênh lệch: " /><Run Text="{Binding ChiTiet.ChenhLechHienThi, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                            <TextBlock Style="{StaticResource DongStyle}" Visibility="{Binding CoCungGiaoDich, Converter={StaticResource BoolToVis}}" Text="Khách còn chuyển các lần khác cho cùng yêu cầu:" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding CungGiaoDich}">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Style="{StaticResource DongStyle}" FontSize="12"><Run Text="• " /><Run Text="{Binding DongDauHienThi, Mode=OneWay}" /><Run Text=" - " /><Run Text="{Binding TenLoai, Mode=OneWay}" /></TextBlock></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Cách xử lý gợi ý" Style="{StaticResource SubTitleStyle}" Margin="0,12,0,3" Visibility="{Binding HienKhungXuLy, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding ChiTiet.GoiYXuLy}" Style="{StaticResource DongStyle}" Visibility="{Binding HienKhungXuLy, Converter={StaticResource BoolToVis}}" />

                            <!-- Xử lý ngoại lệ -->
                            <Border Style="{StaticResource InsetStyle}" Padding="12,10" Margin="0,12,0,0" Visibility="{Binding HienKhungXuLy, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Xử lý khoản này" FontWeight="Bold" Foreground="{StaticResource MauChinhDam}" />
                                    <HeaderedContentControl Header="Cách xử lý" Margin="0,8,0,0">
                                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding HuongXuLy}">
                                            <ComboBoxItem Tag="" Content="— Chọn —" IsSelected="True" />
                                            <ComboBoxItem Tag="DA_XU_LY_NGOAI" Content="Đã xử lý ngoài hệ thống" />
                                            <ComboBoxItem Tag="BO_QUA" Content="Bỏ qua (không phải tiền của khách sạn)" />
                                        </ComboBox>
                                    </HeaderedContentControl>
                                    <TextBlock Text="{Binding MoTaHuong}" Style="{StaticResource HintTextStyle}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <HeaderedContentControl Header="Ghi chú xử lý * (bắt buộc, lưu vào nhật ký)" Margin="0,8,0,0">
                                        <TextBox Text="{Binding GhiChuXuLy, UpdateSourceTrigger=PropertyChanged}" Height="58" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MaxLength="400" />
                                    </HeaderedContentControl>
                                    <Button Content="Xác nhận xử lý" Command="{Binding XuLyCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InsetStyle}" Padding="12,8" Margin="0,12,0,0" Visibility="{Binding KhongCoTheXuLyNhungCanXuLy, Converter={StaticResource BoolToVis}}">
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" FontSize="12" Text="Tài khoản của bạn chỉ được xem. Khoản này cần Quản lý hoặc Kế toán có quyền xử lý đối soát." />
                            </Border>

                            <StackPanel Visibility="{Binding CoLichSu, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Lịch sử xử lý" Style="{StaticResource SubTitleStyle}" Margin="0,12,0,3" />
                                <ItemsControl ItemsSource="{Binding LichSu}" ItemTemplate="{StaticResource LichSuMau}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <ctl:NoticeBar Grid.Row="4" Text="{Binding ThongBao}" IsError="{Binding ThongBaoLaLoi}" Margin="0,10,0,0" />
    </Grid>
    </ScrollViewer>
</UserControl>
