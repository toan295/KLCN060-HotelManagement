                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Không có vấn đề nào cần chú ý trong kỳ này." Style="{StaticResource HintTextStyle}" Margin="0,8,0,0" Visibility="{Binding KhongCoVanDe, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Tab: Truy vết số liệu ===== -->
            <ScrollViewer Tag="TRUY_VET" Style="{StaticResource NoiDungTabStyle}" VerticalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
