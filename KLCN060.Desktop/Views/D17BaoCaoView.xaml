                            <TextBlock Style="{StaticResource DongSoLieuStyle}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="Giảm giá đã áp: {0:N0}đ ({1} lần)">
                                        <Binding Path="VanHanh.KeToan.GiamGia" /><Binding Path="VanHanh.KeToan.SoLanGiamGia" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Buồng phòng (Housekeeping)" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,12" />
                            <TextBlock Text="{Binding VanHanh.BuongPhong.PhongDaDon, StringFormat=Phòng đã dọn trong kỳ: {0}}" Style="{StaticResource DongSoLieuStyle}" />
                            <TextBlock Text="{Binding VanHanh.BuongPhong.PhongDangCho, StringFormat=Phòng đang chờ dọn: {0}}" Style="{StaticResource DongSoLieuStyle}" />
                            <TextBlock Text="{Binding VanHanh.BuongPhong.PhongCoVanDe, StringFormat=Phòng có vấn đề (chưa dọn quá lâu / hỏng): {0}}" Style="{StaticResource DongSoLieuStyle}" />
                            <DataGrid AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding VanHanh.BuongPhong.DanhSachCanXuLy}" MaxHeight="220" BorderThickness="0" Margin="0,8,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Phòng" Width="70" Binding="{Binding MaPhong}" />
                                    <DataGridTextColumn Header="Tình trạng" Width="90" Binding="{Binding TinhTrangHienThi}" />
                                    <DataGridTextColumn Header="Đã" Width="90" Binding="{Binding ThoiGianHienThi}" />
                                    <DataGridTextColumn Header="Lý do" Width="*" Binding="{Binding LyDo}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Bảo trì (Maintenance)" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,12" />
