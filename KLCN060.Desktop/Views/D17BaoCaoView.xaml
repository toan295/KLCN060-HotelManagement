                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Vì sao 'Doanh thu (hóa đơn)' khác 'Doanh thu phòng (theo đêm ở)'?" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding DoiChieu.GiaiThich}" Foreground="{StaticResource MauChuPhu}" TextWrapping="Wrap" Margin="0,8,0,8" />
                            <TextBlock Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"><Run Text="Doanh thu hóa đơn: " FontWeight="SemiBold" /><Run Text="{Binding DoiChieu.DoanhThuHoaDon, StringFormat={}{0:N0}đ, Mode=OneWay}" /><Run Text="   (trong đó tiền phòng " /><Run Text="{Binding DoiChieu.DoanhThuHoaDonPhong, StringFormat={}{0:N0}đ, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                            <TextBlock Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"><Run Text="Doanh thu phòng theo đêm ở: " FontWeight="SemiBold" /><Run Text="{Binding DoiChieu.DoanhThuPhongTheoDem, StringFormat={}{0:N0}đ, Mode=OneWay}" /><Run Text="   (" /><Run Text="{Binding DoiChieu.SoDemPhongBan, Mode=OneWay}" /><Run Text=" đêm)" /></TextBlock>
                            <TextBlock Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"><Run Text="  - đêm của lượt đã có hóa đơn đã thu: " /><Run Text="{Binding DoiChieu.SoDemDaCoHoaDon, Mode=OneWay}" /><Run Text=" đêm · " /><Run Text="{Binding DoiChieu.TienDemDaCoHoaDon, StringFormat={}{0:N0}đ, Mode=OneWay}" /></TextBlock>
                            <TextBlock Foreground="{StaticResource MauChuPhu}"><Run Text="  - đêm của lượt chưa có hóa đơn đã thu (đang ở / chưa thanh toán): " /><Run Text="{Binding DoiChieu.SoDemChuaCoHoaDon, Mode=OneWay}" /><Run Text=" đêm · " /><Run Text="{Binding DoiChieu.TienDemChuaCoHoaDon, StringFormat={}{0:N0}đ, Mode=OneWay}" /></TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Kiểm tra nhất quán: tổng phải bằng chi tiết" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding TomTatKiemTra}" FontWeight="SemiBold" Margin="0,6,0,8" TextWrapping="Wrap" />
                            <DataGrid ItemsSource="{Binding KiemTra}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="NaN">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Phép kiểm tra" Width="300" Binding="{Binding Ten}" />
                                    <DataGridTextColumn Header="Số liệu" Width="*" Binding="{Binding DongSo}" />
                                    <DataGridTextColumn Header="Kết quả" Width="100" Binding="{Binding KetQua}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Cách tính các chỉ số" Style="{StaticResource CardTitleStyle}" />
                            <ItemsControl ItemsSource="{Binding DinhNghia}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Ten}" FontWeight="Bold" />
                                            <TextBlock Foreground="{StaticResource MauChuPhu}" TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="Công thức: " FontWeight="SemiBold" /><Run Text="{Binding CongThuc, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Foreground="{StaticResource MauChuNhat}" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,0"><Run Text="Nguồn: " /><Run Text="{Binding NguonDuLieu, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Text="{Binding GhiChu}" Foreground="{StaticResource MauChuNhat}" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
