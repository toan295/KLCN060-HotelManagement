<UserControl x:Class="KLCN060.Desktop.Views.D17BaoCaoView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28" Background="#F5F6F0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Báo cáo" FontSize="26" FontWeight="Bold" Foreground="#123328"/>
        <WrapPanel Grid.Row="1" Margin="0,18,0,12"><TextBlock VerticalAlignment="Center" Text="Từ ngày"/><DatePicker Width="140" Margin="8,0,16,0" SelectedDate="{Binding TuNgay}"/><TextBlock VerticalAlignment="Center" Text="Đến ngày"/><DatePicker Width="140" Margin="8,0,16,0" SelectedDate="{Binding DenNgay}"/><Button Content="Xem báo cáo" Command="{Binding TaiBaoCaoCommand}"/></WrapPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Padding="18" Background="White" CornerRadius="10"><StackPanel><TextBlock Text="{Binding DoanhThu.TongCong, StringFormat=Tổng doanh thu: {0:N0}đ}" FontSize="18" FontWeight="Bold"/><TextBlock Margin="0,9,0,0" Text="{Binding Khach.TongKhach, StringFormat=Tổng khách: {0}}"/><TextBlock Margin="0,6,0,0" Text="{Binding Khach.KhachMoi, StringFormat=Khách mới: {0}}"/><TextBlock Margin="0,6,0,0" Text="{Binding Khach.KhachQuayLai, StringFormat=Khách quay lại: {0}}"/></StackPanel></Border>
            <Border Grid.Column="2" Padding="18" Background="White" CornerRadius="10"><StackPanel><TextBlock Text="{Binding CongSuat.TyLeTrungBinhPhanTram, StringFormat=Công suất trung bình: {0:N2}%}" FontSize="18" FontWeight="Bold"/><TextBlock Margin="0,9,0,0" Text="{Binding CongSuat.TongSoPhong, StringFormat=Tổng số phòng: {0}}"/></StackPanel></Border>
            <Border Grid.Row="1" Margin="0,20,0,0" Padding="18" Background="White" CornerRadius="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Doanh thu theo ngày" FontSize="17" FontWeight="SemiBold"/><DataGrid Grid.Row="1" Margin="0,12,0,0" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding DoanhThuTheoNgay}"><DataGrid.Columns><DataGridTextColumn Header="Ngày" Width="*" Binding="{Binding Ngay, StringFormat=dd/MM/yyyy}"/><DataGridTextColumn Header="Doanh thu" Width="160" Binding="{Binding DoanhThu, Converter={StaticResource VndMoneyConverter}}"/></DataGrid.Columns></DataGrid></Grid></Border>
            <Border Grid.Row="1" Grid.Column="2" Margin="0,20,0,0" Padding="18" Background="White" CornerRadius="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Công suất theo ngày" FontSize="17" FontWeight="SemiBold"/><DataGrid Grid.Row="1" Margin="0,12,0,0" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding CongSuatTheoNgay}"><DataGrid.Columns><DataGridTextColumn Header="Ngày" Width="*" Binding="{Binding Ngay, StringFormat=dd/MM/yyyy}"/><DataGridTextColumn Header="Phòng có khách" Width="105" Binding="{Binding SoPhongCoKhach}"/><DataGridTextColumn Header="Tỷ lệ" Width="75" Binding="{Binding TyLePhanTram, StringFormat={}{0:N1}%}"/></DataGrid.Columns></DataGrid></Grid></Border>
        </Grid>
        <TextBlock Grid.Row="3" Margin="0,16,0,0" Foreground="#C8452F" Text="{Binding ThongBao}" TextAlignment="Center"/>
    </Grid>
</UserControl>
