<UserControl x:Class="KLCN060.Desktop.Views.D17BaoCaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:KLCN060.Desktop.Controls">
    <UserControl.Resources>
        <Style x:Key="KpiNhanStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MauChuNhat}" />
        </Style>
        <Style x:Key="KpiSoStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MauChinhDam}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="DongSoLieuStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Foreground" Value="{StaticResource MauChuPhu}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Nút chọn tab / khoảng ngày nhanh: nút viền; tab đang chọn (Tag == TabDangChon) đổi sang nền xanh đậm -->
        <Style x:Key="NutTabStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="16,5" />
            <Setter Property="Margin" Value="0,0,10,8" />
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EqualsMultiConverter}">
                            <Binding Path="DataContext.TabDangChon" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource MauChinh}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Nội dung của một tab: chỉ hiện khi Tag trùng TabDangChon -->
        <Style x:Key="NoiDungTabStyle" TargetType="ScrollViewer">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EqualsMultiConverter}">
                            <Binding Path="DataContext.TabDangChon" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Bảng "phân chia": tên - số lượng - doanh thu - tỷ trọng (theo loại phòng, nguồn đặt, dịch vụ, hình thức thanh toán, tháng) -->
        <Style x:Key="BangPhanChiaStyle" TargetType="ItemsControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="60" /><ColumnDefinition Width="130" /><ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="NỘI DUNG" Style="{StaticResource KpiNhanStyle}" />
                                <TextBlock Grid.Column="1" Text="SL" Style="{StaticResource KpiNhanStyle}" TextAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="DOANH THU" Style="{StaticResource KpiNhanStyle}" TextAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="TỶ TRỌNG" Style="{StaticResource KpiNhanStyle}" TextAlignment="Right" />
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" Margin="0,0,0,6" />
                            <ItemsPresenter />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="60" /><ColumnDefinition Width="130" /><ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Ten}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding SoLuong}" TextAlignment="Right" Foreground="{StaticResource MauChuNhat}" />
                            <TextBlock Grid.Column="2" Text="{Binding DoanhThu, StringFormat={}{0:N0}đ}" TextAlignment="Right" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="{Binding TyTrongPhanTram, StringFormat={}{0:0.#}%}" TextAlignment="Right" Foreground="{StaticResource MauChuNhat}" />
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bảng đếm đặt phòng: tên - số phiếu - giá trị -->
        <Style x:Key="BangDemStyle" TargetType="ItemsControl">
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="60" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Ten}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding SoLuong}" TextAlignment="Right" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{Binding GiaTri, StringFormat={}{0:N0}đ}" TextAlignment="Right" Foreground="{StaticResource MauChuNhat}" />
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ctl:PageHeader Title="Báo cáo" Subtitle="Tổng quan công suất - ADR - RevPAR so với kỳ trước, doanh thu theo nhiều chiều, vận hành các bộ phận, đặt phòng và công nợ.">
            <ctl:PageHeader.Actions>
                <TextBlock Text="Đang tải..." VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding DangTai}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </ctl:PageHeader.Actions>
        </ctl:PageHeader>

        <!-- Bộ lọc khoảng ngày: chọn nhanh + tự chọn + xuất báo cáo -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,20,0,14" Padding="18,12">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,24,8">
                        <Button Content="Hôm nay" Command="{Binding ChonKhoangCommand}" CommandParameter="HOM_NAY" Style="{StaticResource OutlineButtonStyle}" MinHeight="34" Padding="14,5" />
                        <Button Content="7 ngày" Command="{Binding ChonKhoangCommand}" CommandParameter="7_NGAY" Style="{StaticResource OutlineButtonStyle}" MinHeight="34" Padding="14,5" />
                        <Button Content="Tháng này" Command="{Binding ChonKhoangCommand}" CommandParameter="THANG" Style="{StaticResource OutlineButtonStyle}" MinHeight="34" Padding="14,5" />
                        <Button Content="Năm nay" Command="{Binding ChonKhoangCommand}" CommandParameter="NAM" Style="{StaticResource OutlineButtonStyle}" MinHeight="34" Padding="14,5" Margin="0" />
                    </StackPanel>
                    <HeaderedContentControl Header="Từ ngày" Width="160" Margin="0,0,10,8"><DatePicker SelectedDate="{Binding TuNgay}" /></HeaderedContentControl>
                    <HeaderedContentControl Header="Đến ngày" Width="160" Margin="0,0,14,8"><DatePicker SelectedDate="{Binding DenNgay}" /></HeaderedContentControl>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <Button Content="Xem báo cáo" Command="{Binding TaiBaoCaoCommand}" Margin="0,0,24,0" MinWidth="120" />
                        <TextBlock Text="Xuất báo cáo:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource MauChuPhu}" FontWeight="SemiBold" />
                        <Button Content="Excel" Command="{Binding XuatCommand}" CommandParameter="xlsx" Style="{StaticResource OutlineButtonStyle}" MinWidth="110"
                                ToolTip="Xuất toàn bộ báo cáo của kỳ đang chọn ra Excel: mỗi mục một trang tính, có định dạng màu / số / ngày." />
                        <Button Content="PDF" Command="{Binding XuatCommand}" CommandParameter="pdf" Style="{StaticResource OutlineButtonStyle}" MinWidth="80" Margin="0"
                                ToolTip="Xuất toàn bộ báo cáo của kỳ đang chọn ra PDF: có bìa, thẻ chỉ số nổi bật và bảng số liệu, sẵn sàng để in." />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="Đang xuất báo cáo..." Style="{StaticResource HintTextStyle}" Visibility="{Binding DangXuat, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding KyDangXem}" Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding CapNhatLuc}" FontSize="11.5" Margin="0,2,0,0" Foreground="{StaticResource MauChuPhu}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers><DataTrigger Binding="{Binding SoLieuCu}" Value="True"><Setter Property="Foreground" Value="{StaticResource MauNguyHiem}" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="⚠ Không tải lại được - số liệu có thể đã cũ" FontSize="11.5" Foreground="{StaticResource MauNguyHiem}" Visibility="{Binding SoLieuCu, Converter={StaticResource BoolToVis}}" />
                <ctl:NoticeBar Text="{Binding ThongBao}" IsError="{Binding ThongBaoLaLoi}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Tab -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,6">
            <Button Content="Tổng quan" Tag="TONG_QUAN" Command="{Binding ChonTabCommand}" CommandParameter="TONG_QUAN" Style="{StaticResource NutTabStyle}" />
            <Button Content="Doanh thu" Tag="DOANH_THU" Command="{Binding ChonTabCommand}" CommandParameter="DOANH_THU" Style="{StaticResource NutTabStyle}" />
            <Button Content="Đặt phòng" Tag="DAT_PHONG" Command="{Binding ChonTabCommand}" CommandParameter="DAT_PHONG" Style="{StaticResource NutTabStyle}" />
            <Button Content="Công nợ" Tag="CONG_NO" Command="{Binding ChonTabCommand}" CommandParameter="CONG_NO" Style="{StaticResource NutTabStyle}" Margin="0,0,28,8" />
        </WrapPanel>

        <Grid Grid.Row="3">
            <!-- ===== Tab 1: Tổng quan ===== -->
            <ScrollViewer Tag="TONG_QUAN" Style="{StaticResource NoiDungTabStyle}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Kpis}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Tieu}" Style="{StaticResource KpiNhanStyle}" />
                                        <TextBlock Text="{Binding GiaTri}" Style="{StaticResource KpiSoStyle}" />
                                        <TextBlock Text="{Binding SoSanh}" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MauChuNhat}" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding CoSoSanh}" Value="True" /><Condition Binding="{Binding Tang}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="{StaticResource MauThanhCong}" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding CoSoSanh}" Value="True" /><Condition Binding="{Binding Tang}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="{StaticResource MauNguyHiem}" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding GhiChu}" Style="{StaticResource HintTextStyle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Biểu đồ cột: cột đậm = kỳ này, cột nhạt = kỳ trước cùng vị trí; rê chuột lên cột để xem số liệu -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Biểu đồ theo kỳ" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="{Binding TomTatBieuDo}" Foreground="{StaticResource MauNhanDam}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                                <HeaderedContentControl Grid.Column="1" Header="Chỉ số">
                                    <ComboBox ItemsSource="{Binding ChiSoTuyChon}" DisplayMemberPath="Ten" SelectedValuePath="Ma" SelectedValue="{Binding ChiSoBieuDo}" />
                                </HeaderedContentControl>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                                <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource MauChinh}" VerticalAlignment="Center" />
                                <TextBlock Text="Kỳ này" Margin="6,0,18,0" Foreground="{StaticResource MauChuPhu}" />
                                <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource MauNhan}" Opacity="0.55" VerticalAlignment="Center" />
                                <TextBlock Text="Kỳ trước (cùng độ dài)" Margin="6,0,0,0" Foreground="{StaticResource MauChuPhu}" />
                            </StackPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Cots}" Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="30" Margin="0,0,4,0" ToolTip="{Binding ChuThich}" Background="Transparent">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="134">
                                                    <Border Width="10" Height="{Binding ChieuCao}" VerticalAlignment="Bottom" Background="{StaticResource MauChinh}" CornerRadius="3,3,0,0" />
                                                    <Border Width="10" Height="{Binding ChieuCaoTruoc}" VerticalAlignment="Bottom" Margin="2,0,0,0" Background="{StaticResource MauNhan}" Opacity="0.55" CornerRadius="3,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Nhan}" FontSize="9.5" Foreground="{StaticResource MauChuNhat}" TextAlignment="Center" TextWrapping="NoWrap" Margin="-6,4,-6,0"
                                                           Visibility="{Binding HienNhan, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Tab 2: Doanh thu ===== -->
            <ScrollViewer Tag="DOANH_THU" Style="{StaticResource NoiDungTabStyle}">
                <StackPanel Margin="0,0,12,0">
                    <Border Style="{StaticResource CardStyle}" Background="{StaticResource MauChinh}" BorderBrush="{StaticResource MauChinhDam}" Padding="20,14" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="TỔNG DOANH THU KỲ NÀY" FontSize="10.5" FontWeight="Bold" Foreground="#9DB8AA" />
                                <TextBlock Text="{Binding DoanhThu.TongDoanhThu, StringFormat={}{0:N0}đ}" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock Text="Doanh thu hóa đơn đã thu (gồm cả tiền cọc của phiếu đã thanh toán). Các bảng bên dưới cùng cộng ra tổng này (trừ hình thức thanh toán: tiền thực thu, chưa gồm cọc)."
                                       Foreground="#C9D8CF" FontSize="12" TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center" Margin="32,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Theo loại doanh thu (phòng, dịch vụ, minibar, giặt là, khác, giảm giá)" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding DoanhThu.TheoLoaiDoanhThu}" Style="{StaticResource BangPhanChiaStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Theo loại phòng" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding DoanhThu.TheoLoaiPhong}" Style="{StaticResource BangPhanChiaStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Theo nguồn đặt phòng" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding DoanhThu.TheoNguonDat}" Style="{StaticResource BangPhanChiaStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Theo dịch vụ" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding DoanhThu.TheoDichVu}" Style="{StaticResource BangPhanChiaStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Theo hình thức thanh toán (tiền thực thu, chưa gồm cọc)" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding DoanhThu.TheoHinhThucThanhToan}" Style="{StaticResource BangPhanChiaStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Theo hình thức thanh toán (gồm cả tiền cọc đã nhận)" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding DoanhThu.TheoHinhThucGomCoc}" Style="{StaticResource BangPhanChiaStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Theo tuần" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding DoanhThu.TheoTuan}" Style="{StaticResource BangPhanChiaStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Theo tháng" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding DoanhThu.TheoThang}" Style="{StaticResource BangPhanChiaStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Theo quý" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding DoanhThu.TheoQuy}" Style="{StaticResource BangPhanChiaStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Theo năm" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding DoanhThu.TheoNam}" Style="{StaticResource BangPhanChiaStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Doanh thu phòng theo tầng" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding DoanhThu.TheoTang}" Style="{StaticResource BangPhanChiaStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Doanh thu phòng theo từng phòng" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding DoanhThu.TheoPhong}" Style="{StaticResource BangPhanChiaStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Theo ngày" Style="{StaticResource CardTitleStyle}" />
                                    <DataGrid Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding DoanhThu.TheoNgay}" MaxHeight="420" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Ngày" Width="*" Binding="{Binding Ngay, StringFormat=dd/MM/yyyy}" />
                                            <DataGridTextColumn Header="Doanh thu" Width="170" Binding="{Binding DoanhThu, Converter={StaticResource VndMoneyConverter}}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Tab 4: Đặt phòng ===== -->
            <ScrollViewer Tag="DAT_PHONG" Style="{StaticResource NoiDungTabStyle}">
                <StackPanel Margin="0,0,12,12">
                    <UniformGrid Columns="4">
                        <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,12,12">
                            <StackPanel><TextBlock Text="TỔNG SỐ PHIẾU" Style="{StaticResource KpiNhanStyle}" /><TextBlock Text="{Binding DatPhong.TongSoPhieu}" Style="{StaticResource KpiSoStyle}" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,12,12">
                            <StackPanel><TextBlock Text="TỶ LỆ HỦY" Style="{StaticResource KpiNhanStyle}" /><TextBlock Text="{Binding DatPhong.TyLeHuyPhanTram, StringFormat={}{0:0.#}%}" Style="{StaticResource KpiSoStyle}" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,12,12">
                            <StackPanel><TextBlock Text="TỶ LỆ KHÔNG ĐẾN" Style="{StaticResource KpiNhanStyle}" /><TextBlock Text="{Binding DatPhong.TyLeKhongDenPhanTram, StringFormat={}{0:0.#}%}" Style="{StaticResource KpiSoStyle}" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="ĐẶT PHÒNG ĐOÀN" Style="{StaticResource KpiNhanStyle}" />
                                <TextBlock Text="{Binding DatPhong.SoPhieuDoan}" Style="{StaticResource KpiSoStyle}" />
                                <TextBlock Text="{Binding DatPhong.SoPhongDoan, StringFormat={}{0} phòng}" Style="{StaticResource HintTextStyle}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock Text="Theo trạng thái" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding DatPhong.TheoTrangThai}" Style="{StaticResource BangDemStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock Text="Theo nguồn đặt" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding DatPhong.TheoNguon}" Style="{StaticResource BangDemStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock Text="Cá nhân / đoàn" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding DatPhong.TheoLoai}" Style="{StaticResource BangDemStyle}" />
                                <Border Style="{StaticResource DividerStyle}" />
                                <TextBlock Text="{Binding DatPhong.TongCocHoan, StringFormat=Cọc đã hoàn: {0:N0}đ}" Style="{StaticResource DongSoLieuStyle}" />
                                <TextBlock Text="{Binding DatPhong.TongCocGiuLai, StringFormat=Cọc giữ lại: {0:N0}đ}" Style="{StaticResource DongSoLieuStyle}" />
                                <TextBlock Text="{Binding DatPhong.ChoXuLyKhongDen, StringFormat=Phiếu quá ngày đón chưa xử lý: {0}}" Style="{StaticResource DongSoLieuStyle}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Hủy / không đến gần đây (trong kỳ)" Style="{StaticResource CardTitleStyle}" />
                            <DataGrid Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding DatPhong.HuyGanDay}" MaxHeight="360" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Phiếu" Width="150" Binding="{Binding MaPhieuDat}" />
                                    <DataGridTextColumn Header="Khách" Width="160" Binding="{Binding HoTenKhach}" />
                                    <DataGridTextColumn Header="Loại" Width="90" Binding="{Binding LoaiHienThi}" />
                                    <DataGridTextColumn Header="Ngày" Width="130" Binding="{Binding NgayHuy, StringFormat=dd/MM/yyyy HH:mm}" />
                                    <DataGridTemplateColumn Header="Người hủy (họ tên - mã NV)" Width="200">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding HuyBoi}" TextWrapping="Wrap" Margin="6,4" VerticalAlignment="Center" ToolTip="{Binding HuyBoi}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Lý do" Width="*" MinWidth="160">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding LyDoHuy}" TextWrapping="Wrap" Margin="6,4" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Cọc" Width="100" Binding="{Binding TienCoc, StringFormat={}{0:N0}đ}" />
                                    <DataGridTextColumn Header="Hoàn" Width="100" Binding="{Binding SoTienHoanCoc, StringFormat={}{0:N0}đ}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Tab 5: Công nợ ===== -->
            <ScrollViewer Tag="CONG_NO" Style="{StaticResource NoiDungTabStyle}">
                <StackPanel Margin="0,0,12,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}" Background="{StaticResource MauChinh}" BorderBrush="{StaticResource MauChinhDam}" Padding="20,14">
                            <StackPanel>
                                <TextBlock Text="TỔNG CÔNG NỢ HIỆN TẠI" FontSize="10.5" FontWeight="Bold" Foreground="#9DB8AA" />
                                <TextBlock Text="{Binding CongNo.TongConNo, StringFormat={}{0:N0}đ}" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding CongNo.SoHoaDon, StringFormat={}{0} hóa đơn chưa thanh toán đủ}" Foreground="#C9D8CF" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Theo tuổi nợ" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding CongNo.TheoNhomTuoiNo}" Style="{StaticResource BangPhanChiaStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Công nợ theo khách" Style="{StaticResource CardTitleStyle}" />
                                <DataGrid Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding CongNo.TheoKhach}" MaxHeight="260" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Khách" Width="*" Binding="{Binding HoTenKhach}" />
                                        <DataGridTextColumn Header="Số HĐ" Width="60" Binding="{Binding SoHoaDon}" />
                                        <DataGridTextColumn Header="Nợ lâu nhất" Width="90" Binding="{Binding SoNgayNoLonNhat, StringFormat={}{0} ngày}" />
                                        <DataGridTextColumn Header="Còn nợ" Width="110" Binding="{Binding ConNo, StringFormat={}{0:N0}đ}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Booking còn công nợ" Style="{StaticResource CardTitleStyle}" />
                                <DataGrid Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding CongNo.TheoDatPhong}" MaxHeight="260" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Phiếu đặt" Width="110" Binding="{Binding Ma}" />
                                        <DataGridTextColumn Header="Khách" Width="*" Binding="{Binding HoTenKhach}" />
                                        <DataGridTextColumn Header="Số HĐ" Width="60" Binding="{Binding SoHoaDon}" />
                                        <DataGridTextColumn Header="Còn nợ" Width="110" Binding="{Binding ConNo, StringFormat={}{0:N0}đ}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Chi tiết hóa đơn còn nợ" Style="{StaticResource CardTitleStyle}" />
                            <DataGrid Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding CongNo.ChiTiet}" MaxHeight="420" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Hóa đơn" Width="130" Binding="{Binding MaHD}" />
                                    <DataGridTextColumn Header="Phiếu đặt" Width="110" Binding="{Binding MaPhieuDat}" />
                                    <DataGridTextColumn Header="Khách" Width="*" Binding="{Binding HoTenKhach}" />
                                    <DataGridTextColumn Header="Ngày lập" Width="110" Binding="{Binding NgayLap, StringFormat=dd/MM/yyyy}" />
                                    <DataGridTextColumn Header="Số ngày nợ" Width="90" Binding="{Binding SoNgayNo}" />
                                    <DataGridTextColumn Header="Tuổi nợ" Width="90" Binding="{Binding NhomTuoiNo}" />
                                    <DataGridTextColumn Header="Quá hạn" Width="80" Binding="{Binding QuaHanText}" />
                                    <DataGridTextColumn Header="Tổng tiền" Width="110" Binding="{Binding TongTien, StringFormat={}{0:N0}đ}" />
                                    <DataGridTextColumn Header="Đã thu" Width="110" Binding="{Binding DaThanhToan, StringFormat={}{0:N0}đ}" />
                                    <DataGridTextColumn Header="Còn nợ" Width="110" Binding="{Binding ConNo, StringFormat={}{0:N0}đ}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>

    </Grid>
</UserControl>
