            <ScrollViewer Tag="VAN_DE" Style="{StaticResource NoiDungTabStyle}">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{Binding TomTatVanDe}" FontWeight="SemiBold" Foreground="{StaticResource MauChinh}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Mỗi vấn đề nêu: cái gì, mức độ, số liệu so với ngưỡng, nên làm gì và mở màn hình xử lý. Các chỉ số theo kỳ (công suất, hủy, không đến...) tính theo khoảng ngày đang chọn; các cảnh báo vận hành (bảo trì, công nợ, phòng chưa sẵn sàng...) là tình trạng hiện tại." />
                    <ItemsControl ItemsSource="{Binding VanDe}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border CornerRadius="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource MauThongTin}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MucDo}" Value="NGHIEM_TRONG"><Setter Property="Background" Value="{StaticResource MauNguyHiem}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding MucDo}" Value="CANH_BAO"><Setter Property="Background" Value="{StaticResource MauCanhBao}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock FontWeight="Bold" TextWrapping="Wrap"><Run Text="{Binding TieuDe, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding MucDoHienThi, Mode=OneWay}" FontSize="10.5" Foreground="{StaticResource MauChuNhat}" /></TextBlock>
                                            <TextBlock Text="{Binding SoLieu}" FontWeight="SemiBold" Foreground="{StaticResource MauChinh}" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding MoTa}" Foreground="{StaticResource MauChuPhu}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            <TextBlock Foreground="{StaticResource MauChuPhu}" TextWrapping="Wrap" Margin="0,3,0,0"><Run Text="Nên làm: " FontWeight="SemiBold" /><Run Text="{Binding HanhDong, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Text="{Binding ChiTietGop}" FontSize="11.5" Foreground="{StaticResource MauChuNhat}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding CoChiTiet, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Content="{Binding TenManHinh}" Margin="12,0,0,0" VerticalAlignment="Top" Visibility="{Binding CoManHinh, Converter={StaticResource BoolToVis}}"
