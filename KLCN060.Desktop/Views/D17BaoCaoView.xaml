                                <DataGridTextColumn Header="Chi tiết" Width="*" Binding="{Binding MoTa}">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Trạng thái" Width="130" Binding="{Binding TrangThai}" />
