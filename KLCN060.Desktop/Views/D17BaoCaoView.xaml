                            <TextBlock Text="{Binding VanHanh.BaoTri.DangXuLy, StringFormat=Đang xử lý: {0}}" Style="{StaticResource DongSoLieuStyle}" />
                            <TextBlock Text="{Binding VanHanh.BaoTri.DaXuLy, StringFormat=Đã xử lý xong: {0}}" Style="{StaticResource DongSoLieuStyle}" />
                            <TextBlock Text="{Binding VanHanh.BaoTri.ThoiGianXuLyTrungBinhGio, StringFormat=Thời gian xử lý trung bình: {0:0.#} giờ, TargetNullValue=Thời gian xử lý trung bình: chưa có}" Style="{StaticResource DongSoLieuStyle}" />
