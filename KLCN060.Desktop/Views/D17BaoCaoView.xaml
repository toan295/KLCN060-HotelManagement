                                    <DataGridTextColumn Header="Đã" Width="90" Binding="{Binding ThoiGianHienThi}" />
                                    <DataGridTextColumn Header="Lý do" Width="*" Binding="{Binding LyDo}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- ===== Tab 4: Đặt phòng ===== -->
            <ScrollViewer Tag="DAT_PHONG" Style="{StaticResource NoiDungTabStyle}">
