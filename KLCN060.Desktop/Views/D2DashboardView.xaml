<UserControl x:Class="KLCN060.Desktop.Views.D2DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:KLCN060.Desktop.Controls"
             xmlns:vm="clr-namespace:KLCN060.Desktop.ViewModels">
    <UserControl.Resources>
        <!-- Ô phòng: thẻ bo góc tô màu theo tình trạng (đúng bảng màu trạng thái phòng), ô đang chọn có viền vàng đồng. -->
        <Style x:Key="RoomTileStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="128" />
            <Setter Property="Height" Value="92" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="{StaticResource MauPhongOOO}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="ToolTip" Value="{Binding ChuThichHienThi}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.74" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding TinhTrang}" Value="VC"><Setter Property="Background" Value="{StaticResource MauPhongVC}" /><Setter Property="Foreground" Value="{StaticResource MauChinhDam}" /></DataTrigger>
                <DataTrigger Binding="{Binding TinhTrang}" Value="VD"><Setter Property="Background" Value="{StaticResource MauPhongVD}" /><Setter Property="Foreground" Value="{StaticResource MauChinhDam}" /></DataTrigger>
                <DataTrigger Binding="{Binding TinhTrang}" Value="VI"><Setter Property="Background" Value="{StaticResource MauPhongVI}" /><Setter Property="Foreground" Value="{StaticResource MauChinhDam}" /></DataTrigger>
                <DataTrigger Binding="{Binding TinhTrang}" Value="OC"><Setter Property="Background" Value="{StaticResource MauPhongOC}" /></DataTrigger>
                <DataTrigger Binding="{Binding TinhTrang}" Value="OD"><Setter Property="Background" Value="{StaticResource MauPhongOD}" /></DataTrigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EqualsMultiConverter}">
                            <Binding />
                            <Binding Path="DataContext.PhongDaChon" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="BorderBrush" Value="{StaticResource MauNhan}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChiSoSoDoStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource MauVien}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource MauChu}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.85" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MucDo}" Value="CANH_BAO"><Setter Property="Background" Value="{StaticResource MauCanhBaoNhat}" /></DataTrigger>
                <DataTrigger Binding="{Binding MucDo}" Value="NGUY_HIEM"><Setter Property="Background" Value="{StaticResource MauLoiNhat}" /></DataTrigger>
                <DataTrigger Binding="{Binding MucDo}" Value="TOT"><Setter Property="Background" Value="{StaticResource MauThanhCongNhat}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NhanLocSoDoStyle" TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="NhanChiTietStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MauChuNhat}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ctl:PageHeader Title="Sơ đồ trạng thái phòng" Subtitle="{Binding MoTaManHinh}">
            <ctl:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CapNhatLuc}" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Tải lại" Command="{Binding TaiDuLieuCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0" />
                </StackPanel>
            </ctl:PageHeader.Actions>
        </ctl:PageHeader>

        <!-- Ô chỉ số: nhìn là biết tình hình; bấm để lọc nhanh -->
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <Border Background="{StaticResource MauLoiNhat}" CornerRadius="6" Padding="10,6" Margin="0,0,0,8" Visibility="{Binding DuLieuCu, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Dữ liệu có thể đã cũ - chưa làm mới được từ máy chủ." Foreground="{StaticResource MauNguyHiem}" FontWeight="SemiBold" />
            </Border>
            <ItemsControl ItemsSource="{Binding ChiSo}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ChiSoSoDoStyle}" Command="{Binding DataContext.LocNhanhCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Loc}" ToolTip="{Binding Phu}">
                            <StackPanel>
                                <TextBlock Text="{Binding Nhan}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource MauChuNhat}" />
                                <TextBlock Text="{Binding GiaTri}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource MauChinhDam}" />
                                <TextBlock Text="{Binding Phu}" FontSize="10.5" Foreground="{StaticResource MauChuPhu}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Chú giải màu + bộ lọc (mỗi ô có nhãn nêu rõ công dụng) -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <WrapPanel VerticalAlignment="Center" Margin="2,0,0,8">
                <StackPanel Orientation="Horizontal" Margin="0,0,14,4"><Border Width="12" Height="12" CornerRadius="4" Background="{StaticResource MauPhongVC}" /><TextBlock Text="Trống, đã dọn" Margin="6,-1,0,0" FontSize="12" Foreground="{StaticResource MauChuPhu}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,4"><Border Width="12" Height="12" CornerRadius="4" Background="{StaticResource MauPhongVD}" /><TextBlock Text="Trống, chưa dọn" Margin="6,-1,0,0" FontSize="12" Foreground="{StaticResource MauChuPhu}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,4"><Border Width="12" Height="12" CornerRadius="4" Background="{StaticResource MauPhongVI}" /><TextBlock Text="Trống, đã kiểm tra" Margin="6,-1,0,0" FontSize="12" Foreground="{StaticResource MauChuPhu}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,4"><Border Width="12" Height="12" CornerRadius="4" Background="{StaticResource MauPhongOC}" /><TextBlock Text="Đang có khách" Margin="6,-1,0,0" FontSize="12" Foreground="{StaticResource MauChuPhu}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,4"><Border Width="12" Height="12" CornerRadius="4" Background="{StaticResource MauPhongOD}" /><TextBlock Text="Có khách, cần dọn" Margin="6,-1,0,0" FontSize="12" Foreground="{StaticResource MauChuPhu}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,4"><Border Width="12" Height="12" CornerRadius="4" Background="{StaticResource MauPhongOOO}" /><TextBlock Text="Ngừng phục vụ" Margin="6,-1,0,0" FontSize="12" Foreground="{StaticResource MauChuPhu}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><Border Width="14" Height="14" CornerRadius="7" Background="{StaticResource MauNguyHiem}"><TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" /></Border><TextBlock Text="Phòng cần xử lý (chọn phòng để xem lý do)" Margin="6,-1,0,0" FontSize="12" Foreground="{StaticResource MauChuPhu}" /></StackPanel>
            </WrapPanel>
            <Border Style="{StaticResource InsetStyle}" Padding="12,8,12,2">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,6">
                            <TextBlock Text="Tìm (số phòng, loại phòng, khách, mã đặt)" Style="{StaticResource NhanLocSoDoStyle}" />
                            <TextBox Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,6">
                            <TextBlock Text="Tình trạng phòng" Style="{StaticResource NhanLocSoDoStyle}" />
                            <ComboBox ItemsSource="{x:Static vm:DashboardViewModel.BoLocTuyChon}" DisplayMemberPath="Ten" SelectedValuePath="Ma" SelectedValue="{Binding LocTinhTrang}" Width="170" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,6">
                            <TextBlock Text="Tầng" Style="{StaticResource NhanLocSoDoStyle}" />
                            <ComboBox ItemsSource="{Binding Tangs}" DisplayMemberPath="Ten" SelectedValuePath="Ma" SelectedValue="{Binding LocTang}" Width="100" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,6">
                            <TextBlock Text="Loại phòng" Style="{StaticResource NhanLocSoDoStyle}" />
                            <ComboBox ItemsSource="{Binding LoaiPhongs}" DisplayMemberPath="Ten" SelectedValuePath="Ma" SelectedValue="{Binding LocLoaiPhong}" Width="145" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,6">
                            <TextBlock Text="Khả năng bán" Style="{StaticResource NhanLocSoDoStyle}" />
                            <ComboBox ItemsSource="{x:Static vm:DashboardViewModel.LocBanTuyChon}" DisplayMemberPath="Ten" SelectedValuePath="Ma" SelectedValue="{Binding LocBan}" Width="175" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,6">
                            <TextBlock Text="Khách" Style="{StaticResource NhanLocSoDoStyle}" />
                            <ComboBox ItemsSource="{x:Static vm:DashboardViewModel.LocKhachTuyChon}" DisplayMemberPath="Ten" SelectedValuePath="Ma" SelectedValue="{Binding LocKhach}" Width="135" />
                        </StackPanel>
                        <Button Content="Xóa bộ lọc" Command="{Binding XoaBoLocCommand}" Style="{StaticResource OutlineButtonStyle}" MinHeight="32" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                    </WrapPanel>
                    <TextBlock Text="{Binding SoHienThi}" Style="{StaticResource HintTextStyle}" Margin="0,0,0,6" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="{Binding TomTatHienThi}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PhongTheoTang}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TieuDe}" Margin="0,6,0,8" FontWeight="Bold" FontSize="13" Foreground="{StaticResource MauChinh}" />
                                        <ItemsControl ItemsSource="{Binding Phongs}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource RoomTileStyle}" Command="{Binding DataContext.ChonPhongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <Grid Width="116">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding TenPhong}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" />
                                                                <TextBlock Text="{Binding TinhTrang, Converter={StaticResource TrangThaiPhongConverter}}" FontSize="11" FontWeight="Normal"
                                                                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="4,2,4,0" />
                                                                <TextBlock Text="{Binding DongPhuHienThi}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="112"
                                                                           TextAlignment="Center" HorizontalAlignment="Center" Margin="0,3,0,0" Opacity="0.92" />
                                                            </StackPanel>
                                                            <Border Width="16" Height="16" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                                                                    Visibility="{Binding CoCanhBao, Converter={StaticResource BoolToVis}}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{StaticResource MauCanhBao}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding LaNguyHiem}" Value="True"><Setter Property="Background" Value="{StaticResource MauNguyHiem}" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Chi tiết phòng đang chọn: vì sao đang ở tình trạng này, khách, đặt phòng, sự cố, việc tiếp theo -->
                    <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Thông tin phòng" Style="{StaticResource CardTitleStyle}" />
                            <Border Style="{StaticResource DividerStyle}" />
                            <TextBlock Text="Bấm vào một ô phòng ở bên trái để xem chi tiết.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding PhongDaChon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers><DataTrigger Binding="{Binding PhongDaChon}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Foreground="{StaticResource MauChinhDam}" FontWeight="Bold" FontSize="15">
                                    <Run Text="{Binding PhongDaChon.TenPhong, Mode=OneWay, StringFormat=Phòng {0}}" /><Run Text="  ·  " /><Run Text="{Binding PhongDaChon.TenLoaiPhong, Mode=OneWay}" /><Run Text="  ·  tầng " /><Run Text="{Binding PhongDaChon.Tang, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="Tình trạng hiện tại" Style="{StaticResource NhanChiTietStyle}" />
                                <TextBlock Text="{Binding PhongDaChon.TinhTrangHienThi}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource MauChu}" />
                                <TextBlock Text="{Binding PhongDaChon.DongBanHienThi}" TextWrapping="Wrap" Foreground="{StaticResource MauChinh}" FontSize="12.5" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding ChiTiet.DongTuLuc}" TextWrapping="Wrap" Foreground="{StaticResource MauChuPhu}" FontSize="12" Margin="0,2,0,0" Visibility="{Binding CoChiTiet, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding PhongDaChon.DongLyDoHienThi}" TextWrapping="Wrap" Foreground="{StaticResource MauChuPhu}" FontSize="12" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding ChiTiet.DongTruoc}" TextWrapping="Wrap" Foreground="{StaticResource MauChuPhu}" FontSize="12" Margin="0,2,0,0" Visibility="{Binding CoChiTiet, Converter={StaticResource BoolToVis}}" />

                                <Border Margin="0,10,0,0" Padding="10,7" CornerRadius="6" Background="{StaticResource MauCanhBaoNhat}" Visibility="{Binding CoCanhBaoPhong, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ChiTiet.CanhBao, StringFormat=⚠ {0}}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource MauNguyHiem}" />
                                </Border>

                                <StackPanel Visibility="{Binding CoKhachDangO, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Khách đang ở" Style="{StaticResource NhanChiTietStyle}" />
                                    <TextBlock Text="{Binding ChiTiet.KhachDangO.HienThi}" TextWrapping="Wrap" Foreground="{StaticResource MauChu}" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding CoDatPhongSapToi, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Đặt phòng sắp tới" Style="{StaticResource NhanChiTietStyle}" />
                                    <ItemsControl ItemsSource="{Binding ChiTiet.DatPhongSapToi}">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding HienThi}" TextWrapping="Wrap" Foreground="{StaticResource MauChu}" Margin="0,0,0,3" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Visibility="{Binding CoSuCo, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Sự cố chưa xử lý" Style="{StaticResource NhanChiTietStyle}" />
                                    <ItemsControl ItemsSource="{Binding ChiTiet.SuCo}">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding HienThi}" TextWrapping="Wrap" Foreground="{StaticResource MauChu}" Margin="0,0,0,3" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Visibility="{Binding CoNguoiDangDon, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Buồng phòng" Style="{StaticResource NhanChiTietStyle}" />
                                    <TextBlock Text="{Binding ChiTiet.NguoiDangDon}" TextWrapping="Wrap" Foreground="{StaticResource MauChu}" />
                                </StackPanel>

                                <TextBlock Text="Việc tiếp theo" Style="{StaticResource NhanChiTietStyle}" Visibility="{Binding CoChiTiet, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding ChiTiet.ViecTiepTheo}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource MauChinh}" Visibility="{Binding CoChiTiet, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Text="Xử lý nhanh" Style="{StaticResource NhanChiTietStyle}" Visibility="{Binding CoChiTiet, Converter={StaticResource BoolToVis}}" />
                                <WrapPanel>
                                    <Button Content="Trả phòng" Command="{Binding TraPhongDangOCommand}" Style="{StaticResource OutlineButtonStyle}" Padding="10,3" MinHeight="28" Margin="0,0,8,6" Visibility="{Binding CoKhachDangOHienTai, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Gia hạn / đổi phòng" Command="{Binding GiaHanDoiPhongDangOCommand}" Style="{StaticResource OutlineButtonStyle}" Padding="10,3" MinHeight="28" Margin="0,0,8,6" Visibility="{Binding CoKhachDangOHienTai, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Dịch vụ" Command="{Binding DichVuDangOCommand}" Style="{StaticResource OutlineButtonStyle}" Padding="10,3" MinHeight="28" Margin="0,0,8,6" Visibility="{Binding CoKhachDangOHienTai, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Nhận phòng theo booking" Command="{Binding NhanTheoBookingCommand}" Padding="10,3" MinHeight="28" Margin="0,0,8,6" Visibility="{Binding CoTheNhanTheoBooking, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Nhận khách vãng lai" Command="{Binding NhanVangLaiCommand}" Style="{StaticResource OutlineButtonStyle}" Padding="10,3" MinHeight="28" Margin="0,0,8,6" Visibility="{Binding CoTheNhanVangLai, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Mở booking của phòng" Command="{Binding MoBookingCuaPhongCommand}" Style="{StaticResource OutlineButtonStyle}" Padding="10,3" MinHeight="28" Margin="0,0,8,6" Visibility="{Binding CoTheMoBooking, Converter={StaticResource BoolToVis}}" />
                                </WrapPanel>
                                <TextBlock Text="Mở màn hình liên quan" Style="{StaticResource NhanChiTietStyle}" Visibility="{Binding CoChiTiet, Converter={StaticResource BoolToVis}}" />
                                <WrapPanel>
                                    <Button Content="Mở Buồng phòng" Command="{Binding MoBuongPhongCommand}" Style="{StaticResource OutlineButtonStyle}" Padding="10,3" MinHeight="28" Margin="0,0,10,8" Visibility="{Binding CoQuyenMoBuongPhong, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Mở Phiếu đặt phòng" Command="{Binding MoDatPhongCommand}" Style="{StaticResource OutlineButtonStyle}" Padding="10,3" MinHeight="28" Margin="0,0,0,8" Visibility="{Binding CoQuyenMoDatPhong, Converter={StaticResource BoolToVis}}" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" VerticalAlignment="Top" Visibility="{Binding CheDoChiXem, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource HintTextStyle}" FontSize="12.5" TextWrapping="Wrap"
                                   Text="{Binding GhiChuChiXem}" />
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" VerticalAlignment="Top" Visibility="{Binding CoTheDoiTrangThai, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Đổi trạng thái" Style="{StaticResource CardTitleStyle}" />
                            <Border Style="{StaticResource DividerStyle}" />

                            <Border Style="{StaticResource InsetStyle}" Padding="12,10">
                                <TextBlock TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="{StaticResource MauChinhDam}" />
                                            <Setter Property="Text" Value="{Binding PhongDaChon.TenPhong, StringFormat=Phòng đang chọn: {0}}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PhongDaChon}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="Bấm chọn 1 ô phòng ở bên trái trước để đổi trạng thái." />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Setter Property="Foreground" Value="{StaticResource MauChuNhat}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <TextBlock Text="{Binding GoiYXacNhanDon}" Style="{StaticResource HintTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding CoGoiYXacNhanDon, Converter={StaticResource BoolToVis}}" />
                            <HeaderedContentControl Header="Trạng thái mới" Margin="0,14,0,0">
                                <ComboBox ItemsSource="{Binding TrangThaiDuocPhep}" SelectedItem="{Binding TrangThaiMoi}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource TrangThaiPhongConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </HeaderedContentControl>
                            <HeaderedContentControl Header="Lý do / ghi chú" Margin="0,12,0,0">
                                <TextBox Text="{Binding GhiChu, UpdateSourceTrigger=PropertyChanged}" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MaxLength="255" />
                            </HeaderedContentControl>
                            <TextBlock Text="{Binding NhacLyDo}" Style="{StaticResource HintTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding CanLyDo, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Tình trạng này không có thao tác nào bạn được phép thực hiện (xem gợi ý phía trên)." Margin="0,10,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                                        <Style.Triggers><DataTrigger Binding="{Binding CoThaoTacDuocPhep}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Content="Cập nhật" Command="{Binding CapNhatTrangThaiCommand}" Margin="0,16,0,0" HorizontalAlignment="Stretch" IsEnabled="{Binding DangLuu, Converter={StaticResource InverseBooleanConverter}}"
                                    Visibility="{Binding CoThaoTacDuocPhep, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <ctl:NoticeBar Text="{Binding ThongBao}" IsError="{Binding ThongBaoLaLoi}" Margin="0,12,0,0" />

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
