<UserControl x:Class="KLCN060.Desktop.Views.D21DoiMatKhauView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:KLCN060.Desktop.Controls">
    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ctl:PageHeader Title="Đổi mật khẩu" Subtitle="Đặt mật khẩu mới cho tài khoản của bạn. Sau khi đổi, bạn cần đăng nhập lại." />

        <Grid Grid.Row="1" Margin="0,20,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="28" VerticalAlignment="Top">
            <StackPanel>
                <HeaderedContentControl Header="Mật khẩu hiện tại">
                    <PasswordBox x:Name="MatKhauCu" Height="38" Padding="10,7" />
                </HeaderedContentControl>
                <HeaderedContentControl Header="Mật khẩu mới (tối thiểu 8 ký tự)" Margin="0,16,0,0">
                    <PasswordBox x:Name="MatKhauMoi" Height="38" Padding="10,7" />
                </HeaderedContentControl>
                <HeaderedContentControl Header="Nhập lại mật khẩu mới" Margin="0,16,0,0">
                    <PasswordBox x:Name="NhapLai" Height="38" Padding="10,7" />
                </HeaderedContentControl>

                <ctl:NoticeBar Text="{Binding ThongBao}" IsError="{Binding ThongBaoLaLoi}" Margin="0,16,0,0" />

                <Button Content="Đổi mật khẩu" IsDefault="True" Click="DoiButton_Click" HorizontalAlignment="Left" MinWidth="160" Margin="0,20,0,0"
                        IsEnabled="{Binding DangXuLy, Converter={StaticResource InverseBooleanConverter}}" />
            </StackPanel>
        </Border>

        </Grid>
    </Grid>
</UserControl>
