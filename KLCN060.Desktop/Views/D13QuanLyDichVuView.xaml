<UserControl x:Class="KLCN060.Desktop.Views.D13ServiceCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F4F7FB">
        <Grid Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock Text="Quản lý danh mục dịch vụ" FontSize="26" FontWeight="Bold" Foreground="#1E3A5F" />
                    <TextBlock Text="Quản lý các dịch vụ cung cấp tại khách sạn." Margin="0,5,0,0" Foreground="#64748B" />
                </StackPanel>
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Phòng" Command="{Binding DataContext.HienThiPhongCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="White" Foreground="#1F4E79" BorderBrush="#1F4E79" />
                    <Button Content="Khuyến mãi" Command="{Binding DataContext.HienThiKhuyenMaiCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="White" Foreground="#1F4E79" BorderBrush="#1F4E79" />
                    <Button Content="Dịch vụ" IsEnabled="False" Opacity="0.65" />
                    <Button Content="Cơ sở vật chất" Command="{Binding DataContext.HienThiCoSoVatChatCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="White" Foreground="#1F4E79" BorderBrush="#1F4E79" />
                </WrapPanel>
            </Grid>
            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="18" Margin="0,18,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <WrapPanel>
                    <StackPanel><TextBlock Text="Tên dịch vụ" Foreground="#475569" /><TextBox Width="200" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel><TextBlock Text="Đơn giá" Foreground="#475569" /><TextBox Width="120" Text="{Binding Price}" /></StackPanel>
                    <StackPanel><TextBlock Text="Đơn vị tính" Foreground="#475569" /><TextBox Width="130" Text="{Binding Unit}" /></StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Lưu" Command="{Binding SaveCommand}" /><Button Content="Xóa" Command="{Binding DeleteCommand}" Background="#B91C1C" BorderBrush="#B91C1C" /><Button Content="Làm mới" Command="{Binding ClearCommand}" Background="White" Foreground="#1F4E79" BorderBrush="#1F4E79" /></StackPanel>
                </WrapPanel>
            </Border>
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding Message}" Foreground="#B91C1C" TextWrapping="Wrap" />
                <DataGrid Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã dịch vụ" Binding="{Binding MaDV}" Width="100" />
                        <DataGridTextColumn Header="Tên dịch vụ" Binding="{Binding TenDV}" Width="*" />
                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding GiaDV, StringFormat=N0}" Width="150" />
                        <DataGridTextColumn Header="Đơn vị tính" Binding="{Binding DonViTinh}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
