<UserControl x:Class="KLCN060.Desktop.Views.D25BangGiaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KLCN060.Desktop.ViewModels"
             xmlns:ctl="clr-namespace:KLCN060.Desktop.Controls">
    <UserControl.Resources>
        <Style x:Key="NutTabStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="FontSize" Value="12.5" />
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EqualsMultiConverter}">
                            <Binding Path="DataContext.Tab" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource MauChinh}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NoiDungTabStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EqualsMultiConverter}">
                            <Binding Path="DataContext.Tab" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LoiOStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MauNguyHiem}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="ChipLocStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="GhiChuStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MauChuPhu}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,20,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ctl:PageHeader Title="Bảng giá phòng" ManagerTitle="Quản lý bảng giá phòng" Subtitle="Quy tắc giá cuối tuần, mùa cao điểm, lễ/tết, giá đoàn. Đơn giá cơ bản của loại phòng sửa ở Danh mục phòng." />
        <ctl:NoticeBar Grid.Row="1" Text="{Binding ThongBao}" IsError="{Binding ThongBaoLaLoi}" Margin="0,8,0,0" />
        <StackPanel Grid.Row="2" Margin="0,8,0,8">
            <TextBlock Text="{Binding ThongKe}" FontWeight="SemiBold" Foreground="{StaticResource MauChinh}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="420" /><ColumnDefinition Width="14" /><ColumnDefinition Width="400" /></Grid.ColumnDefinitions>

            <!-- Trái: danh sách quy tắc + công cụ kiểm tra -->
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="240" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <WrapPanel>
                            <Button Style="{StaticResource ChipLocStyle}" Content="Đang áp dụng" Command="{Binding LocNhanhCommand}" CommandParameter="DANG_AP_DUNG" />
                            <Button Style="{StaticResource ChipLocStyle}" Content="Đang tắt" Command="{Binding LocNhanhCommand}" CommandParameter="TAT" />
                            <Button Style="{StaticResource ChipLocStyle}" Content="Chưa bắt đầu / hết hạn" Command="{Binding LocNhanhCommand}" CommandParameter="HET_HAN" />
                            <Button Style="{StaticResource ChipLocStyle}" Content="⚠ Có cảnh báo" Command="{Binding LocNhanhCommand}" CommandParameter="CANH_BAO" />
                        </WrapPanel>
                        <StackPanel Grid.Row="1" Margin="0,2,0,8"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <HeaderedContentControl Header="Tìm theo tên, loại quy tắc, loại phòng"><TextBox Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}" /></HeaderedContentControl>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="Xóa lọc" Command="{Binding XoaBoLocCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0" />
                                <Button Content="Tải lại" Command="{Binding TaiCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                        </StackPanel>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="{Binding TieuDe}" FontWeight="SemiBold" Foreground="{StaticResource MauChinh}" Margin="0,0,0,6" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding DanhSach}" SelectedItem="{Binding QuyTacDaChon}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" RowHeight="NaN" CanUserSortColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Quy tắc" Width="*" MinWidth="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4">
                                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"><Run Text="{Binding TenQuyTac, Mode=OneWay}" /></TextBlock>
                                                    <TextBlock FontSize="11.5" Foreground="{StaticResource MauChuPhu}" TextWrapping="Wrap"><Run Text="{Binding LoaiHienThi, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding PhamViLoaiPhong, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DoiTuongHienThi, Mode=OneWay}" /></TextBlock>
                                                    <TextBlock Text="{Binding ThoiGianHienThi}" FontSize="11" Foreground="{StaticResource MauChuNhat}" TextWrapping="Wrap" />
                                                    <TextBlock Text="⚠ Cùng ưu tiên, phạm vi giao nhau với quy tắc khác" FontSize="11" Foreground="{StaticResource MauCanhBao}" Visibility="{Binding CoCanhBao, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Mức giá / trạng thái" Width="170">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold"><Run Text="{Binding MucGiaHienThi, Mode=OneWay}" /><Run Text="  · ưu tiên " Foreground="{StaticResource MauChuNhat}" /><Run Text="{Binding UuTien, Mode=OneWay}" Foreground="{StaticResource MauChuNhat}" /></TextBlock>
                                                    <TextBlock Text="{Binding TrangThaiHienThi}" FontWeight="Bold" FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource MauChuNhat}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HieuLuc}" Value="DANG_AP_DUNG"><Setter Property="Foreground" Value="{StaticResource MauThanhCong}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding HieuLuc}" Value="CHUA_BAT_DAU"><Setter Property="Foreground" Value="{StaticResource MauThongTin}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding HieuLuc}" Value="DA_HET_HAN"><Setter Property="Foreground" Value="{StaticResource MauCanhBao}" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding DaChotHienThi}" FontSize="11" Foreground="{StaticResource MauChuNhat}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300" Style="{StaticResource HintTextStyle}"
                                       Visibility="{Binding TrongDanhSach, Converter={StaticResource BoolToVis}}" Text="Chưa có quy tắc nào khớp. Bấm &quot;Xóa lọc&quot; hoặc thêm quy tắc mới ở bên phải." />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Công cụ tự kiểm tra -->
                <Expander Grid.Row="2" IsExpanded="False" FontWeight="SemiBold" Foreground="{StaticResource MauChinh}"
                          Header="Công cụ kiểm tra giá: báo giá thử · giá đã chốt của đặt phòng · lịch sử thay đổi (bấm để mở)">
                <Border Style="{StaticResource CardStyle}" Padding="14" Height="300" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Báo giá thử" Tag="BAO_GIA" Command="{Binding ChonTabCommand}" CommandParameter="BAO_GIA" Style="{StaticResource NutTabStyle}" />
                            <Button Content="Giá đã chốt của đặt phòng" Tag="GIA_CHOT" Command="{Binding ChonTabCommand}" CommandParameter="GIA_CHOT" Style="{StaticResource NutTabStyle}" />
                            <Button Content="Lịch sử thay đổi" Tag="LICH_SU" Command="{Binding ChonTabCommand}" CommandParameter="LICH_SU" Style="{StaticResource NutTabStyle}" />
                        </StackPanel>

                        <!-- Báo giá thử -->
                        <Grid Grid.Row="1" Margin="0,10,0,0" Tag="BAO_GIA" Style="{StaticResource NoiDungTabStyle}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="110" /><ColumnDefinition Width="8" /><ColumnDefinition Width="130" /><ColumnDefinition Width="8" /><ColumnDefinition Width="130" /><ColumnDefinition Width="8" /><ColumnDefinition Width="96" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <HeaderedContentControl Header="Loại phòng">
                                    <ComboBox ItemsSource="{Binding LoaiPhongs}" DisplayMemberPath="Ten" SelectedValuePath="Ma" SelectedValue="{Binding MaLoaiBaoGia}" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Grid.Column="2" Header="Ngày nhận"><DatePicker SelectedDate="{Binding NhanBaoGia}" /></HeaderedContentControl>
                                <HeaderedContentControl Grid.Column="4" Header="Ngày trả"><DatePicker SelectedDate="{Binding TraBaoGia}" /></HeaderedContentControl>
                                <HeaderedContentControl Grid.Column="6" Header="Loại đặt">
                                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding LoaiDatBaoGia}">
                                        <ComboBoxItem Tag="CA_NHAN" Content="Cá nhân" IsSelected="True" />
                                        <ComboBoxItem Tag="DOAN" Content="Đoàn" />
                                    </ComboBox>
                                </HeaderedContentControl>
                                <Button Grid.Column="8" Content="Xem giá" Command="{Binding XemBaoGiaCommand}" VerticalAlignment="Bottom" Margin="0" MinWidth="90" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding TomTatBaoGia}" FontWeight="SemiBold" Foreground="{StaticResource MauChinh}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <DataGrid Grid.Row="2" ItemsSource="{Binding KetQuaTheoDem}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,6,0,0" RowHeight="NaN">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Đêm" Binding="{Binding Dem, StringFormat=ddd dd/MM/yyyy}" Width="138" />
                                    <DataGridTextColumn Header="Giá cơ bản" Binding="{Binding GiaCoBan, StringFormat={}{0:N0}đ}" Width="92" />
                                    <DataGridTemplateColumn Header="Quy tắc áp dụng" Width="*" MinWidth="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2">
                                                    <TextBlock Text="{Binding QuyTacChiTiet}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding GhiChuKhop}" FontSize="10.5" Foreground="{StaticResource MauChuNhat}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Chênh lệch" Binding="{Binding ChenhLechHienThi}" Width="84" />
                                    <DataGridTextColumn Header="Giá cuối" Binding="{Binding Gia, StringFormat={}{0:N0}đ}" Width="92"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- Giá đã chốt của một đặt phòng -->
                        <Grid Grid.Row="1" Margin="0,10,0,0" Tag="GIA_CHOT" Style="{StaticResource NoiDungTabStyle}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="320" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <HeaderedContentControl Header="Mã phiếu đặt phòng"><TextBox Text="{Binding MaPhieuTraCuu, UpdateSourceTrigger=PropertyChanged}" /></HeaderedContentControl>
                                <Button Grid.Column="2" Content="Xem giá đã chốt" Command="{Binding TraCuuGiaChotCommand}" VerticalAlignment="Bottom" Margin="0" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding TieuDeGiaChot}" FontWeight="SemiBold" Foreground="{StaticResource MauChinh}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding GiaChotPhong}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding TieuDe}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                                    <ItemsControl ItemsSource="{Binding TheoDem}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock FontSize="11.5" Foreground="{StaticResource MauChuPhu}" TextWrapping="Wrap" Margin="12,1,0,0">
                                                                    <Run Text="{Binding Dem, StringFormat=ddd dd/MM, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Gia, StringFormat={}{0:N0}đ, Mode=OneWay}" FontWeight="Bold" /><Run Text=" (cơ bản " /><Run Text="{Binding GiaCoBan, StringFormat={}{0:N0}đ, Mode=OneWay}" /><Run Text=") - " /><Run Text="{Binding QuyTacHienThi, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SoVoiHienHanh, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding QuyTacTinhLai}" Style="{StaticResource GhiChuStyle}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Lịch sử thay đổi -->
                        <Grid Grid.Row="1" Margin="0,10,0,0" Tag="LICH_SU" Style="{StaticResource NoiDungTabStyle}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource HintTextStyle}" FontSize="11.5" TextWrapping="Wrap" Text="Chọn một quy tắc để xem lịch sử của riêng nó; bỏ chọn (bấm 'Thêm quy tắc mới') để xem toàn bộ thay đổi bảng giá, kể cả quy tắc đã xóa. Ai · lúc nào · trước → sau." />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                <ItemsControl ItemsSource="{Binding LichSu}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding HienThi}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ChiTietDoc}" FontSize="11" Foreground="{StaticResource MauChuPhu}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
                </Expander>
            </Grid>

            <!-- Phải: form thêm/sửa -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TieuDeForm}" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="＋ Quy tắc mới" Command="{Binding QuyTacMoiCommand}" Padding="12,5" MinHeight="32" Margin="8,0,0,0" Visibility="{Binding CoTheQuanLy, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <TextBlock Text="{Binding ThongTinQuyTac}" Style="{StaticResource GhiChuStyle}" />
                        <Border Background="#F4F1E8" CornerRadius="8" Padding="10,8" Margin="0,8,0,0"><TextBlock Text="{Binding CongThuc}" FontSize="11.5" Foreground="{StaticResource MauChuPhu}" TextWrapping="Wrap" /></Border>

                        <HeaderedContentControl Header="Tên quy tắc *" Margin="0,12,0,0"><TextBox Text="{Binding TenQuyTac, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" /></HeaderedContentControl>
                        <TextBlock Text="{Binding LoiTen}" Style="{StaticResource LoiOStyle}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <HeaderedContentControl Header="Loại quy tắc">
                                <ComboBox ItemsSource="{x:Static vm:BangGiaViewModel.LoaiQuyTacTuyChon}" DisplayMemberPath="Ten" SelectedValuePath="Ma" SelectedValue="{Binding LoaiQuyTac}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Grid.Column="2" Header="Áp dụng cho loại phòng">
                                <ComboBox ItemsSource="{Binding LoaiPhongs}" DisplayMemberPath="Ten" SelectedValuePath="Ma" SelectedValue="{Binding MaLoai}" />
                            </HeaderedContentControl>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <HeaderedContentControl Header="Cách điều chỉnh">
                                <ComboBox ItemsSource="{x:Static vm:BangGiaViewModel.KieuTuyChon}" DisplayMemberPath="Ten" SelectedValuePath="Ma" SelectedValue="{Binding Kieu}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Grid.Column="2" Header="Giá trị *"><TextBox ctl:MoneyInput.DinhDang="{Binding GiaTriLaTien}" Text="{Binding GiaTri, UpdateSourceTrigger=PropertyChanged}" /></HeaderedContentControl>
                        </Grid>
                        <TextBlock Text="{Binding GoiYGiaTri}" Style="{StaticResource HintTextStyle}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LoiGiaTri}" Style="{StaticResource LoiOStyle}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <HeaderedContentControl Header="Từ ngày"><DatePicker SelectedDate="{Binding TuNgay}" /></HeaderedContentControl>
                            <HeaderedContentControl Grid.Column="2" Header="Đến ngày"><DatePicker SelectedDate="{Binding DenNgay}" /></HeaderedContentControl>
                        </Grid>
                        <TextBlock Style="{StaticResource HintTextStyle}" FontSize="11.5" Margin="0,3,0,0" Text="Bỏ trống ngày = không giới hạn thời gian." />
                        <HeaderedContentControl Header="Áp dụng cho các đêm (bỏ trống = mọi ngày)" Margin="0,10,0,0">
                            <WrapPanel>
                                <CheckBox Content="T2" IsChecked="{Binding ThuHai}" Margin="0,0,12,4" />
                                <CheckBox Content="T3" IsChecked="{Binding ThuBa}" Margin="0,0,12,4" />
                                <CheckBox Content="T4" IsChecked="{Binding ThuTu}" Margin="0,0,12,4" />
                                <CheckBox Content="T5" IsChecked="{Binding ThuNam}" Margin="0,0,12,4" />
                                <CheckBox Content="T6" IsChecked="{Binding ThuSau}" Margin="0,0,12,4" />
                                <CheckBox Content="T7" IsChecked="{Binding ThuBay}" Margin="0,0,12,4" />
                                <CheckBox Content="CN" IsChecked="{Binding ChuNhat}" Margin="0,0,12,4" />
                            </WrapPanel>
                        </HeaderedContentControl>
                        <TextBlock Text="{Binding LoiNgay}" Style="{StaticResource LoiOStyle}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                            <HeaderedContentControl Header="Đối tượng đặt phòng">
                                <ComboBox ItemsSource="{x:Static vm:BangGiaViewModel.DoiTuongTuyChon}" DisplayMemberPath="Ten" SelectedValuePath="Ma" SelectedValue="{Binding DoiTuong}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Grid.Column="2" Header="Ưu tiên *"><TextBox ToolTip="Số lớn = ưu tiên cao; khi nhiều quy tắc cùng khớp một đêm, quy tắc ưu tiên cao nhất được áp dụng" Text="{Binding UuTien, UpdateSourceTrigger=PropertyChanged}" /></HeaderedContentControl>
                        </Grid>
                        <TextBlock Text="{Binding LoiUuTien}" Style="{StaticResource LoiOStyle}" />
                        <CheckBox Content="Đang bật (áp dụng cho đặt phòng mới)" IsChecked="{Binding HoatDong}" Margin="0,10,0,0" />
                        <HeaderedContentControl Header="Ghi chú" Margin="0,10,0,0"><TextBox Text="{Binding GhiChu}" MaxLength="255" /></HeaderedContentControl>

                        <Button Content="Lưu quy tắc" Command="{Binding LuuCommand}" HorizontalAlignment="Stretch" Margin="0,16,0,0" Style="{StaticResource AccentButtonStyle}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Content="Hoàn tác" Command="{Binding HoanTacCommand}" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Content="Bật / Tắt" Command="{Binding BatTatCommand}" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="2" Content="Xóa" Command="{Binding XoaCommand}" Style="{StaticResource DangerOutlineButtonStyle}" HorizontalAlignment="Stretch" Margin="0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
