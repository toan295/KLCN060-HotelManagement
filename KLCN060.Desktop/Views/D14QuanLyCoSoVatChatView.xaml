<UserControl x:Class="KLCN060.Desktop.Views.D14FacilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F4F7FB">
        <Grid Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock Text="Quản lý cơ sở vật chất" FontSize="26" FontWeight="Bold" Foreground="#1E3A5F" />
                    <TextBlock Text="Theo dõi cơ sở vật chất đang có trong từng phòng." Margin="0,5,0,0" Foreground="#64748B" />
                </StackPanel>
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Phòng" Command="{Binding DataContext.HienThiPhongCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="White" Foreground="#1F4E79" BorderBrush="#1F4E79" />
                    <Button Content="Khuyến mãi" Command="{Binding DataContext.HienThiKhuyenMaiCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="White" Foreground="#1F4E79" BorderBrush="#1F4E79" />
                    <Button Content="Dịch vụ" Command="{Binding DataContext.HienThiDichVuCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="White" Foreground="#1F4E79" BorderBrush="#1F4E79" />
                    <Button Content="Cơ sở vật chất" IsEnabled="False" Opacity="0.65" />
                </WrapPanel>
            </Grid>
            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14" Margin="0,18,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <DockPanel>
                    <TextBlock Text="Danh sách thiết bị của toàn bộ phòng" FontWeight="SemiBold" Foreground="#1E3A5F" VerticalAlignment="Center" />
                    <Button Content="Tải lại" Command="{Binding LoadCommand}" DockPanel.Dock="Right" Margin="8,0,0,0" Width="115" />
                </DockPanel>
            </Border>
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding Message}" Foreground="#B91C1C" TextWrapping="Wrap" />
                <DataGrid Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Facilities}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã" Binding="{Binding MaSo}" Width="80" />
                        <DataGridTextColumn Header="Tên thiết bị" Binding="{Binding Ten}" Width="*" />
                        <DataGridTextColumn Header="Phòng" Binding="{Binding Phong}" Width="180" />
                        <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="120" />
                        <DataGridTextColumn Header="Tình trạng" Binding="{Binding TinhTrang}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
