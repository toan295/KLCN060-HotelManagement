<UserControl x:Class="KLCN060.Desktop.Views.D14QuanLyCoSoVatChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F5F6F0">
        <Grid Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Quản lý cơ sở vật chất" FontSize="26" FontWeight="Bold" Foreground="#123328" />
                <TextBlock Text="Theo dõi cơ sở vật chất đang có trong từng phòng." Margin="0,5,0,0" Foreground="#647A6C" />
            </StackPanel>
            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14" Margin="0,18,0,0" BorderBrush="#D7DDCE" BorderThickness="1">
                <DockPanel>
                    <TextBlock Text="Danh sách thiết bị của toàn bộ phòng" FontWeight="SemiBold" Foreground="#123328" VerticalAlignment="Center" />
                    <Button Content="Tải lại" Command="{Binding LoadCommand}" DockPanel.Dock="Right" Margin="8,0,0,0" Width="115" />
                </DockPanel>
            </Border>
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding Message}" Foreground="#C8452F" TextWrapping="Wrap" />
                <DataGrid Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Facilities}" AutoGenerateColumns="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã" Binding="{Binding MaSo}" Width="80" />
                        <DataGridTextColumn Header="Tên thiết bị" Binding="{Binding Ten}" Width="*" />
                        <DataGridTextColumn Header="Phòng" Binding="{Binding Phong}" Width="180" />
                        <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="120" />
                        <DataGridTemplateColumn Header="Tình trạng" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#EAEEE4" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TinhTrang}" Value="TOT"><Setter Property="Background" Value="#E3EDE7" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding TinhTrang}" Value="HONG_DANG_SUA"><Setter Property="Background" Value="#F6E1DC" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding TinhTrang}" Value="DA_THAY_MOI"><Setter Property="Background" Value="#DCEAF3" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding TinhTrang}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#647A6C" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TinhTrang}" Value="TOT"><Setter Property="Foreground" Value="#2E9E6B" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding TinhTrang}" Value="HONG_DANG_SUA"><Setter Property="Foreground" Value="#C8452F" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding TinhTrang}" Value="DA_THAY_MOI"><Setter Property="Foreground" Value="#2F7FBD" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
