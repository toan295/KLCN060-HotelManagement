<UserControl x:Class="KLCN060.Desktop.Views.D7TraPhongView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:KLCN060.Desktop.Controls">
    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ctl:PageHeader Title="Trả phòng" Subtitle="Chọn khách đang trả → kiểm tra khách/phòng/ngày ở, folio và điều kiện → xác nhận trả phòng để lập hóa đơn." />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
        <Grid>            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Chọn khách trả phòng (toàn chiều rộng: đủ cột loại phòng, ngày nhận, ngày trả - không bị cắt chữ) -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="1. Khách đang ở" Style="{StaticResource CardTitleStyle}" />
                    <HeaderedContentControl Margin="0,10,0,8" Header="Tìm khách đang ở (số phòng, tên khách, mã phiếu nhận hoặc mã phiếu đặt)">
                        <Grid>
                            <TextBox x:Name="OTimKiem" Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}" ToolTip="Gõ số phòng (VD P302), tên khách hoặc mã phiếu để lọc danh sách bên dưới; không cần gõ dấu. Xóa chữ để xem lại tất cả." />
                            <TextBlock Text="Ví dụ: P302, Nguyen An, BK2026..." Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding GoiYTimHien}" Value="True" /><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=OTimKiem}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </Grid>
                    </HeaderedContentControl>
                    <Grid>
                        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MaxHeight="150" MinHeight="70" ItemsSource="{Binding Luot}" SelectedItem="{Binding LuotDaChon}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="80" Header="Phòng" Binding="{Binding MaPhong}" />
                                <DataGridTextColumn Width="140" Header="Loại phòng" Binding="{Binding TenLoai}" />
                                <DataGridTextColumn Width="*" MinWidth="150" Header="Khách" Binding="{Binding KhachHienThi}" />
                                <DataGridTextColumn Width="115" Header="Ngày nhận" Binding="{Binding NgayNhanHienThi}" />
                                <DataGridTextColumn Width="170" Header="Trả phòng (dự kiến)" Binding="{Binding NgayTraHienThi}" />
                                <DataGridTextColumn Width="90" Header="Số người" Binding="{Binding SoNguoi}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Không có khách nào đang ở khớp với từ khóa." Style="{StaticResource HintTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding KhongCoLuot, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. Thông tin + folio + điều kiện -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="2. Kiểm tra trước khi trả phòng" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{Binding DangChonHienThi}" Margin="0,10,0,0" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />

                        <StackPanel Visibility="{Binding CoThongTin, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ThongTin.MaHienThi}" Style="{StaticResource HintTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ThongTin.NgayHienThi}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ThongTin.PhamViHoaDon}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding ThongTin.PhongKhac}" Margin="0,6,0,0" Visibility="{Binding ThongTin.CoPhongKhac, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding DongHienThi, StringFormat='Phòng khác của phiếu: {0}'}" Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding ThongTin.CanhBao}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding StringFormat='⚠ {0}'}" TextWrapping="Wrap" Foreground="{StaticResource MauNguyHiem}" Margin="0,2,0,0" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Điều kiện trả phòng -->
                            <Border Style="{StaticResource DividerStyle}" Margin="0,14,0,10" />
                            <TextBlock Text="Điều kiện trả phòng (hệ thống tự kiểm tra)" Style="{StaticResource SubTitleStyle}" />
                            <ItemsControl ItemsSource="{Binding ThongTin.DieuKien}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding DongHienThi}" TextWrapping="Wrap" Margin="0,2,0,0" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ThongTin.LyDoKhongTra, StringFormat='KHÔNG THỂ TRẢ PHÒNG: {0}'}" Foreground="{StaticResource MauNguyHiem}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding KhongTraDuoc, Converter={StaticResource BoolToVis}}" />

                            <!-- Folio -->
                            <Border Style="{StaticResource DividerStyle}" Margin="0,14,0,10" />
                            <TextBlock Text="Folio - chi tiết các khoản" Style="{StaticResource SubTitleStyle}" />
                            <DataGrid Margin="0,8,0,0" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="210" ItemsSource="{Binding ThongTin.ChiTiet}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="120" Header="Loại" Binding="{Binding LoaiKhoanMuc}" />
                                    <DataGridTextColumn Width="*" MinWidth="140" Header="Nội dung" Binding="{Binding MoTa}" />
                                    <DataGridTextColumn Width="50" Header="SL" Binding="{Binding SoLuong}" />
                                    <DataGridTextColumn Width="104" Header="Đơn giá" Binding="{Binding DonGia, Converter={StaticResource VndMoneyConverter}}" />
                                    <DataGridTextColumn Width="110" Header="Thành tiền" Binding="{Binding ThanhTien, Converter={StaticResource VndMoneyConverter}}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <CheckBox Margin="0,10,0,0" Content="Áp dụng phụ thu trả phòng trễ giờ (tính thêm 1 đêm)" IsChecked="{Binding ApDungPhuThuTreGio}" />

                            <!-- Tổng hợp tiền -->
                            <Border Background="{StaticResource MauChinhNhat}" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4"><TextBlock Text="Tiền phòng" Foreground="{StaticResource MauChuNhat}" /><TextBlock Text="{Binding ThongTin.TongHopFolio.TienPhong, StringFormat={}{0:N0}đ}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                                    <Grid Margin="0,0,0,4"><TextBlock Text="Phụ thu" Foreground="{StaticResource MauChuNhat}" /><TextBlock Text="{Binding ThongTin.TongHopFolio.PhuThu, StringFormat={}{0:N0}đ}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                                    <Grid Margin="0,0,0,4"><TextBlock Text="Dịch vụ" Foreground="{StaticResource MauChuNhat}" /><TextBlock Text="{Binding ThongTin.TongHopFolio.TienDichVu, StringFormat={}{0:N0}đ}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                                    <Grid Margin="0,0,0,4"><TextBlock Text="Tổng cộng" FontWeight="SemiBold" /><TextBlock Text="{Binding ThongTin.TongHopFolio.TongCong, StringFormat={}{0:N0}đ}" HorizontalAlignment="Right" FontWeight="Bold" /></Grid>
                                    <Grid Margin="0,0,0,4" Visibility="{Binding CoGiamGia, Converter={StaticResource BoolToVis}}"><TextBlock Text="Khuyến mãi" Foreground="{StaticResource MauChuNhat}" /><TextBlock Text="{Binding ThongTin.TongHopFolio.TongKhuyenMai, StringFormat=−{0:N0}đ}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                                    <Grid Margin="0,0,0,4" Visibility="{Binding CoCoc, Converter={StaticResource BoolToVis}}"><TextBlock Text="Tiền cọc đã thu" Foreground="{StaticResource MauChuNhat}" /><TextBlock Text="{Binding ThongTin.TongHopFolio.TienDaCoc, StringFormat=−{0:N0}đ}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                                    <Border Style="{StaticResource DividerStyle}" />
                                    <TextBlock Text="Còn phải thu" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhu}" />
                                    <TextBlock Text="{Binding ThongTin.TongHopFolio.ConPhaiThu, StringFormat={}{0:N0}đ}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource MauChinhDam}" />
                                    <TextBlock Text="{Binding ThongTin.GiaiThichConPhaiThu}" Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ThongTin.TinhLuc, StringFormat='Folio tính lúc {0:HH:mm:ss}'}" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Tải lại folio" Command="{Binding XemFolioCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,0" />
                                <Button Grid.Column="2" Content="Xác nhận trả phòng" Command="{Binding TraPhongCommand}" MinWidth="200" Margin="0" IsEnabled="{Binding TraSanSang}" />
                            </Grid>
                            <TextBlock Text="Đang xử lý..." Style="{StaticResource HintTextStyle}" HorizontalAlignment="Right" Margin="0,4,0,0" Visibility="{Binding DangTra, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- Kết quả lần trả phòng gần nhất -->
                        <Border Visibility="{Binding CoKetQua, Converter={StaticResource BoolToVis}}" Style="{StaticResource InsetStyle}" Padding="14,12" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding KetQua}" TextWrapping="Wrap" />
                                <Button Content="Thu tiền hóa đơn vừa lập" Command="{Binding ThuTienCommand}" HorizontalAlignment="Right" Margin="0,10,0,0" MinWidth="200"
                                        Visibility="{Binding CoHoaDonVuaLap, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        </ScrollViewer>

        <ctl:NoticeBar Grid.Row="2" Text="{Binding ThongBao}" IsError="{Binding ThongBaoLaLoi}" Margin="0,12,0,0" />
    </Grid>
</UserControl>
