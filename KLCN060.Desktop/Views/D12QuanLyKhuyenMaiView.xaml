<UserControl x:Class="KLCN060.Desktop.Views.D12QuanLyKhuyenMaiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F5F6F0">
        <Grid Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Quản lý khuyến mãi" FontSize="26" FontWeight="Bold" Foreground="#123328" />
                <TextBlock Text="Thiết lập chương trình khuyến mãi cho khách hàng." Margin="0,5,0,0" Foreground="#647A6C" />
            </StackPanel>
            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="18" Margin="0,18,0,0" BorderBrush="#D7DDCE" BorderThickness="1">
                <WrapPanel>
                    <StackPanel><TextBlock Text="Tên khuyến mãi" Foreground="#3C4C40" /><TextBox Width="165" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel>
                        <TextBlock Text="Loại" Foreground="#3C4C40" />
                        <ComboBox Width="150" Height="34" Margin="0,5,10,0" SelectedValuePath="Content" SelectedValue="{Binding Type}">
                            <ComboBoxItem Content="PHAN_TRAM" />
                            <ComboBoxItem Content="SO_TIEN_CO_DINH" />
                            <ComboBoxItem Content="QUA_TANG" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel><TextBlock Text="Giá trị" Foreground="#3C4C40" /><TextBox Width="90" Text="{Binding Value}" /></StackPanel>
                    <StackPanel><TextBlock Text="Ngày bắt đầu" Foreground="#3C4C40" /><DatePicker Width="125" SelectedDate="{Binding StartDate}" /></StackPanel>
                    <StackPanel><TextBlock Text="Ngày kết thúc" Foreground="#3C4C40" /><DatePicker Width="125" SelectedDate="{Binding EndDate}" /></StackPanel>
                    <StackPanel><TextBlock Text="Điều kiện" Foreground="#3C4C40" /><TextBox Width="155" Text="{Binding Condition}" /></StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Lưu" Command="{Binding SaveCommand}" /><Button Content="Làm mới" Command="{Binding ClearCommand}" Background="White" Foreground="#1F4D3D" BorderBrush="#1F4D3D" /></StackPanel>
                </WrapPanel>
            </Border>
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding Message}" Foreground="#C8452F" TextWrapping="Wrap" />
                <DataGrid Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Promotions}" SelectedItem="{Binding SelectedPromotion}" AutoGenerateColumns="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã" Binding="{Binding MaKM}" Width="60" />
                        <DataGridTextColumn Header="Tên khuyến mãi" Binding="{Binding TenKM}" Width="*" />
                        <DataGridTextColumn Header="Loại" Binding="{Binding LoaiKM}" Width="110" />
                        <DataGridTextColumn Header="Giá trị" Binding="{Binding GiaTri}" Width="90" />
                        <DataGridTextColumn Header="Ngày bắt đầu" Binding="{Binding NgayBatDau}" Width="110" />
                        <DataGridTextColumn Header="Ngày kết thúc" Binding="{Binding NgayKetThuc}" Width="110" />
                        <DataGridTextColumn Header="Điều kiện" Binding="{Binding DieuKien}" Width="*" />
                        <DataGridTemplateColumn Header="Trạng thái" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#EAEEE4" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TrangThai}" Value="Đang áp dụng"><Setter Property="Background" Value="#E3EDE7" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding TrangThai}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#647A6C" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="Đang áp dụng"><Setter Property="Foreground" Value="#2E9E6B" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
