<UserControl x:Class="KLCN060.Desktop.Views.D12PromotionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F4F7FB">
        <Grid Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock Text="Quản lý khuyến mãi" FontSize="26" FontWeight="Bold" Foreground="#1E3A5F" />
                    <TextBlock Text="Thiết lập chương trình khuyến mãi cho khách hàng." Margin="0,5,0,0" Foreground="#64748B" />
                </StackPanel>
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Phòng" Command="{Binding DataContext.HienThiPhongCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="White" Foreground="#1F4E79" BorderBrush="#1F4E79" />
                    <Button Content="Khuyến mãi" IsEnabled="False" Opacity="0.65" />
                    <Button Content="Dịch vụ" Command="{Binding DataContext.HienThiDichVuCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="White" Foreground="#1F4E79" BorderBrush="#1F4E79" />
                    <Button Content="Cơ sở vật chất" Command="{Binding DataContext.HienThiCoSoVatChatCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="White" Foreground="#1F4E79" BorderBrush="#1F4E79" />
                </WrapPanel>
            </Grid>
            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="18" Margin="0,18,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <WrapPanel>
                    <StackPanel><TextBlock Text="Tên khuyến mãi" Foreground="#475569" /><TextBox Width="165" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel><TextBlock Text="Loại" Foreground="#475569" /><TextBox Width="105" Text="{Binding Type}" /></StackPanel>
                    <StackPanel><TextBlock Text="Giá trị" Foreground="#475569" /><TextBox Width="90" Text="{Binding Value}" /></StackPanel>
                    <StackPanel><TextBlock Text="Ngày bắt đầu" Foreground="#475569" /><DatePicker Width="125" SelectedDate="{Binding StartDate}" /></StackPanel>
                    <StackPanel><TextBlock Text="Ngày kết thúc" Foreground="#475569" /><DatePicker Width="125" SelectedDate="{Binding EndDate}" /></StackPanel>
                    <StackPanel><TextBlock Text="Điều kiện" Foreground="#475569" /><TextBox Width="155" Text="{Binding Condition}" /></StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Lưu" Command="{Binding SaveCommand}" /><Button Content="Làm mới" Command="{Binding ClearCommand}" Background="White" Foreground="#1F4E79" BorderBrush="#1F4E79" /></StackPanel>
                </WrapPanel>
            </Border>
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding Message}" Foreground="#B91C1C" TextWrapping="Wrap" />
                <DataGrid Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Promotions}" SelectedItem="{Binding SelectedPromotion}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã" Binding="{Binding MaKM}" Width="60" />
                        <DataGridTextColumn Header="Tên khuyến mãi" Binding="{Binding TenKM}" Width="*" />
                        <DataGridTextColumn Header="Loại" Binding="{Binding LoaiKM}" Width="110" />
                        <DataGridTextColumn Header="Giá trị" Binding="{Binding GiaTri}" Width="90" />
                        <DataGridTextColumn Header="Ngày bắt đầu" Binding="{Binding NgayBatDau}" Width="110" />
                        <DataGridTextColumn Header="Ngày kết thúc" Binding="{Binding NgayKetThuc}" Width="110" />
                        <DataGridTextColumn Header="Điều kiện" Binding="{Binding DieuKien}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
