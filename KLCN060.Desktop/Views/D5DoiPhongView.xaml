<UserControl x:Class="KLCN060.Desktop.Views.D5DoiPhongView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28" Background="#F5F6F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Đổi phòng" FontSize="26" FontWeight="Bold" Foreground="#123328" />

        <Grid Grid.Row="1" Margin="0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="20" Background="White" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Lượt đang ở" FontSize="18" FontWeight="SemiBold" />
                    <DataGrid Margin="0,14,0,0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding LuotDangO}"
                              SelectedItem="{Binding LuotDaChon}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Header="Khách" Binding="{Binding HoTenKhach}" />
                            <DataGridTextColumn Width="90" Header="Phòng" Binding="{Binding MaPhong}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Padding="20" Background="White" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Chọn phòng mới" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Margin="0,18,0,5" Text="Phòng trống" />
                    <ComboBox Height="34"
                              ItemsSource="{Binding PhongTrong}"
                              DisplayMemberPath="TenPhong"
                              SelectedItem="{Binding PhongMoiDaChon}" />
                    <TextBlock Margin="0,14,0,5" Text="Ghi chú" />
                    <TextBox Height="70"
                             AcceptsReturn="True"
                             Text="{Binding GhiChu}"
                             TextWrapping="Wrap" />
                    <Button Width="180"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Center"
                            Command="{Binding DoiPhongCommand}"
                            Content="Xác nhận đổi phòng" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Foreground="#C8452F"
                   Text="{Binding ThongBao}"
                   FontSize="15"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
