<UserControl x:Class="KLCN060.Desktop.Views.D5DoiPhongView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:KLCN060.Desktop.Controls">
    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ctl:PageHeader Title="Đổi phòng" Subtitle="Chọn khách đang ở → chọn phòng mới → xem hạng, giá, chênh lệch → ghi lý do → xác nhận. Nâng hạng luôn thu chênh lệch giá." />

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="520" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="1. Khách đang ở" Style="{StaticResource CardTitleStyle}" />
                    <HeaderedContentControl Grid.Row="1" Margin="0,10,0,10" Header="Tìm khách đang ở (số phòng, tên khách, mã phiếu nhận hoặc mã phiếu đặt)">
                        <Grid>
                            <TextBox x:Name="OTimKiem" Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}" ToolTip="Gõ số phòng (VD P302), tên khách hoặc mã phiếu để lọc danh sách bên dưới; không cần gõ dấu. Xóa chữ để xem lại tất cả." />
                            <TextBlock Text="Ví dụ: P302, Nguyen An, BK2026..." Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding GoiYTimHien}" Value="True" /><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=OTimKiem}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </HeaderedContentControl>
                    <DataGrid Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              ItemsSource="{Binding LuotDangO}" SelectedItem="{Binding LuotDaChon}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="80" Header="Phòng" Binding="{Binding MaPhong}" />
                            <DataGridTextColumn Width="130" Header="Loại phòng" Binding="{Binding TenLoai}" />
                            <DataGridTextColumn Width="*" MinWidth="130" Header="Khách" Binding="{Binding KhachHienThi}" />
                            <DataGridTextColumn Width="105" Header="Nhận phòng" Binding="{Binding NgayNhanHienThi}" />
                            <DataGridTextColumn Width="165" Header="Trả phòng (dự kiến)" Binding="{Binding NgayTraHienThi}" />
                            <DataGridTextColumn Width="80" Header="Số người" Binding="{Binding SoNguoi}" />
                            <DataGridTextColumn Width="110" Header="Giá/đêm" Binding="{Binding DonGiaHienThi}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Text="{Binding LuotDaChonHienThi}" Margin="0,12,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2" Text="Không có khách nào đang ở khớp với từ khóa." Style="{StaticResource HintTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding KhongCoLuot, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="2. Chọn phòng mới" Style="{StaticResource CardTitleStyle}" />
                    <Border Style="{StaticResource DividerStyle}" />
                    <HeaderedContentControl Header="Phòng bán được ngay (đã dọn/kiểm tra, chưa giữ cho khách đến)">
                        <ComboBox ItemsSource="{Binding PhongTrong}" DisplayMemberPath="NhanChonPhong" SelectedItem="{Binding PhongMoiDaChon}" IsEnabled="{Binding CoLuotDaChon}" />
                    </HeaderedContentControl>

                    <!-- Xem trước: hạng, giá, chênh lệch, cần trả thêm bao nhiêu -->
                    <Border Visibility="{Binding CoXemTruoc, Converter={StaticResource BoolToVis}}" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding XemTruoc.TuDenHienThi}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding XemTruoc.LoaiDoiHienThi}" Margin="0,6,0,0" FontWeight="Bold" Foreground="{StaticResource MauNguyHiem}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers><DataTrigger Binding="{Binding XemTruoc.CoTheDoi}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding XemTruoc.TienHienThi}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding XemTruoc.HuongDan}" TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" Margin="0,6,0,0" />
                            <ItemsControl ItemsSource="{Binding XemTruoc.CanhBao}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding StringFormat='⚠ {0}'}" TextWrapping="Wrap" Foreground="{StaticResource MauNguyHiem}" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding XemTruoc.LyDoKhongDoi, StringFormat='Chưa đổi được: {0}'}" TextWrapping="Wrap" Foreground="{StaticResource MauNguyHiem}" FontWeight="SemiBold" Margin="0,6,0,0"
                                       Visibility="{Binding KhongDoiDuoc, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <HeaderedContentControl Header="Lý do đổi phòng (bắt buộc - ai yêu cầu, vì sao)" Margin="0,14,0,0">
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding LyDoThuongGap}" SelectedItem="{Binding LyDoNhanh}" ToolTip="Chọn lý do thường gặp (tự điền vào ô bên dưới)" />
                            <TextBox Height="56" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,6,0,0" MaxLength="200" Text="{Binding GhiChu, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <Button Content="Xác nhận đổi phòng" Command="{Binding DoiPhongCommand}" HorizontalAlignment="Right" MinWidth="210" Margin="0,20,0,0"
                            IsEnabled="{Binding NutDoiPhongSanSang}" ToolTip="Cần: chọn khách + phòng mới đổi được + nhập lý do" />

                    <Border Visibility="{Binding CoKetQuaDoi, Converter={StaticResource BoolToVis}}" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="12">
                        <TextBlock Text="{Binding KetQuaDoi}" TextWrapping="Wrap" />
                    </Border>

                    <!-- Gia hạn lưu trú: dời ngày trả dự kiến của lượt đang chọn ở bảng bên trái -->
                    <Border Style="{StaticResource DividerStyle}" Margin="0,22,0,14" />
                    <TextBlock Text="Gia hạn lưu trú" Style="{StaticResource SubTitleStyle}" />
                    <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Dời ngày trả dự kiến của lượt đang chọn. Không gia hạn được nếu phòng đã có đặt phòng khác trong những đêm thêm (hãy đổi phòng). Tiền phòng thêm = số đêm × đơn giá của lượt ở." />
                    <HeaderedContentControl Header="Ngày trả mới" Margin="0,10,0,0"><DatePicker SelectedDate="{Binding NgayGiaHan}" IsEnabled="{Binding CoLuotDaChon}" /></HeaderedContentControl>
                    <TextBlock Text="{Binding XemTruocGiaHan.TomTat}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" Visibility="{Binding CoXemTruocGiaHan, Converter={StaticResource BoolToVis}}" />
                    <HeaderedContentControl Header="Lý do (không bắt buộc)" Margin="0,10,0,0"><TextBox Text="{Binding LyDoGiaHan, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" /></HeaderedContentControl>
                    <Button Content="Gia hạn" Command="{Binding GiaHanCommand}" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                            IsEnabled="{Binding DangDoiPhong, Converter={StaticResource InverseBooleanConverter}}" />

                </StackPanel>
              </ScrollViewer>
            </Border>
        </Grid>

        <ctl:NoticeBar Grid.Row="2" Text="{Binding ThongBao}" IsError="{Binding ThongBaoLaLoi}" Margin="0,12,0,0" />
    </Grid>
</UserControl>
