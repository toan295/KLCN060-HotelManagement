<UserControl x:Class="KLCN060.Desktop.Views.D4NhanPhongView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Background="#F5F6F0" Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Nhận phòng" FontSize="26" FontWeight="Bold" Foreground="#123328"/><Grid Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Nhận theo phiếu đặt" FontSize="18" FontWeight="SemiBold"/><TextBox Text="{Binding TuKhoa}"/><Button Content="Tìm phiếu đặt" Command="{Binding TimPhieuDatCommand}"/><DataGrid ItemsSource="{Binding DanhSachPhieuDat}" SelectedItem="{Binding PhieuDatDaChon}" AutoGenerateColumns="False" Height="220"><DataGrid.Columns><DataGridTextColumn Header="Mã phiếu" Binding="{Binding MaPhieuDat}" Width="*"/><DataGridTextColumn Header="Khách" Binding="{Binding HoTenKhach}" Width="*"/></DataGrid.Columns></DataGrid><TextBox Text="{Binding Cccd}"/><Button Content="Xác nhận nhận phòng" Command="{Binding NhanTheoPhieuCommand}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Khách vãng lai" FontSize="18" FontWeight="SemiBold"/><TextBox Text="{Binding TuKhoaKhach}"/><Button Content="Tìm khách" Command="{Binding TimKhachCommand}"/><ComboBox ItemsSource="{Binding DanhSachKhach}" DisplayMemberPath="HoTen" SelectedItem="{Binding KhachDaChon}" Height="34"/><ComboBox ItemsSource="{Binding PhongTrong}" DisplayMemberPath="TenPhong" SelectedItem="{Binding PhongVangLaiDaChon}" Height="34"/><Button Content="Nhận khách vãng lai" Command="{Binding NhanVangLaiCommand}"/><TextBlock Text="{Binding ThongBao}" Foreground="#C8452F" TextWrapping="Wrap"/></StackPanel></Grid></Grid></UserControl>
