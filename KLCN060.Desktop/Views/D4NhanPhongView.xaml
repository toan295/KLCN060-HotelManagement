<UserControl x:Class="KLCN060.Desktop.Views.D4NhanPhongView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:KLCN060.Desktop.Controls">
    <UserControl.Resources>
        <!-- Nút chọn chế độ nhận phòng: chế độ đang chọn (Tag == CheDo) đổi sang nền xanh đậm -->
        <Style x:Key="NutCheDoStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="18,6" />
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EqualsMultiConverter}">
                            <Binding Path="DataContext.CheDo" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource MauChinh}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TextCotXuongDong" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,2" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ctl:PageHeader Title="Nhận phòng" Subtitle="Chọn cách nhận: khách có phiếu đặt (kiểm tra khách, ngày, cọc, từng phòng rồi xác nhận) hoặc khách vãng lai không đặt trước." />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="1. Khách có phiếu đặt" Tag="PHIEU" Command="{Binding ChonCheDoCommand}" CommandParameter="PHIEU" Style="{StaticResource NutCheDoStyle}" />
            <Button Content="2. Khách vãng lai (không đặt trước)" Tag="VANG_LAI" Command="{Binding ChonCheDoCommand}" CommandParameter="VANG_LAI" Style="{StaticResource NutCheDoStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
        <Grid>
            <!-- ===================== Nhận theo phiếu đặt ===================== -->
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding LaCheDoPhieu, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <HeaderedContentControl Header="Tìm phiếu đặt phòng (mã phiếu, tên khách hoặc số điện thoại)">
                            <TextBox x:Name="TimPhieuBox" Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}" ToolTip="Gõ mã phiếu đặt (VD DP...), tên khách hoặc số điện thoại rồi nhấn Enter. Để trống rồi tìm để xem mọi phiếu đang chờ nhận phòng.">
                                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding TimPhieuDatCommand}" /></TextBox.InputBindings>
                            </TextBox>
                        </HeaderedContentControl>
                        <Button Grid.Column="2" Content="Tìm phiếu" Command="{Binding TimPhieuDatCommand}" Margin="0" MinWidth="110" VerticalAlignment="Bottom" />
                    </Grid>
                    <CheckBox Content="Chỉ phiếu đã xác nhận cọc (bỏ tick để tra cả phiếu chờ cọc / đã hủy)" IsChecked="{Binding ChiPhieuDaXacNhan}" Margin="0,0,0,8" />

                    <DataGrid ItemsSource="{Binding DanhSachPhieuDat}" SelectedItem="{Binding PhieuDatDaChon}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MaxHeight="170" MinHeight="64">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã phiếu" Binding="{Binding MaPhieuDat}" Width="130" />
                            <DataGridTextColumn Header="Khách hàng" Binding="{Binding HoTenKhach}" Width="*" MinWidth="140" />
                            <DataGridTextColumn Header="Ngày ở" Binding="{Binding NgayOHienThi}" Width="200" />
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThaiHienThi}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Chọn một phiếu trong danh sách để xem chi tiết và nhận phòng." Style="{StaticResource HintTextStyle}" Margin="0,6,0,0"
                               Visibility="{Binding ChuaChonPhieu, Converter={StaticResource BoolToVis}}" />

                    <!-- Thông tin để quyết định -->
                    <StackPanel Visibility="{Binding CoThongTin, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                        <Border Style="{StaticResource InsetStyle}" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="Đang nhận: khách nào - phiếu nào - ở bao lâu - tiền cọc/thanh toán" Style="{StaticResource HintTextStyle}" />
                                <TextBlock Text="{Binding ThongTin.KhachHienThi}" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ThongTin.MaPhieuDat, StringFormat='Phiếu {0}'}" Style="{StaticResource HintTextStyle}" />
                                <TextBlock Text="{Binding ThongTin.NgayHienThi}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ThongTin.TienHienThi}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ThongTin.GiayToHienThi}" Style="{StaticResource HintTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding ThongTin.CanhBao}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding StringFormat='⚠ {0}'}" Foreground="{StaticResource MauNguyHiem}" TextWrapping="Wrap" Margin="0,2,0,0" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ThongTin.LyDoKhongNhanDuoc, StringFormat='Chưa nhận được: {0}'}" Foreground="{StaticResource MauNguyHiem}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers><DataTrigger Binding="{Binding ThongTin.NhanDuoc}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Phòng nhận lần này (bỏ tick nếu khách chưa tới - đoàn đến rải rác)" Style="{StaticResource HintTextStyle}" Margin="0,12,0,6" />
                        <DataGrid ItemsSource="{Binding PhongCuaPhieuDat}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Nhận" Binding="{Binding DaChon, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                <DataGridTextColumn Header="Phòng" Binding="{Binding MaPhong}" IsReadOnly="True" Width="80" />
                                <DataGridTemplateColumn Header="Loại phòng" IsReadOnly="True" Width="*" MinWidth="130">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TenLoai}" Style="{StaticResource TextCotXuongDong}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Tình trạng" IsReadOnly="True" Width="150">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TinhTrangHienThi}" Style="{StaticResource TextCotXuongDong}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Giá/đêm" Binding="{Binding DonGiaHienThi}" IsReadOnly="True" Width="110" />
                                <DataGridTemplateColumn Header="Sức chứa" IsReadOnly="True" Width="130">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SucChuaHienThi}" Style="{StaticResource TextCotXuongDong}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Số người" Binding="{Binding SoNguoi, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                <DataGridTemplateColumn Header="Có nhận được không" IsReadOnly="True" Width="2*" MinWidth="170">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TrangThaiNhan}" Style="{StaticResource TextCotXuongDong}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Visibility="{Binding CanNhapCccd, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                            <HeaderedContentControl Header="Số CCCD / hộ chiếu của khách (hồ sơ chưa có - bắt buộc)">
                                <TextBox Text="{Binding CccdKhachPhieu, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" />
                            </HeaderedContentControl>
                        </StackPanel>
                        <StackPanel Visibility="{Binding LaNhanSom, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                            <HeaderedContentControl Header="Lý do nhận sớm (bắt buộc - phòng phải trống từ hôm nay, ngày đón dời về hôm nay, có ghi nhật ký)">
                                <TextBox Text="{Binding LyDoNhanSom, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" />
                            </HeaderedContentControl>
                        </StackPanel>
                        <Button Content="Xác nhận nhận phòng" Command="{Binding NhanTheoPhieuCommand}" IsEnabled="{Binding DangNhanPhong, Converter={StaticResource InverseBooleanConverter}}"
                                HorizontalAlignment="Right" Margin="0,14,0,0" MinWidth="210" />
                        <TextBlock Text="Đang nhận phòng..." Style="{StaticResource HintTextStyle}" HorizontalAlignment="Right" Margin="0,4,0,0"
                                   Visibility="{Binding DangNhanPhong, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== Khách vãng lai ===================== -->
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding LaCheDoVangLai, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Cột trái: chọn khách -->
                    <StackPanel>
                        <TextBlock Text="Bước 1 - Chọn khách" Style="{StaticResource CardTitleStyle}" />
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <HeaderedContentControl Header="Tìm khách đã có hồ sơ (họ tên, số điện thoại hoặc CCCD / hộ chiếu)">
                                <TextBox Text="{Binding TuKhoaKhach, UpdateSourceTrigger=PropertyChanged}" ToolTip="Gõ họ tên, số điện thoại hoặc số giấy tờ của khách rồi nhấn Enter">
                                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding TimKhachCommand}" /></TextBox.InputBindings>
                                </TextBox>
                            </HeaderedContentControl>
                            <Button Grid.Column="2" Content="Tìm khách" Command="{Binding TimKhachCommand}" Margin="0" MinWidth="110" VerticalAlignment="Bottom" />
                        </Grid>
                        <TextBlock Text="{Binding TrangThaiTimKhach}" Foreground="{StaticResource MauNguyHiem}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <HeaderedContentControl Header="Khách được chọn (kết quả tìm kiếm)">
                            <ComboBox ItemsSource="{Binding DanhSachKhach}" DisplayMemberPath="HoTen" SelectedItem="{Binding KhachDaChon}" />
                        </HeaderedContentControl>
                        <TextBlock Text="{Binding KhachVangLaiGhiChu}" Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <Expander Header="Khách chưa có hồ sơ? Tạo mới" Margin="0,12,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <HeaderedContentControl Header="Họ tên *"><TextBox Text="{Binding HoTenMoi, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" /></HeaderedContentControl>
                                <HeaderedContentControl Header="Số điện thoại *" Margin="0,8,0,0"><TextBox Text="{Binding SdtMoi, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" /></HeaderedContentControl>
                                <HeaderedContentControl Header="CCCD / hộ chiếu (không bắt buộc ở bước này)" Margin="0,8,0,0"><TextBox Text="{Binding CccdMoi, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" /></HeaderedContentControl>
                                <Button Content="Kiểm tra trùng và tạo khách" Command="{Binding TaoKhachMoiCommand}" HorizontalAlignment="Right" Margin="0,10,0,0" MinWidth="200" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- Cột phải: phòng + thời gian ở -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Bước 2 - Chọn phòng và thời gian ở" Style="{StaticResource CardTitleStyle}" />
                        <HeaderedContentControl Header="Phòng bán được ngay (đã dọn/kiểm tra, chưa giữ cho khách đến)" Margin="0,10,0,0">
                            <ComboBox ItemsSource="{Binding PhongTrong}" DisplayMemberPath="NhanChonPhong" SelectedItem="{Binding PhongVangLaiDaChon}" />
                        </HeaderedContentControl>
                        <StackPanel Visibility="{Binding KhachVangLaiThieuCccd, Converter={StaticResource BoolToVis}}">
                            <HeaderedContentControl Header="CCCD / hộ chiếu khách lưu trú (hồ sơ chưa có - bắt buộc)" Margin="0,12,0,0">
                                <TextBox Text="{Binding CccdVangLai, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" />
                            </HeaderedContentControl>
                        </StackPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <HeaderedContentControl Header="Số người (0 = theo sức chứa tiêu chuẩn)">
                                <TextBox Text="{Binding SoNguoiVangLai, UpdateSourceTrigger=PropertyChanged}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Grid.Column="2" Header="Số đêm ở (bắt buộc, từ 1)">
                                <TextBox Text="{Binding SoDemVangLai, UpdateSourceTrigger=PropertyChanged}" ToolTip="Khách lưu trú phải có ngày trả phòng cụ thể: nhập số đêm khách sẽ ở" />
                            </HeaderedContentControl>
                        </Grid>
                        <Border Style="{StaticResource InsetStyle}" Padding="14,10" Margin="0,12,0,0">
                            <TextBlock Text="{Binding TraPhongDuKienHienThi}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                        <Button Content="Nhận khách vãng lai" Command="{Binding NhanVangLaiCommand}" IsEnabled="{Binding DangNhanPhong, Converter={StaticResource InverseBooleanConverter}}"
                                HorizontalAlignment="Right" MinWidth="210" Margin="0,16,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>

        <!-- Kết quả lần nhận gần nhất -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Visibility="{Binding CoKetQua, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding KetQuaNhan}" TextWrapping="Wrap" />
        </Border>
        <ctl:NoticeBar Grid.Row="4" Text="{Binding ThongBao}" IsError="{Binding ThongBaoLaLoi}" Margin="0,12,0,0" />
    </Grid>
</UserControl>
