<UserControl x:Class="KLCN060.Desktop.Views.D4NhanPhongView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F5F6F0" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Nhận phòng" FontSize="26" FontWeight="Bold" Foreground="#123328" />
            <TextBlock Text="Nhận khách theo phiếu đặt trước hoặc tiếp nhận khách vãng lai." Margin="0,5,0,0" Foreground="#647A6C" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" BorderBrush="#D7DDCE" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.08" /></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Nhận theo phiếu đặt" FontSize="18" FontWeight="SemiBold" Foreground="#123328" />
                    <Grid Grid.Row="1" Margin="0,14,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="118" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" />
                        <Button Grid.Column="1" Content="Tìm phiếu" Command="{Binding TimPhieuDatCommand}" Margin="0" />
                    </Grid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding DanhSachPhieuDat}" SelectedItem="{Binding PhieuDatDaChon}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã phiếu" Binding="{Binding MaPhieuDat}" Width="*" />
                            <DataGridTextColumn Header="Khách hàng" Binding="{Binding HoTenKhach}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="3" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="175" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="CCCD khách lưu trú" Foreground="#3C4C40" /><TextBox Text="{Binding Cccd, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <Button Grid.Column="1" Content="Xác nhận nhận phòng" Command="{Binding NhanTheoPhieuCommand}" VerticalAlignment="Bottom" Margin="12,0,0,0" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20" BorderBrush="#D7DDCE" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.08" /></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Khách vãng lai" FontSize="18" FontWeight="SemiBold" Foreground="#123328" />
                    <Grid Grid.Row="1" Margin="0,14,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="118" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding TuKhoaKhach, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" />
                        <Button Grid.Column="1" Content="Tìm khách" Command="{Binding TimKhachCommand}" Margin="0" />
                    </Grid>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Khách hàng" Foreground="#3C4C40" />
                        <ComboBox ItemsSource="{Binding DanhSachKhach}" DisplayMemberPath="HoTen" SelectedItem="{Binding KhachDaChon}" Height="34" Margin="0,5,0,14" />
                        <TextBlock Text="Phòng trống" Foreground="#3C4C40" />
                        <ComboBox ItemsSource="{Binding PhongTrong}" DisplayMemberPath="TenPhong" SelectedItem="{Binding PhongVangLaiDaChon}" Height="34" Margin="0,5,0,0" />
                    </StackPanel>
                    <Button Grid.Row="3" Content="Nhận khách vãng lai" Command="{Binding NhanVangLaiCommand}" HorizontalAlignment="Center" VerticalAlignment="Bottom" MinWidth="190" Margin="0" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="16" BorderBrush="#D7DDCE" BorderThickness="1">
            <TextBlock Text="{Binding ThongBao}" Foreground="#C8452F" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" MinHeight="22" />
        </Border>
    </Grid>
</UserControl>
