<UserControl x:Class="KLCN060.Desktop.Views.D9QuanLyKhachHangView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F5F6F0">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Quản lý khách hàng" FontSize="26" FontWeight="Bold" Foreground="#123328" />
                <TextBlock Text="Tìm kiếm, cập nhật thông tin và xem lịch sử lưu trú của khách hàng." Margin="0,5,0,0" Foreground="#647A6C" />
            </StackPanel>

            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16" Margin="0,18,0,0" BorderBrush="#D7DDCE" BorderThickness="1">
                <DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="320" Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Tìm kiếm" Command="{Binding TimKiemCommand}" />
                        <Button Content="Làm mới" Command="{Binding LamMoiCommand}" Background="White" Foreground="#1F4D3D" BorderBrush="#1F4D3D" />
                    </StackPanel>
                    <TextBlock Text="Tìm theo họ tên, số điện thoại hoặc CCCD" Foreground="#647A6C" VerticalAlignment="Center" DockPanel.Dock="Right" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>

                <Border Background="White" CornerRadius="10" Padding="18" BorderBrush="#D7DDCE" BorderThickness="1">
                    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.08" /></Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Danh sách khách hàng" FontSize="18" FontWeight="SemiBold" Foreground="#123328" />
                        <DataGrid Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding DanhSachKhachHang}" SelectedItem="{Binding KhachHangDaChon}" AutoGenerateColumns="False" HeadersVisibility="Column" FontSize="11.5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã" Binding="{Binding MaKhach}" Width="65" />
                                <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="*" />
                                <DataGridTextColumn Header="Số điện thoại" Binding="{Binding SoDT}" Width="105" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="18" BorderBrush="#D7DDCE" BorderThickness="1">
                    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.08" /></Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Thông tin khách hàng" FontSize="18" FontWeight="SemiBold" Foreground="#123328" />
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Mã khách" Foreground="#3C4C40" />
                                <TextBox Text="{Binding MaKhach}" IsReadOnly="True" Background="#F5F6F0" />
                                <TextBlock Text="Họ tên" Foreground="#3C4C40" />
                                <TextBox Text="{Binding HoTen, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Số điện thoại" Foreground="#3C4C40" />
                                <TextBox Text="{Binding SoDT, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CCCD" Foreground="#3C4C40" />
                                <TextBox Text="{Binding Cccd, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Email" Foreground="#3C4C40" />
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Địa chỉ" Foreground="#3C4C40" />
                                <TextBox Text="{Binding DiaChi, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,10">
                            <Button Content="Lưu" Command="{Binding LuuCommand}" />
                            <TextBlock Text="{Binding ThongBao}" Foreground="#C8452F" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="Lịch sử lưu trú" FontSize="16" FontWeight="SemiBold" Foreground="#123328" />
                            <DataGrid Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding LichSuLuuTru}" AutoGenerateColumns="False" HeadersVisibility="Column" FontSize="11.5">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã phiếu" Binding="{Binding MaPhieuDat}" Width="*" />
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="100" />
                                    <DataGridTextColumn Header="Ngày nhận" Binding="{Binding NgayDonDuKien, StringFormat=dd/MM/yyyy}" Width="90" />
                                    <DataGridTextColumn Header="Ngày trả" Binding="{Binding NgayTraDuKien, StringFormat=dd/MM/yyyy}" Width="90" />
                                    <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TongTien, Converter={StaticResource VndMoneyConverter}}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
