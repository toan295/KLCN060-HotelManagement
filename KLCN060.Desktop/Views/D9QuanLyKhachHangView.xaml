<UserControl x:Class="KLCN060.Desktop.Views.D9QuanLyKhachHangView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:KLCN060.Desktop.Controls">
    <UserControl.Resources>
        <Style x:Key="LoiOStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MauNguyHiem}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DongPhuStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource MauChuPhu}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ctl:PageHeader Title="Hồ sơ khách hàng" ManagerTitle="Quản lý khách hàng" Subtitle="Tìm khách (có dấu hoặc không dấu, theo tên, mã, SĐT, CCCD, email) → xem tình trạng lưu trú, booking sắp tới, công nợ → xử lý ngay (đặt phòng, nhận phòng, trả phòng, thu tiền) mà không phải mở nhiều màn." />

        <!-- Tìm kiếm / lọc -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,12" Padding="16,10">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" /><ColumnDefinition Width="10" />
                    <ColumnDefinition Width="170" /><ColumnDefinition Width="10" />
                    <ColumnDefinition Width="140" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <HeaderedContentControl Header="Tìm kiếm">
                    <TextBox Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}" />
                </HeaderedContentControl>
                <HeaderedContentControl Grid.Column="2" Header="Nhóm khách">
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Loc}">
                        <ComboBoxItem Tag="" Content="Tất cả khách" IsSelected="True" />
                        <ComboBoxItem Tag="dang_o" Content="Đang lưu trú" />
                        <ComboBoxItem Tag="con_no" Content="Còn công nợ" />
                        <ComboBoxItem Tag="doanh_nghiep" Content="Đoàn" />
                        <ComboBoxItem Tag="co_tai_khoan" Content="Có tài khoản web" />
                    </ComboBox>
                </HeaderedContentControl>
                <HeaderedContentControl Grid.Column="4" Header="Sắp xếp">
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SapXep}">
                        <ComboBoxItem Tag="" Content="Theo mã" IsSelected="True" />
                        <ComboBoxItem Tag="ten" Content="Theo tên" />
                        <ComboBoxItem Tag="moi" Content="Mới tạo trước" />
                    </ComboBox>
                </HeaderedContentControl>
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Tìm kiếm" Command="{Binding TimKiemCommand}" IsDefault="True" Margin="0" MinWidth="96" />
                    <Button Content="Xóa lọc" Command="{Binding XoaBoLocCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="8,0,0,0" />
                    <Button Content="Làm mới" Command="{Binding LamMoiCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Ô Tìm kiếm: gõ tên, mã khách, số điện thoại, CCCD hoặc email (có dấu hoặc không dấu). Gõ nhiều từ thì mỗi từ phải khớp, ví dụ &quot;nguyen an&quot; tìm được Nguyễn Văn An." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*" MinWidth="360" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.45*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <!-- Danh sách -->
            <Border Style="{StaticResource CardStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TieuDeDanhSach}" FontWeight="SemiBold" Foreground="{StaticResource MauChinh}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="＋ Thêm khách mới" Command="{Binding ThemMoiCommand}" Margin="8,0,0,0" Padding="12,5" MinHeight="32"
                                Visibility="{Binding CoTheTao, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DanhSachKhachHang}" SelectedItem="{Binding KhachHangDaChon}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" CanUserSortColumns="False" RowHeight="NaN">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Khách hàng" Width="*" MinWidth="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock Text="{Binding HoTen}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MaVaLoai}" FontSize="11.5" Foreground="{StaticResource MauChuPhu}" />
                                            <TextBlock Text="{Binding LienHe}" FontSize="11.5" Foreground="{StaticResource MauChuNhat}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Lưu trú" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock Text="{Binding LuuTruHienThi}" TextWrapping="Wrap" FontSize="12" />
                                            <TextBlock Text="{Binding TrangThaiHienThi}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MauThanhCong}" />
                                            <TextBlock Text="{Binding NoHienThi}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MauCanhBao}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300" Style="{StaticResource HintTextStyle}"
                               Visibility="{Binding TrongDanhSach, Converter={StaticResource BoolToVis}}"
                               Text="Không có khách nào khớp. Thử bớt từ khóa, bỏ bộ lọc, hoặc bấm &quot;Thêm khách mới&quot; nếu đây là khách mới." />
                </Grid>
            </Border>

            <!-- Hồ sơ -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Style="{StaticResource HintTextStyle}"
                               Visibility="{Binding KhongCoForm, Converter={StaticResource BoolToVis}}"
                               Text="Chọn một khách ở danh sách bên trái để xem hồ sơ và lịch sử lưu trú, hoặc bấm &quot;Thêm khách mới&quot;." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CoForm, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding TieuDeForm}" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="{Binding LoaiKhachHienThi}" Style="{StaticResource HintTextStyle}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="● Có thay đổi chưa lưu" Foreground="{StaticResource MauCanhBao}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                                               Visibility="{Binding CoThayDoi, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Hoàn tác" Command="{Binding HuyThayDoiCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,8,0" Visibility="{Binding CoThayDoi, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Lưu thông tin" Command="{Binding LuuCommand}" Margin="0" MinHeight="34" Padding="16,6" />
                                </StackPanel>
                            </Grid>

                            <Border Background="{StaticResource MauThongTinNhat}" CornerRadius="6" Padding="10,6" Margin="0,8,0,0" Visibility="{Binding KhongSua, Converter={StaticResource BoolToVis}}">
                                <TextBlock TextWrapping="Wrap" Text="Chế độ xem: tài khoản của bạn không có quyền sửa hồ sơ khách hàng." />
                            </Border>
                            <TextBlock Text="{Binding TomTatKhach}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource MauChinh}" Margin="0,8,0,0" />

                            <!-- Tình trạng hiện tại của khách và việc có thể làm ngay -->
                            <Border Style="{StaticResource InsetStyle}" Padding="12,10" Margin="0,10,0,0" Visibility="{Binding CoViecNgay, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Tình trạng hiện tại và việc có thể làm ngay" FontWeight="Bold" />
                                    <TextBlock Text="{Binding TinhTrangHienTai}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <ItemsControl ItemsSource="{Binding ViecNgay}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,0,3">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding MoTa}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    <Button Grid.Column="1" Content="{Binding Nhan}" Command="{Binding DataContext.MoViecCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            Margin="10,0,0,0" Padding="12,4" MinHeight="30" Style="{StaticResource OutlineButtonStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Cảnh báo khách trùng -->
                            <Border Background="{StaticResource MauCanhBaoNhat}" CornerRadius="6" Padding="10,7" Margin="0,8,0,0" Visibility="{Binding CoNghiTrung, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Có thể trùng với khách khác trong hệ thống:" FontWeight="SemiBold" Foreground="{StaticResource MauCanhBao}" />
                                    <ItemsControl ItemsSource="{Binding NghiTrung}">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding HienThi}" TextWrapping="Wrap" Margin="0,2,0,0" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <HeaderedContentControl Header="Mã khách"><TextBox Text="{Binding MaKhach}" IsReadOnly="True" Background="{StaticResource MauNen}" ToolTip="Mã do hệ thống cấp, không sửa" /></HeaderedContentControl>
                                <StackPanel Grid.Column="2">
                                    <HeaderedContentControl Header="CCCD / giấy tờ"><TextBox Text="{Binding Cccd, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" /></HeaderedContentControl>
                                    <TextBlock Text="{Binding LoiCccd}" Style="{StaticResource LoiOStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                    <HeaderedContentControl Header="Họ tên *"><TextBox Text="{Binding HoTen, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" /></HeaderedContentControl>
                                    <TextBlock Text="{Binding LoiHoTen}" Style="{StaticResource LoiOStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                                    <HeaderedContentControl Header="Email"><TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" /></HeaderedContentControl>
                                    <TextBlock Text="{Binding LoiEmail}" Style="{StaticResource LoiOStyle}" />
                                    <TextBlock Text="{Binding TrangThaiEmail}" Style="{StaticResource HintTextStyle}" FontSize="11.5" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                    <HeaderedContentControl Header="Số điện thoại *"><TextBox Text="{Binding SoDT, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" /></HeaderedContentControl>
                                    <TextBlock Text="{Binding LoiSoDT}" Style="{StaticResource LoiOStyle}" />
                                </StackPanel>
                                <HeaderedContentControl Grid.Row="2" Grid.Column="2" Header="Địa chỉ" Margin="0,10,0,0"><TextBox Text="{Binding DiaChi, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" /></HeaderedContentControl>
                            </Grid>

                            <TextBlock Text="Lịch sử lưu trú" Style="{StaticResource SubTitleStyle}" FontSize="14" Margin="0,16,0,0" Visibility="{Binding KhongThemMoi, Converter={StaticResource BoolToVis}}" />
                            <DataGrid Margin="0,8,0,0" Visibility="{Binding KhongThemMoi, Converter={StaticResource BoolToVis}}" ItemsSource="{Binding LichSuLuuTru}" AutoGenerateColumns="False" IsReadOnly="True" FontSize="12" MaxHeight="300" RowHeight="NaN" CanUserSortColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Booking / phòng" Width="*" MinWidth="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,3">
                                                    <TextBlock Text="{Binding MaHienThi}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock FontSize="11" Foreground="{StaticResource MauChuPhu}"><Run Text="Phòng " /><Run Text="{Binding DanhSachPhong, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding NguonHienThi, Mode=OneWay}" /></TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Thời gian" Width="170">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,3">
                                                    <TextBlock Text="{Binding NgayDuKienHienThi}" />
                                                    <TextBlock Text="{Binding ThucTeHienThi}" FontSize="11" Foreground="{StaticResource MauChuPhu}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Trạng thái / tiền" Width="210">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,3">
                                                    <TextBlock Text="{Binding TrangThaiHienThi}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding TienHienThi}" FontSize="11" Foreground="{StaticResource MauChuPhu}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Visibility="{Binding CoLichSuHoSo, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Lịch sử sửa hồ sơ" Style="{StaticResource SubTitleStyle}" FontSize="14" Margin="0,16,0,4" />
                                <ItemsControl ItemsSource="{Binding LichSuHoSo}">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding HienThi}" Style="{StaticResource DongPhuStyle}" FontSize="12" /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <ctl:NoticeBar Grid.Row="3" Text="{Binding ThongBao}" IsError="{Binding ThongBaoLaLoi}" Margin="0,10,0,0" />
    </Grid>
</UserControl>
