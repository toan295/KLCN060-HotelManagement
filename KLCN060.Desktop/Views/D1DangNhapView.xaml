<UserControl x:Class="KLCN060.Desktop.Views.D1DangNhapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="#F5F6F0">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="390">
            <Border Background="White" Padding="36" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.12" />
                </Border.Effect>
                <Grid>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DaDangNhap}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="44" Height="44" CornerRadius="10" Background="#1F4D3D" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="K" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="KLCN060 HOTEL" FontSize="25" FontWeight="Bold" Foreground="#1F4D3D" HorizontalAlignment="Center" />
                        <TextBlock Text="Đăng nhập hệ thống" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,28" HorizontalAlignment="Center" />
                        <TextBlock Text="Tên đăng nhập" FontWeight="SemiBold" />
                        <TextBox Text="{Binding TenDangNhap, UpdateSourceTrigger=PropertyChanged}" Height="38" Margin="0,7,0,18" Padding="10,7" />
                        <TextBlock Text="Mật khẩu" FontWeight="SemiBold" />
                        <PasswordBox x:Name="PasswordInput" Height="38" Margin="0,7,0,16" Padding="10,7" />
                        <TextBlock Text="{Binding ThongBao}" TextWrapping="Wrap" Margin="0,0,0,16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#C8452F" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LaTaiKhoanBiKhoa}" Value="True">
                                            <Setter Property="Foreground" Value="#C98420" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Height="42" Click="LoginButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="Đăng nhập" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Background" Value="#1F4D3D" />
                                    <Setter Property="BorderBrush" Value="#1F4D3D" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DangDangNhap}" Value="True">
                                            <Setter Property="Content" Value="Đang đăng nhập..." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DaDangNhap}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Đăng nhập thành công" FontSize="24" FontWeight="Bold" Foreground="#2E9E6B" HorizontalAlignment="Center" />
                        <TextBlock Text="Bạn đã sẵn sàng sử dụng hệ thống quản lý khách sạn." Margin="0,12,0,0" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
