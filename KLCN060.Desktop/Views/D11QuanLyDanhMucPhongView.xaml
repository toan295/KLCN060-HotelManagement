<UserControl x:Class="KLCN060.Desktop.Views.D11QuanLyDanhMucPhongView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F5F6F0" Margin="0">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Quản lý danh mục phòng" FontSize="26" FontWeight="Bold" Foreground="#123328" />
                <TextBlock Text="Thêm mới hoặc cập nhật loại phòng và phòng khách sạn." Margin="0,5,0,0" Foreground="#647A6C" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="#C8452F" Margin="0,14,0,0" TextWrapping="Wrap" />
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="18" BorderBrush="#D7DDCE" BorderThickness="1">
                    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.08" /></Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Loại phòng" FontSize="18" FontWeight="SemiBold" Foreground="#123328" />
                        <WrapPanel Grid.Row="1" Margin="0,12,0,14">
                            <StackPanel><TextBlock Text="Tên loại" Foreground="#3C4C40" /><TextBox Width="120" Text="{Binding TypeName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel><TextBlock Text="Sức chứa" Foreground="#3C4C40" /><TextBox Width="70" Text="{Binding Capacity}" /></StackPanel>
                            <StackPanel><TextBlock Text="Đơn giá" Foreground="#3C4C40" /><TextBox Width="100" Text="{Binding Price}" /></StackPanel>
                            <StackPanel><TextBlock Text="Phụ thu" Foreground="#3C4C40" /><TextBox Width="100" Text="{Binding Surcharge}" /></StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Lưu" Command="{Binding SaveRoomTypeCommand}" /><Button Content="Làm mới" Command="{Binding ClearTypeCommand}" Background="White" Foreground="#1F4D3D" BorderBrush="#1F4D3D" /></StackPanel>
                        </WrapPanel>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding RoomTypes}" SelectedItem="{Binding SelectedRoomType}" AutoGenerateColumns="False" HeadersVisibility="Column" FontSize="11.5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã" Binding="{Binding MaLoai}" Width="42" />
                                <DataGridTextColumn Header="Tên loại phòng" Binding="{Binding TenLoai}" Width="*" MinWidth="80" />
                                <DataGridTextColumn Header="Sức chứa" Binding="{Binding SoNguoiTieuChuan}" Width="62" />
                                <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia, Converter={StaticResource VndMoneyConverter}}" Width="85" />
                                <DataGridTextColumn Header="Phụ thu" Binding="{Binding PhuThu, Converter={StaticResource VndMoneyConverter}}" Width="85" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="18" BorderBrush="#D7DDCE" BorderThickness="1">
                    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.08" /></Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Phòng" FontSize="18" FontWeight="SemiBold" Foreground="#123328" />
                        <WrapPanel Grid.Row="1" Margin="0,12,0,14">
                            <StackPanel><TextBlock Text="Tên phòng" Foreground="#3C4C40" /><TextBox Width="90" Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel><TextBlock Text="Tầng" Foreground="#3C4C40" /><TextBox Width="60" Text="{Binding Floor}" /></StackPanel>
                            <StackPanel>
                                <TextBlock Text="Loại phòng" Foreground="#3C4C40" />
                                <ComboBox Width="120" Height="34" Margin="0,5,10,0" ItemsSource="{Binding RoomTypes}" DisplayMemberPath="TenLoai" SelectedValuePath="MaLoai" SelectedValue="{Binding RoomTypeCode}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Tình trạng" Foreground="#3C4C40" />
                                <ComboBox Width="90" Height="34" Margin="0,5,10,0" SelectedValuePath="Content" SelectedValue="{Binding RoomStatus}">
                                    <ComboBoxItem Content="VC" />
                                    <ComboBoxItem Content="VD" />
                                    <ComboBoxItem Content="VI" />
                                    <ComboBoxItem Content="OC" />
                                    <ComboBoxItem Content="OD" />
                                    <ComboBoxItem Content="OOO" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Lưu" Command="{Binding SaveRoomCommand}" /><Button Content="Làm mới" Command="{Binding ClearRoomCommand}" Background="White" Foreground="#1F4D3D" BorderBrush="#1F4D3D" /></StackPanel>
                        </WrapPanel>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" AutoGenerateColumns="False" HeadersVisibility="Column" FontSize="11.5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã" Binding="{Binding MaPhong}" Width="42" />
                                <DataGridTextColumn Header="Phòng" Binding="{Binding TenPhong}" Width="*" MinWidth="55" />
                                <DataGridTextColumn Header="Tầng" Binding="{Binding Tang}" Width="42" />
                                <DataGridTextColumn Header="Loại phòng" Binding="{Binding TenLoaiPhong}" Width="*" MinWidth="70" />
                                <DataGridTemplateColumn Header="Tình trạng" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#8B8F8C" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TinhTrang}" Value="VC"><Setter Property="Background" Value="#4CAF7D" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding TinhTrang}" Value="VI"><Setter Property="Background" Value="#4FA3D1" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding TinhTrang}" Value="VD"><Setter Property="Background" Value="#E08A3C" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding TinhTrang}" Value="OC"><Setter Property="Background" Value="#1F6B4A" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding TinhTrang}" Value="OD"><Setter Property="Background" Value="#C8452F" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding TinhTrang}" Value="OOO"><Setter Property="Background" Value="#8B8F8C" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding TinhTrang}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TinhTrang}" Value="VI"><Setter Property="Foreground" Value="#16241D" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
