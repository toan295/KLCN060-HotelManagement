<UserControl x:Class="KLCN060.Desktop.Views.D11RoomCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F4F7FB" Margin="0">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock Text="Quản lý danh mục phòng" FontSize="26" FontWeight="Bold" Foreground="#1E3A5F" />
                    <TextBlock Text="Thêm mới hoặc cập nhật loại phòng và phòng khách sạn." Margin="0,5,0,0" Foreground="#64748B" />
                </StackPanel>
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Phòng" IsEnabled="False" Opacity="0.65" />
                    <Button Content="Khuyến mãi" Command="{Binding DataContext.HienThiKhuyenMaiCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="White" Foreground="#1F4E79" BorderBrush="#1F4E79" />
                    <Button Content="Dịch vụ" Command="{Binding DataContext.HienThiDichVuCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="White" Foreground="#1F4E79" BorderBrush="#1F4E79" />
                    <Button Content="Cơ sở vật chất" Command="{Binding DataContext.HienThiCoSoVatChatCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="White" Foreground="#1F4E79" BorderBrush="#1F4E79" />
                </WrapPanel>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="#B91C1C" Margin="0,14,0,0" TextWrapping="Wrap" />
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.08" /></Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Loại phòng" FontSize="18" FontWeight="SemiBold" Foreground="#1E3A5F" />
                        <WrapPanel Grid.Row="1" Margin="0,12,0,14">
                            <StackPanel><TextBlock Text="Tên loại" Foreground="#475569" /><TextBox Width="120" Text="{Binding TypeName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel><TextBlock Text="Sức chứa" Foreground="#475569" /><TextBox Width="70" Text="{Binding Capacity}" /></StackPanel>
                            <StackPanel><TextBlock Text="Đơn giá" Foreground="#475569" /><TextBox Width="100" Text="{Binding Price}" /></StackPanel>
                            <StackPanel><TextBlock Text="Phụ thu" Foreground="#475569" /><TextBox Width="100" Text="{Binding Surcharge}" /></StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Lưu" Command="{Binding SaveRoomTypeCommand}" /><Button Content="Làm mới" Command="{Binding ClearTypeCommand}" Background="White" Foreground="#1F4E79" BorderBrush="#1F4E79" /></StackPanel>
                        </WrapPanel>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding RoomTypes}" SelectedItem="{Binding SelectedRoomType}" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã" Binding="{Binding MaLoai}" Width="55" />
                                <DataGridTextColumn Header="Tên loại phòng" Binding="{Binding TenLoai}" Width="*" />
                                <DataGridTextColumn Header="Sức chứa" Binding="{Binding SoNguoiTieuChuan}" Width="85" />
                                <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia, StringFormat=N0}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.08" /></Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Phòng" FontSize="18" FontWeight="SemiBold" Foreground="#1E3A5F" />
                        <WrapPanel Grid.Row="1" Margin="0,12,0,14">
                            <StackPanel><TextBlock Text="Tên phòng" Foreground="#475569" /><TextBox Width="90" Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel><TextBlock Text="Tầng" Foreground="#475569" /><TextBox Width="60" Text="{Binding Floor}" /></StackPanel>
                            <StackPanel><TextBlock Text="Mã loại" Foreground="#475569" /><TextBox Width="70" Text="{Binding RoomTypeCode}" /></StackPanel>
                            <StackPanel><TextBlock Text="Tình trạng" Foreground="#475569" /><TextBox Width="75" Text="{Binding RoomStatus}" /></StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Lưu" Command="{Binding SaveRoomCommand}" /><Button Content="Làm mới" Command="{Binding ClearRoomCommand}" Background="White" Foreground="#1F4E79" BorderBrush="#1F4E79" /></StackPanel>
                        </WrapPanel>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã" Binding="{Binding MaPhong}" Width="55" />
                                <DataGridTextColumn Header="Phòng" Binding="{Binding TenPhong}" Width="*" />
                                <DataGridTextColumn Header="Tầng" Binding="{Binding Tang}" Width="55" />
                                <DataGridTextColumn Header="Loại phòng" Binding="{Binding TenLoaiPhong}" Width="*" />
                                <DataGridTextColumn Header="Tình trạng" Binding="{Binding TinhTrang}" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
