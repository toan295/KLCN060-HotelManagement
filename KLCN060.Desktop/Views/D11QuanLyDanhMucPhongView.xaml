<UserControl x:Class="KLCN060.Desktop.Views.D11QuanLyDanhMucPhongView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:KLCN060.Desktop.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="AnhPhongOTemplate">
            <Border Width="184" Margin="0,0,12,12" Padding="10" Background="{StaticResource MauNen}" CornerRadius="10" BorderBrush="{StaticResource MauVienNhat}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Nhan}" FontWeight="SemiBold" Foreground="{StaticResource MauChinhDam}" TextTrimming="CharacterEllipsis" />
                    <Border Height="92" Margin="0,7,0,7" Background="{StaticResource MauNenPhu}" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding XemTruoc}" Stretch="UniformToFill" />
                            <TextBlock Text="Chưa có ảnh" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MauChuNhat}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding XemTruoc}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding ChiTiet}" FontSize="11" Foreground="{StaticResource MauChuNhat}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ChiTiet}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Chọn ảnh" Command="{Binding ChonAnhCommand}" Style="{StaticResource SmallButtonStyle}" />
                        <Button Content="Xóa" Command="{Binding XoaAnhCommand}" Style="{StaticResource DangerOutlineButtonStyle}" Padding="12,4" MinHeight="30" FontSize="12" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="ChipLocStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="LyDoStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MauCanhBao}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,20,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ctl:PageHeader Title="Quản lý danh mục phòng" Subtitle="Phòng, loại phòng, giá, sức chứa, tiện nghi và ảnh hiển thị trên website. Tình trạng phòng chỉ đổi theo đúng quy trình; phòng đã có lịch sử không bị xóa." />
        <ctl:NoticeBar Grid.Row="1" Text="{Binding Message}" IsError="{Binding MessageLaLoi}" Margin="0,10,0,0" />

        <TabControl Grid.Row="2" Margin="0,10,0,0" SelectedIndex="{Binding TabDangChon}" BorderThickness="0" Background="Transparent">
            <!-- ================= TAB PHÒNG ================= -->
            <TabItem Header="Phòng">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="420" /><ColumnDefinition Width="14" /><ColumnDefinition Width="450" /></Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <StackPanel>
                                <WrapPanel Visibility="{Binding CoTongQuan, Converter={StaticResource BoolToVis}}">
                                    <Border Background="White" BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="8" Padding="12,0" MinHeight="34" Margin="0,0,8,6"><TextBlock VerticalAlignment="Center"><Run Text="{Binding TongQuan.TongPhong, Mode=OneWay}" FontWeight="Bold" /><Run Text=" phòng · " /><Run Text="{Binding TongQuan.SoTang, Mode=OneWay}" /><Run Text=" tầng · " /><Run Text="{Binding TongQuan.SoLoaiPhong, Mode=OneWay}" /><Run Text=" loại · sức chứa " /><Run Text="{Binding TongQuan.TongSucChua, Mode=OneWay}" /></TextBlock></Border>
                                    <Border Background="White" BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="8" Padding="12,0" MinHeight="34" Margin="0,0,8,6"><TextBlock VerticalAlignment="Center"><Run Text="Khả dụng " /><Run Text="{Binding TongQuan.SoPhongKhaDung, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource MauThanhCong}" /><Run Text=" · có khách " /><Run Text="{Binding TongQuan.SoPhongCoKhach, Mode=OneWay}" FontWeight="Bold" /><Run Text=" · bảo trì " /><Run Text="{Binding TongQuan.SoPhongBaoTri, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource MauCanhBao}" /></TextBlock></Border>
                                </WrapPanel>
                                <Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
<TextBlock Text="Tầng:" VerticalAlignment="Top" Margin="0,5,6,6" Foreground="{StaticResource MauChuNhat}" FontSize="12" />
<ItemsControl Grid.Column="1" ItemsSource="{Binding TheoTang}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource ChipLocStyle}" Content="{Binding HienThi}" CommandParameter="{Binding Ma, StringFormat=tang:{0}}" Command="{Binding DataContext.LocNhanhCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
</Grid>
                                <Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
<TextBlock Text="Tình trạng:" VerticalAlignment="Top" Margin="0,5,6,6" Foreground="{StaticResource MauChuNhat}" FontSize="12" />
<ItemsControl Grid.Column="1" ItemsSource="{Binding TheoTinhTrang}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource ChipLocStyle}" Content="{Binding HienThi}" CommandParameter="{Binding Ma, StringFormat=tt:{0}}" Command="{Binding DataContext.LocNhanhCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
</Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,4,0,8">
                                <HeaderedContentControl Header="Tìm theo tên phòng, mã phòng hoặc tên loại phòng"><TextBox Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}" /></HeaderedContentControl>
                                <WrapPanel Margin="0,8,0,0">
                                    <HeaderedContentControl Header="Loại phòng" Width="190" Margin="0,0,8,0">
                                        <ComboBox ItemsSource="{Binding LoaiLocTuyChon}" DisplayMemberPath="Ten" SelectedValuePath="Ma" SelectedValue="{Binding LocLoai}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Sắp xếp" Width="160" Margin="0,0,8,0">
                                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SapXep}">
                                            <ComboBoxItem Tag="" Content="Theo mã" IsSelected="True" />
                                            <ComboBoxItem Tag="tang" Content="Theo tầng" />
                                            <ComboBoxItem Tag="loai" Content="Theo loại" />
                                            <ComboBoxItem Tag="tinh_trang" Content="Theo tình trạng" />
                                        </ComboBox>
                                    </HeaderedContentControl>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Button Content="Xóa lọc" Command="{Binding XoaBoLocCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0" />
                                        <Button Content="Tải lại" Command="{Binding LoadCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="{Binding TieuDePhong}" FontWeight="SemiBold" Foreground="{StaticResource MauChinh}" Margin="0,0,0,6" />
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Phongs}" SelectedItem="{Binding SelectedRoom}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" RowHeight="NaN" CanUserSortColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Phòng" Width="*" MinWidth="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,3">
                                                        <TextBlock Text="{Binding TenVaMa}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding LoaiVaTang}" FontSize="11.5" Foreground="{StaticResource MauChuPhu}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding GiaHienThi}" FontSize="11" Foreground="{StaticResource MauChuNhat}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Tình trạng" Width="210">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,3">
                                                        <Border HorizontalAlignment="Left">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource ChipBaseStyle}">
                                                                    <Setter Property="Background" Value="{StaticResource MauPhongOOO}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TinhTrang}" Value="VC"><Setter Property="Background" Value="{StaticResource MauPhongVC}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding TinhTrang}" Value="VI"><Setter Property="Background" Value="{StaticResource MauPhongVI}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding TinhTrang}" Value="VD"><Setter Property="Background" Value="{StaticResource MauPhongVD}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding TinhTrang}" Value="OC"><Setter Property="Background" Value="{StaticResource MauPhongOC}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding TinhTrang}" Value="OD"><Setter Property="Background" Value="{StaticResource MauPhongOD}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding TinhTrangHienThi}" FontSize="11" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="White" />
                                                                        <Style.Triggers><DataTrigger Binding="{Binding TinhTrang}" Value="VI"><Setter Property="Foreground" Value="{StaticResource MauChu}" /></DataTrigger></Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <TextBlock Text="{Binding DongTrangThaiPhu}" FontSize="11" Foreground="{StaticResource MauChuPhu}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding DuLieuHienThi}" FontSize="11" Foreground="{StaticResource MauChuNhat}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Form phòng + thêm hàng loạt -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TieuDeFormPhong}" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" Content="＋ Thêm phòng" Command="{Binding ThemPhongCommand}" Margin="8,0,0,0" Padding="12,5" MinHeight="32" Visibility="{Binding CoTheQuanLy, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <TextBlock Text="Chọn một phòng ở bảng bên trái để xem/sửa, hoặc bấm &quot;Thêm phòng&quot;." Style="{StaticResource HintTextStyle}" Margin="0,8,0,0" Visibility="{Binding KhongCoForm, Converter={StaticResource BoolToVis}}" />

                                <StackPanel Visibility="{Binding CoForm, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                    <TextBlock Text="● Có thay đổi chưa lưu" Foreground="{StaticResource MauCanhBao}" FontWeight="SemiBold" Visibility="{Binding CoThayDoiPhong, Converter={StaticResource BoolToVis}}" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                        <HeaderedContentControl Header="Tên phòng * (≤ 9 ký tự)"><TextBox Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" /></HeaderedContentControl>
                                        <HeaderedContentControl Grid.Column="2" Header="Tầng *"><TextBox Text="{Binding FloorText, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" /></HeaderedContentControl>
                                    </Grid>
                                    <HeaderedContentControl Header="Loại phòng *" Margin="0,10,0,0">
                                        <ComboBox ItemsSource="{Binding RoomTypes}" DisplayMemberPath="TenLoai" SelectedValuePath="MaLoai" SelectedValue="{Binding RoomTypeCode}" IsEnabled="{Binding KhongDoiLoaiDuoc, Converter={StaticResource InverseBooleanConverter}}" />
                                    </HeaderedContentControl>
                                    <TextBlock Text="{Binding LyDoKhongDoiLoaiPhong}" Style="{StaticResource LyDoStyle}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Lưu" Command="{Binding SaveRoomCommand}" MinWidth="90" Visibility="{Binding CoTheQuanLy, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="Hoàn tác" Command="{Binding HoanTacPhongCommand}" Style="{StaticResource OutlineButtonStyle}" />
                                        <Button Content="Xóa phòng" Command="{Binding DeleteRoomCommand}" Style="{StaticResource DangerOutlineButtonStyle}" Margin="0" IsEnabled="{Binding CoTheXoaPhong}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding LyDoKhongXoaPhong}" Style="{StaticResource LyDoStyle}" />

                                    <!-- Đổi tình trạng đúng quy trình -->
                                    <StackPanel Visibility="{Binding CoTheDoiTinhTrang, Converter={StaticResource BoolToVis}}">
                                        <Border Style="{StaticResource DividerStyle}" />
                                        <TextBlock Text="Đổi tình trạng phòng" Style="{StaticResource SubTitleStyle}" />
                                        <TextBlock Text="{Binding NguonTinhTrang}" Style="{StaticResource HintTextStyle}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,6" />
                                        <HeaderedContentControl Header="Chuyển sang">
                                            <ComboBox ItemsSource="{Binding TinhTrangChoPhep}" SelectedItem="{Binding TinhTrangMoi}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource TrangThaiPhongConverter}}" /></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Lý do (bắt buộc khi chuyển sang ngừng phục vụ / bảo trì)" Margin="0,8,0,0">
                                            <TextBox Text="{Binding LyDoTinhTrang, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" />
                                        </HeaderedContentControl>
                                        <Button Content="Đổi tình trạng" Command="{Binding DoiTinhTrangCommand}" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Stretch" Margin="0,10,0,0" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintTextStyle}" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding DangThemPhong, Converter={StaticResource BoolToVis}}"
                                               Text="Phòng mới được tạo ở tình trạng &quot;Trống, đã dọn&quot;. Sau đó chỉ đổi tình trạng theo quy trình (nhận phòng, dọn phòng, bảo trì)." />
                                </StackPanel>

                                <!-- Thêm hàng loạt -->
                                <Border Style="{StaticResource DividerStyle}" Visibility="{Binding CoTheQuanLy, Converter={StaticResource BoolToVis}}" />
                                <Expander Header="Thêm nhiều phòng cùng lúc" Visibility="{Binding CoTheQuanLy, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <HeaderedContentControl Header="Tầng"><TextBox Text="{Binding HangLoatTang, UpdateSourceTrigger=PropertyChanged}" /></HeaderedContentControl>
                                            <HeaderedContentControl Grid.Column="2" Header="Từ số"><TextBox Text="{Binding HangLoatTu, UpdateSourceTrigger=PropertyChanged}" /></HeaderedContentControl>
                                            <HeaderedContentControl Grid.Column="4" Header="Đến số"><TextBox Text="{Binding HangLoatDen, UpdateSourceTrigger=PropertyChanged}" /></HeaderedContentControl>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <HeaderedContentControl Header="Tiền tố"><TextBox Text="{Binding HangLoatTienTo, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" ToolTip="Tùy chọn, VD A → A501" /></HeaderedContentControl>
                                            <HeaderedContentControl Grid.Column="2" Header="Loại phòng">
                                                <ComboBox ItemsSource="{Binding RoomTypes}" DisplayMemberPath="TenLoai" SelectedValuePath="MaLoai" SelectedValue="{Binding HangLoatLoai}" />
                                            </HeaderedContentControl>
                                        </Grid>
                                        <TextBlock Text="{Binding HangLoatXemTruoc}" Style="{StaticResource HintTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <Button Content="Tạo các phòng" Command="{Binding ThemHangLoatCommand}" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= TAB LOẠI PHÒNG ================= -->
            <TabItem Header="Loại phòng">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="400" /><ColumnDefinition Width="14" /><ColumnDefinition Width="500" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Các loại phòng" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="＋ Thêm loại phòng" Command="{Binding ThemLoaiCommand}" Padding="12,5" MinHeight="32" Visibility="{Binding CoTheQuanLy, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding RoomTypes}" SelectedItem="{Binding SelectedRoomType}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" RowHeight="NaN" CanUserSortColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Loại phòng" Width="*" MinWidth="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4">
                                                    <TextBlock Text="{Binding TenLoai}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ChiTietHienThi}" FontSize="11.5" Foreground="{StaticResource MauChuPhu}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding TienNghi}" FontSize="11" Foreground="{StaticResource MauChuNhat}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Giá" Width="170">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4">
                                                    <TextBlock Text="{Binding GiaHienThi}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding PhongHienThi}" FontSize="11.5" Foreground="{StaticResource MauChuPhu}" />
                                                    <TextBlock Text="{Binding DatSapToiHienThi}" FontSize="11" Foreground="{StaticResource MauThongTin}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding TieuDeFormLoai}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="Chọn một loại phòng ở bảng bên trái, hoặc bấm &quot;Thêm loại phòng&quot;." Style="{StaticResource HintTextStyle}" Margin="0,8,0,0" Visibility="{Binding KhongCoFormLoai, Converter={StaticResource BoolToVis}}" />
                                <StackPanel Visibility="{Binding CoFormLoai, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                    <TextBlock Text="● Có thay đổi chưa lưu" Foreground="{StaticResource MauCanhBao}" FontWeight="SemiBold" Visibility="{Binding CoThayDoiLoai, Converter={StaticResource BoolToVis}}" />
                                    <HeaderedContentControl Header="Tên loại phòng *" Margin="0,4,0,0"><TextBox Text="{Binding TypeName, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" /></HeaderedContentControl>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <HeaderedContentControl Header="Sức chứa (người) *"><TextBox Text="{Binding CapacityText, UpdateSourceTrigger=PropertyChanged}" /></HeaderedContentControl>
                                        <HeaderedContentControl Grid.Column="2" Header="Đơn giá/đêm (VND) *"><TextBox ctl:MoneyInput.DinhDang="True" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding KhongSuaGia}" ToolTip="Chỉ người có quyền quản lý giá được đổi đơn giá" /></HeaderedContentControl>
                                        <HeaderedContentControl Grid.Column="4" Header="Phụ thu (VND)"><TextBox ctl:MoneyInput.DinhDang="True" Text="{Binding SurchargeText, UpdateSourceTrigger=PropertyChanged}" /></HeaderedContentControl>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <HeaderedContentControl Header="Diện tích (m²)"><TextBox Text="{Binding DienTichText, UpdateSourceTrigger=PropertyChanged}" /></HeaderedContentControl>
                                        <HeaderedContentControl Grid.Column="2" Header="Loại giường"><TextBox Text="{Binding LoaiGiuong, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" /></HeaderedContentControl>
                                    </Grid>
                                    <HeaderedContentControl Header="Tiện nghi (cách nhau bằng dấu phẩy)" Margin="0,10,0,0"><TextBox Text="{Binding TienNghi, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" /></HeaderedContentControl>
                                    <HeaderedContentControl Header="Mô tả hiển thị trên website" Margin="0,10,0,0"><TextBox Text="{Binding MoTa, UpdateSourceTrigger=PropertyChanged}" Height="66" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MaxLength="1000" /></HeaderedContentControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Lưu" Command="{Binding SaveRoomTypeCommand}" MinWidth="90" Visibility="{Binding CoTheQuanLy, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="Hoàn tác" Command="{Binding HoanTacLoaiCommand}" Style="{StaticResource OutlineButtonStyle}" />
                                        <Button Content="Xóa loại phòng" Command="{Binding DeleteRoomTypeCommand}" Style="{StaticResource DangerOutlineButtonStyle}" Margin="0" IsEnabled="{Binding CoTheXoaLoai}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding LyDoKhongXoaLoai}" Style="{StaticResource LyDoStyle}" />
                                    <TextBlock Style="{StaticResource HintTextStyle}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="Đổi đơn giá chỉ áp dụng cho đặt phòng MỚI: đặt phòng đã tạo và hóa đơn cũ giữ nguyên giá đã chốt. Quy tắc giá theo ngày lễ / cuối tuần cấu hình ở màn Bảng giá phòng." />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= TAB ẢNH ================= -->
            <TabItem Header="Ảnh &amp; website">
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Ảnh phòng" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding HuongDanAnh}" Margin="0,4,0,12" Style="{StaticResource HintTextStyle}" FontSize="12.5" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding AnhCuaLoaiPhong}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><ContentControl Content="{Binding}" ContentTemplate="{StaticResource AnhPhongOTemplate}" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Ảnh dùng chung cho Website" Style="{StaticResource SubTitleStyle}" Margin="0,6,0,8" />
                            <ContentControl Content="{Binding AnhBanner}" ContentTemplate="{StaticResource AnhPhongOTemplate}" HorizontalAlignment="Left" />
                            <ctl:NoticeBar Text="{Binding ThongBaoAnh}" IsError="{Binding ThongBaoAnhLaLoi}" Margin="0,2,0,0" />
                            <TextBlock Text="Định dạng JPG, PNG hoặc WEBP, tối đa 5 MB. Nên dùng ảnh ngang tỉ lệ khoảng 16:9. Mô tả, diện tích, giường và tiện nghi nhập ở tab &quot;Loại phòng&quot; cũng hiển thị trên website." Margin="0,10,0,0" Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
