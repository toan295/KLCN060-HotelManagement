<UserControl x:Class="KLCN060.Desktop.Views.D8ThanhToanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:KLCN060.Desktop.Controls">
    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ctl:PageHeader Title="Thanh toán hóa đơn" Subtitle="Tìm hóa đơn (tên khách, SĐT, phòng, mã) → kiểm tra đúng khách và số tiền → thu tiền mặt hoặc tạo mã QR chuyển khoản." />

        <ScrollViewer x:Name="CuonTrang" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
        <!-- Hai bước theo chiều dọc (đủ rộng cho bảng hóa đơn); chọn hóa đơn xong trang tự cuộn tới bước 2 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Tìm hóa đơn (toàn chiều rộng: đủ cột, không bị cắt chữ) -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="1. Tìm hóa đơn" Style="{StaticResource CardTitleStyle}" />
                    <Grid Margin="0,10,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <HeaderedContentControl Header="Tìm hóa đơn (tên khách, số điện thoại, số phòng, mã hóa đơn hoặc mã phiếu)">
                            <Grid>
                                <TextBox x:Name="OTimKiem" Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}" ToolTip="Gõ tên khách, số điện thoại, số phòng (VD P302), mã hóa đơn (HD...) hoặc mã phiếu rồi nhấn Enter. Để trống rồi tìm để xem mọi hóa đơn còn nợ.">
                                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding TimCommand}" /></TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Text="Ví dụ: Nguyen An, 0912..., P302, HD2026..." Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding GoiYTimHien}" Value="True" /><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=OTimKiem}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            </Grid>
                        </HeaderedContentControl>
                        <Button Grid.Column="2" Content="Tìm hóa đơn" Command="{Binding TimCommand}" Margin="0" MinWidth="120" VerticalAlignment="Bottom" />
                    </Grid>
                    <CheckBox Content="Chỉ hóa đơn còn nợ (bỏ tick để tra cả hóa đơn đã thanh toán)" IsChecked="{Binding ChiConNo}" Margin="0,0,0,8" />
                    <DataGrid AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MaxHeight="260" MinHeight="70" SelectionChanged="DanhSach_SelectionChanged" ItemsSource="{Binding DanhSach}" SelectedItem="{Binding DongDaChon}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="160" Header="Mã hóa đơn" Binding="{Binding MaHD}" />
                            <DataGridTextColumn Width="*" MinWidth="140" Header="Khách" Binding="{Binding HoTenKhach}" />
                            <DataGridTemplateColumn Width="130" Header="Phòng">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DanhSachPhong}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,2" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="120" Header="Tổng tiền" Binding="{Binding TongTien, Converter={StaticResource VndMoneyConverter}}" />
                            <DataGridTextColumn Width="120" Header="Đã thu" Binding="{Binding DaThanhToan, Converter={StaticResource VndMoneyConverter}}" />
                            <DataGridTextColumn Width="120" Header="Còn nợ" Binding="{Binding ConNo, Converter={StaticResource VndMoneyConverter}}" />
                            <DataGridTextColumn Width="160" Header="Trạng thái" Binding="{Binding TrangThaiHienThi}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 2. Hóa đơn + thu tiền -->
            <Border x:Name="BuocThuTien" Grid.Row="1" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Margin="0">
                        <TextBlock Text="2. Kiểm tra và thu tiền" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Margin="0,8,0,0" Text="Chọn một hóa đơn ở bảng phía trên để xem khách, phòng và số tiền cần thu.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                                    <Style.Triggers><DataTrigger Binding="{Binding CoHoaDon}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Visibility="{Binding CoHoaDon, Converter={StaticResource BoolToVis}}">
                            <!-- Đang thu tiền cho ai -->
                            <Border Style="{StaticResource InsetStyle}" Padding="12,10" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding TongQuan.KhachHienThi, StringFormat='THU TIỀN CHO: {0}'}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding TongQuan.BookingHienThi}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <ItemsControl ItemsSource="{Binding TongQuan.Phong}" Margin="0,3,0,0">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding HienThi}" Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding TongQuan.MaHD, StringFormat='Hóa đơn {0}'}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding TongQuan.LapHienThi}" Style="{StaticResource HintTextStyle}" />
                                    <TextBlock Text="{Binding TongQuan.TrangThaiHienThi, StringFormat='Trạng thái: {0}'}" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding TongQuan.CanhBao}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='⚠ {0}'}" Foreground="{StaticResource MauNguyHiem}" TextWrapping="Wrap" Margin="0,2,0,0" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Cơ cấu tiền: tổng - giảm - cọc = phải thu - đã thu = còn nợ -->
                            <Border Style="{StaticResource DividerStyle}" />
                            <TextBlock Text="{Binding TongQuan.CoCauHienThi}" TextWrapping="Wrap" />
                            <Grid Margin="0,8,0,4"><TextBlock Text="Tổng phải thanh toán (đã trừ cọc/giảm giá)" FontWeight="SemiBold" /><TextBlock Text="{Binding TongQuan.TongTien, StringFormat={}{0:N0}đ}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                            <Grid><TextBlock Text="Đã thanh toán" Foreground="{StaticResource MauChuNhat}" /><TextBlock Text="{Binding TongQuan.DaThu, StringFormat={}{0:N0}đ}" HorizontalAlignment="Right" /></Grid>
                            <Border Background="{StaticResource MauChinhNhat}" CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
                                <Grid>
                                    <TextBlock Text="CÒN PHẢI THU" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TongQuan.ConNo, StringFormat={}{0:N0}đ}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource MauChinhDam}" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                            <TextBlock Text="✔ Hóa đơn đã thanh toán đủ - không còn gì để thu." FontWeight="Bold" Foreground="{StaticResource MauThanhCong}" Margin="0,8,0,0"
                                       Visibility="{Binding DaThuDu, Converter={StaticResource BoolToVis}}" />

                            <!-- Lịch sử thanh toán -->
                            <TextBlock Text="Các lần đã thu" Style="{StaticResource SubTitleStyle}" Margin="0,14,0,0" />
                            <TextBlock Text="Chưa có lần thanh toán nào." Style="{StaticResource HintTextStyle}" Margin="0,4,0,0" Visibility="{Binding TongQuan.KhongCoThanhToan, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding TongQuan.ThanhToan}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding HienThi}" TextWrapping="Wrap" Margin="0,2,0,0" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Thu tiền -->
                            <Border Style="{StaticResource DividerStyle}" Margin="0,14,0,10" />
                            <StackPanel IsEnabled="{Binding ChoPhepThu}">
                                <HeaderedContentControl Header="Hình thức thanh toán">
                                    <ComboBox SelectedValue="{Binding HinhThuc}" SelectedValuePath="Tag">
                                        <ComboBoxItem Tag="TIEN_MAT" Content="Tiền mặt" />
                                        <ComboBoxItem Tag="CHUYEN_KHOAN" Content="Chuyển khoản (quét mã QR)" />
                                    </ComboBox>
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="Số tiền thu" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SoTien, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource VndInputConverter}}" ctl:MoneyInput.DinhDang="True" MaxLength="15" />
                                        <Button Grid.Column="2" Content="Thu đủ" Command="{Binding DienConNoCommand}" Style="{StaticResource OutlineButtonStyle}" MinHeight="34" Padding="14,4" Margin="0" VerticalAlignment="Center" ToolTip="Điền đúng số còn nợ (mặc định); sửa số nếu khách chỉ trả một phần" />
                                    </Grid>
                                </HeaderedContentControl>
                                <TextBlock Text="{Binding SoTienKiemTra}" FontWeight="SemiBold" Foreground="{StaticResource MauChinhDam}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers><DataTrigger Binding="{Binding LaChuyenKhoan}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <HeaderedContentControl Header="Khách đưa (tiền mặt, không bắt buộc - để tính tiền thối)" Margin="0,12,0,0">
                                        <TextBox Text="{Binding KhachDua, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource VndInputConverter}}" ctl:MoneyInput.DinhDang="True" MaxLength="15" />
                                    </HeaderedContentControl>
                                    <TextBlock Text="{Binding TienThoiHienThi}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding ChuyenKhoanDangChoHienThi}" Foreground="{StaticResource MauNguyHiem}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding CoChuyenKhoanDangCho, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Theo dõi mã QR đang chờ" Command="{Binding TheoDoiQrDangChoCommand}" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Visibility="{Binding CoChuyenKhoanDangCho, Converter={StaticResource BoolToVis}}" />

                            <!-- Tiền mặt: nhân viên xác nhận đã thu. Chuyển khoản: KHÔNG có nút "đã nhận" - phải tạo mã QR và chờ ngân hàng báo tiền về. -->
                            <Button Content="Xác nhận thu tiền" Command="{Binding ThuTienCommand}" HorizontalAlignment="Stretch" Margin="0,14,0,0" IsEnabled="{Binding ChoPhepThu}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LaChuyenKhoan}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Tạo mã QR chuyển khoản" Command="{Binding TaoQrCommand}" HorizontalAlignment="Stretch" Margin="0,14,0,0" IsEnabled="{Binding ChoPhepThu}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LaChuyenKhoan}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Text="Đang xử lý..." Style="{StaticResource HintTextStyle}" HorizontalAlignment="Right" Margin="0,4,0,0" Visibility="{Binding DangThuTien, Converter={StaticResource BoolToVis}}" />

                            <Border Visibility="{Binding CoKetQuaThu, Converter={StaticResource BoolToVis}}" Style="{StaticResource InsetStyle}" Padding="12,10" Margin="0,12,0,0">
                                <TextBlock Text="{Binding KetQuaThu}" TextWrapping="Wrap" />
                            </Border>

                        <Border Margin="0,12,0,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource InsetStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChuyenKhoan}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="Chuyển khoản qua mã QR" Style="{StaticResource SubTitleStyle}" />
                                <TextBlock Margin="0,3,0,0" Style="{StaticResource HintTextStyle}"
                                           Text="Mã QR chuẩn VietQR, giống mã thanh toán đặt phòng trên website: quét bằng ứng dụng ngân hàng sẽ hiện đúng tài khoản, số tiền, nội dung. Mô phỏng - không chuyển tiền thật." />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="White" BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="8" Padding="6" VerticalAlignment="Top">
                                        <Image Source="{Binding AnhQr}" Width="132" Height="132" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding ChuyenKhoan.NganHang.TenNganHang}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding ChuyenKhoan.NganHang.SoTaiKhoan, StringFormat=Số TK: {0}}" />
                                        <TextBlock Margin="0,5,0,0" FontSize="12" FontWeight="SemiBold" Text="{Binding ChuyenKhoan.SoTien, StringFormat=Số tiền: {0:N0}đ}" />
                                        <TextBlock Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding ChuyenKhoan.NoiDungChuyenKhoan, StringFormat=Nội dung: {0}}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Foreground="{StaticResource MauThongTin}" TextWrapping="Wrap" Text="{Binding TrangThaiChuyenKhoan}" />
                                <TextBlock Margin="0,2,0,0" Foreground="{StaticResource MauChuNhat}" Text="{Binding DemNguoc, StringFormat=Còn lại: {0}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DangChoChuyenKhoan}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Visibility="{Binding DangChoChuyenKhoan, Converter={StaticResource BoolToVis}}"
                                           Text="Mở ứng dụng ngân hàng, quét mã để thấy tài khoản, số tiền và nội dung (mô phỏng, không chuyển tiền thật). Khách xác nhận đã chuyển thì bấm nút bên dưới." />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Xác nhận đã chuyển khoản" Command="{Binding XacNhanDaChuyenKhoanCommand}" IsEnabled="{Binding DangChoChuyenKhoan}"
                                            Style="{StaticResource AccentButtonStyle}" Padding="14,4" MinHeight="30" FontSize="12" Margin="0,0,10,6" />
                                    <Button Content="Hủy" Command="{Binding HuyChuyenKhoanCommand}" IsEnabled="{Binding DangChoChuyenKhoan}"
                                            Style="{StaticResource OutlineButtonStyle}" Padding="12,4" MinHeight="30" FontSize="12" Margin="0,0,0,6" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                            <Button Content="Xuất hóa đơn PDF (khi đã thanh toán đủ)" Command="{Binding XuatPdfCommand}" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Stretch" Margin="0,12,0,0" />

                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        </ScrollViewer>

        <!-- Kết quả thao tác: xanh khi thành công, đỏ khi lỗi (ThongBaoLaLoi do ViewModel xác định) -->
        <ctl:NoticeBar Grid.Row="2" Text="{Binding ThongBao}" IsError="{Binding ThongBaoLaLoi}" Margin="0,12,0,0" />
    </Grid>
</UserControl>
