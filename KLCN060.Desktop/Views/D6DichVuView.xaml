<UserControl x:Class="KLCN060.Desktop.Views.D6DichVuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:KLCN060.Desktop.Controls">
    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ctl:PageHeader Title="Dịch vụ" Subtitle="Chọn khách đang ở → ghi dịch vụ (xem rõ đơn giá và thành tiền) → kiểm tra các dòng đã ghi. Dịch vụ được cộng vào hóa đơn khi trả phòng." />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
        <Grid>          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <!-- 1. Chọn khách đang ở (toàn chiều rộng để đủ cột loại phòng, ngày nhận, ngày trả - không bị cắt chữ) -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="1. Khách đang ở" Style="{StaticResource CardTitleStyle}" />
                    <HeaderedContentControl Margin="0,10,0,8" Header="Tìm khách đang ở (số phòng, tên khách, mã phiếu nhận hoặc mã phiếu đặt)">
                        <Grid>
                            <TextBox x:Name="OTimKiem" Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}" ToolTip="Gõ số phòng (VD P302), tên khách hoặc mã phiếu để lọc danh sách bên dưới; không cần gõ dấu. Xóa chữ để xem lại tất cả." />
                            <TextBlock Text="Ví dụ: P302, Nguyen An, BK2026..." Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding GoiYTimHien}" Value="True" /><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=OTimKiem}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </Grid>
                    </HeaderedContentControl>
                    <Grid>
                        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MaxHeight="150" MinHeight="70" ItemsSource="{Binding Luot}" SelectedItem="{Binding LuotDaChon}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="80" Header="Phòng" Binding="{Binding MaPhong}" />
                                <DataGridTextColumn Width="140" Header="Loại phòng" Binding="{Binding TenLoai}" />
                                <DataGridTextColumn Width="*" MinWidth="150" Header="Khách" Binding="{Binding KhachHienThi}" />
                                <DataGridTextColumn Width="115" Header="Ngày nhận" Binding="{Binding NgayNhanHienThi}" />
                                <DataGridTextColumn Width="170" Header="Trả phòng (dự kiến)" Binding="{Binding NgayTraHienThi}" />
                                <DataGridTextColumn Width="90" Header="Số người" Binding="{Binding SoNguoi}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Không có khách nào đang ở khớp với từ khóa." Style="{StaticResource HintTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding KhongCoLuot, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <Border Style="{StaticResource InsetStyle}" Padding="12,10" Margin="0,10,0,0">
                        <TextBlock Text="{Binding DangGhiChoHienThi}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Border>

          <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="2. Ghi dịch vụ" Style="{StaticResource SubTitleStyle}" />
                        <HeaderedContentControl Header="Dịch vụ (kèm đơn giá)" Margin="0,8,0,0">
                            <ComboBox ItemsSource="{Binding DichVu}" DisplayMemberPath="TenDV" SelectedItem="{Binding DichVuDaChon}" IsEnabled="{Binding CoLuotDaChon}" />
                        </HeaderedContentControl>

                        <!-- Thông tin chi tiết của dịch vụ đang chọn (bảng ChiTietDichVus) để lễ tân tư vấn cho khách -->
                        <Border Margin="0,10,0,0" Padding="14,10">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource InsetStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DichVuDaChon}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding DichVuDaChon.ChiTiets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,0,0,4" TextWrapping="Wrap" Foreground="{StaticResource MauChuPhu}" FontSize="12.5">
                                                <Run Text="{Binding TieuDe, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding NoiDung, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <HeaderedContentControl Header="Số lượng (1 - 999)" Margin="0,12,0,0">
                            <TextBox Text="{Binding SoLuong, UpdateSourceTrigger=PropertyChanged}" />
                        </HeaderedContentControl>
                        <TextBlock Text="{Binding TinhTienDichVu}" FontWeight="Bold" Foreground="{StaticResource MauChinhDam}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <Button Content="Ghi dịch vụ" Command="{Binding ThemCommand}" HorizontalAlignment="Right" MinWidth="170" Margin="0,14,0,0"
                                IsEnabled="{Binding DangThem, Converter={StaticResource InverseBooleanConverter}}" />

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="3. Các dòng đã ghi cho phòng này" Style="{StaticResource CardTitleStyle}" />
                        <DataGrid Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300" MinHeight="70" SelectionMode="Single" ItemsSource="{Binding DaDung}" SelectedItem="{Binding DongDaChon}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="120" Header="Lúc ghi" Binding="{Binding ThoiGianHienThi}" />
                                <DataGridTextColumn Width="*" MinWidth="130" Header="Dịch vụ" Binding="{Binding TenDV}" />
                                <DataGridTextColumn Width="60" Header="SL" Binding="{Binding SoLuong}" />
                                <DataGridTextColumn Width="110" Header="Đơn giá" Binding="{Binding DonGiaHienThi}" />
                                <DataGridTextColumn Width="125" Header="Thành tiền" Binding="{Binding ThanhTien, Converter={StaticResource VndMoneyConverter}}" />
                                <DataGridTemplateColumn Width="230" Header="Người ghi">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding NguoiGhiHienThi}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,2" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="140" Header="Trạng thái" Binding="{Binding TrangThaiHienThi}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Style="{StaticResource InsetStyle}" Background="{StaticResource MauChinhNhat}" BorderBrush="Transparent" Padding="14,10" Margin="0,10,0,0">
                            <Grid>
                                <TextBlock Text="Tổng cộng (phòng này)" FontWeight="SemiBold" Foreground="{StaticResource MauChinhDam}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TongCong, StringFormat={}{0:N0}đ}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource MauChinhDam}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding TongHienThi}" Style="{StaticResource HintTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Text="Ghi nhầm dịch vụ/số lượng? Chọn dòng ở bảng trên, nhập lý do rồi hủy (chỉ khi chưa lập hóa đơn; có ghi nhật ký người hủy + lý do)." />
                        <TextBlock Text="{Binding TrangThaiDongHienThi}" TextWrapping="Wrap" Margin="0,4,0,0" FontWeight="SemiBold" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding LyDoHuyDong, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" ToolTip="Lý do hủy (bắt buộc): ghi nhầm dịch vụ hoặc số lượng..." />
                            <Button Grid.Column="2" Content="Hủy dòng đã chọn" Command="{Binding HuyDongCommand}" Style="{StaticResource DangerOutlineButtonStyle}" Margin="0"
                                    IsEnabled="{Binding HuyDuoc}" />
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
          </Grid>
        </Grid>

        </ScrollViewer>

        <ctl:NoticeBar Grid.Row="2" Text="{Binding ThongBao}" IsError="{Binding ThongBaoLaLoi}" Margin="0,12,0,0" />
    </Grid>
</UserControl>
