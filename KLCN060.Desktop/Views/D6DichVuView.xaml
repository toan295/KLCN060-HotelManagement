<UserControl x:Class="KLCN060.Desktop.Views.D6DichVuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28" Background="#F5F6F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Quản lý sử dụng dịch vụ"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#123328" />

        <Grid Grid.Row="1" Margin="0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="20" Background="White" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Thêm dịch vụ cho phòng" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Margin="0,18,0,5" Text="Lượt lưu trú đang ở" />
                    <ComboBox Height="34"
                              ItemsSource="{Binding Luot}"
                              DisplayMemberPath="MaPhong"
                              SelectedItem="{Binding LuotDaChon}" />
                    <TextBlock Margin="0,14,0,5" Text="Dịch vụ" />
                    <ComboBox Height="34"
                              ItemsSource="{Binding DichVu}"
                              DisplayMemberPath="TenDV"
                              SelectedItem="{Binding DichVuDaChon}" />
                    <TextBlock Margin="0,14,0,5" Text="Số lượng" />
                    <TextBox Height="34" Text="{Binding SoLuong}" />
                    <Button Width="150"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Center"
                            Command="{Binding ThemCommand}"
                            Content="Thêm dịch vụ" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Padding="20" Background="White" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Dịch vụ đã sử dụng" FontSize="18" FontWeight="SemiBold" />
                    <DataGrid Grid.Row="1"
                              Margin="0,14"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding DaDung}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Header="Dịch vụ" Binding="{Binding TenDV}" />
                            <DataGridTextColumn Width="70" Header="SL" Binding="{Binding SoLuong}" />
                            <DataGridTextColumn Width="130"
                                                Header="Thành tiền"
                                                Binding="{Binding ThanhTien, Converter={StaticResource VndMoneyConverter}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding TongCong, StringFormat=Tổng cộng: {0:N0}đ}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextAlignment="Right" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#C8452F"
                                   Text="{Binding ThongBao}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
