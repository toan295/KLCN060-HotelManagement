<UserControl x:Class="KLCN060.Desktop.Views.D3DatPhongView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F5F6F0" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Đặt phòng" FontSize="26" FontWeight="Bold" Foreground="#123328" />
            <TextBlock Text="Chọn khách hàng, thời gian lưu trú và loại phòng cần đặt." Margin="0,5,0,0" Foreground="#647A6C" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" BorderBrush="#D7DDCE" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.08" /></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="1. Chọn khách hàng" FontSize="18" FontWeight="SemiBold" Foreground="#123328" />
                    <Grid Grid.Row="1" Margin="0,14,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding TuKhoaKhach, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" />
                        <Button Grid.Column="1" Content="Tìm khách" Command="{Binding TimKhachCommand}" Margin="0" />
                    </Grid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding DanhSachKhach}" SelectedItem="{Binding KhachDaChon}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="*" />
                            <DataGridTextColumn Header="Số điện thoại" Binding="{Binding SoDT}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="3" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Ngày nhận" Foreground="#3C4C40" /><DatePicker SelectedDate="{Binding NgayNhan}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Ngày trả" Foreground="#3C4C40" /><DatePicker SelectedDate="{Binding NgayTra}" /></StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20" BorderBrush="#D7DDCE" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.08" /></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="2. Chọn phòng" FontSize="18" FontWeight="SemiBold" Foreground="#123328" />
                    <Grid Grid.Row="1" Margin="0,14,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="100" /><ColumnDefinition Width="118" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Loại phòng" Foreground="#3C4C40" /><ComboBox ItemsSource="{Binding DanhSachLoaiPhong}" DisplayMemberPath="TenLoai" SelectedItem="{Binding LoaiPhongDaChon}" Height="34" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Số lượng" Foreground="#3C4C40" /><TextBox Text="{Binding SoLuong}" /></StackPanel>
                        <Button Grid.Column="3" Content="Thêm phòng" Command="{Binding ThemPhongCommand}" VerticalAlignment="Bottom" Margin="10,0,0,0" />
                    </Grid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding DanhSachPhongDat}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Loại phòng" Binding="{Binding TenLoai}" Width="*" />
                            <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="18" BorderBrush="#D7DDCE" BorderThickness="1">
            <StackPanel HorizontalAlignment="Center" MinWidth="500">
                <TextBlock Text="{Binding ThongBao}" Foreground="#C8452F" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14" MinHeight="22" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Tạo đặt phòng" Command="{Binding TaoDatPhongCommand}" MinWidth="150" Margin="0,0,12,0" />
                    <Button Content="Xác nhận đã thu cọc" Command="{Binding XacNhanCocCommand}" MinWidth="180" Background="#C08A3E" BorderBrush="#C08A3E" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
