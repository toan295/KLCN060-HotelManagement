<UserControl x:Class="KLCN060.Desktop.Views.D3DatPhongView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Background="#F5F6F0" Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Đặt phòng" FontSize="26" FontWeight="Bold" Foreground="#123328"/><Grid Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Tìm khách hàng"/><TextBox Text="{Binding TuKhoaKhach}"/><Button Content="Tìm khách" Command="{Binding TimKhachCommand}"/><DataGrid ItemsSource="{Binding DanhSachKhach}" SelectedItem="{Binding KhachDaChon}" AutoGenerateColumns="False" Height="160"><DataGrid.Columns><DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="*"/><DataGridTextColumn Header="SĐT" Binding="{Binding SoDT}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Text="Ngày nhận / trả" Margin="0,12,0,0"/><DatePicker SelectedDate="{Binding NgayNhan}"/><DatePicker SelectedDate="{Binding NgayTra}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Loại phòng và số lượng"/><ComboBox ItemsSource="{Binding DanhSachLoaiPhong}" DisplayMemberPath="TenLoai" SelectedItem="{Binding LoaiPhongDaChon}" Height="34"/><TextBox Text="{Binding SoLuong}"/><Button Content="Thêm loại phòng" Command="{Binding ThemPhongCommand}"/><DataGrid ItemsSource="{Binding DanhSachPhongDat}" AutoGenerateColumns="False" Height="150"><DataGrid.Columns><DataGridTextColumn Header="Loại phòng" Binding="{Binding TenLoai}" Width="*"/><DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="*"/></DataGrid.Columns></DataGrid><Button Content="Tạo đặt phòng" Command="{Binding TaoDatPhongCommand}"/><Button Content="Xác nhận đã thu cọc" Command="{Binding XacNhanCocCommand}"/><TextBlock Text="{Binding ThongBao}" Foreground="#C8452F" TextWrapping="Wrap"/></StackPanel></Grid></Grid></UserControl>
