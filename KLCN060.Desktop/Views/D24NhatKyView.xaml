<UserControl x:Class="KLCN060.Desktop.Views.D24NhatKyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:KLCN060.Desktop.Controls">
    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ctl:PageHeader Title="Nhật ký hệ thống"
                        Subtitle="Ai đã làm gì, lúc nào, kết quả ra sao (kể cả thao tác bị từ chối hoặc thất bại). Chỉ xem, không sửa hay xóa được." />

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,16,0,10" Padding="18,12">
            <StackPanel>
                <WrapPanel>
                    <HeaderedContentControl Header="Từ ngày" Width="135" Margin="0,0,10,8"><DatePicker x:Name="TuNgay" SelectedDate="{Binding LocTuNgay}" AutomationProperties.AutomationId="NhatKyTuNgay" /></HeaderedContentControl>
                    <HeaderedContentControl Header="Đến ngày" Width="135" Margin="0,0,10,8"><DatePicker x:Name="DenNgay" SelectedDate="{Binding LocDenNgay}" AutomationProperties.AutomationId="NhatKyDenNgay" /></HeaderedContentControl>
                    <HeaderedContentControl Header="Tên đăng nhập" Width="150" Margin="0,0,10,8"><TextBox Text="{Binding LocTaiKhoan, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="NhatKyTaiKhoan" /></HeaderedContentControl>
                    <HeaderedContentControl Header="Kết quả" Width="150" Margin="0,0,10,8">
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding LocKetQua}" AutomationProperties.AutomationId="NhatKyKetQua">
                            <ComboBoxItem Tag="" Content="Tất cả" IsSelected="True" />
                            <ComboBoxItem Tag="THANH_CONG" Content="Thành công" />
                            <ComboBoxItem Tag="THAT_BAI" Content="Thất bại" />
                            <ComboBoxItem Tag="TU_CHOI" Content="Bị từ chối" />
                        </ComboBox>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Từ khóa (hành động, đối tượng, chi tiết)" Width="300" Margin="0,0,10,8"><TextBox Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="NhatKyTuKhoa" /></HeaderedContentControl>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <Button Content="Lọc" Command="{Binding TimCommand}" IsDefault="True" MinWidth="80" AutomationProperties.AutomationId="NhatKyLoc" />
                        <Button Content="Xóa lọc" Command="{Binding DatLaiCommand}" Style="{StaticResource OutlineButtonStyle}" AutomationProperties.AutomationId="NhatKyXoaLoc" />
                        <Button Content="Tải lại" Command="{Binding TaiLaiCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <ctl:NoticeBar Grid.Row="2" Text="{Binding ThongBao}" IsError="{Binding ThongBaoLaLoi}" Margin="0,0,0,8" />

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding DanhSach}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" AutomationProperties.AutomationId="NhatKyBang">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Thời gian" Width="140" Binding="{Binding ThoiGian, StringFormat=dd/MM/yyyy HH:mm:ss}" />
                    <DataGridTextColumn Header="Người thực hiện" Width="190" Binding="{Binding NguoiHienThi}" />
                    <DataGridTextColumn Header="Tên đăng nhập" Width="110" Binding="{Binding TaiKhoan}" />
                    <DataGridTextColumn Header="Hành động" Width="230" Binding="{Binding MoTaHanhDong}" />
                    <DataGridTextColumn Header="Đối tượng" Width="140" Binding="{Binding DoiTuongTacDong}" />
                    <DataGridTemplateColumn Header="Kết quả" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding KetQuaHienThi}" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource MauThanhCong}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding KetQua}" Value="THAT_BAI"><Setter Property="Foreground" Value="{StaticResource MauNguyHiem}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding KetQua}" Value="TU_CHOI"><Setter Property="Foreground" Value="{StaticResource MauNguyHiem}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Mã lỗi" Width="150" Binding="{Binding MaLoi}" />
                    <DataGridTemplateColumn Header="Chi tiết" Width="360">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding ChiTiet}" TextWrapping="Wrap" FontSize="12" Margin="4,2" ToolTip="{Binding ChiTiet}" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Địa chỉ IP" Width="110" Binding="{Binding DiaChiIP}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding TomTat}" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" AutomationProperties.AutomationId="NhatKyTomTat" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="‹ Trước" Command="{Binding TrangTruocCommand}" Style="{StaticResource OutlineButtonStyle}" AutomationProperties.AutomationId="NhatKyTrangTruoc" />
                <Button Content="Sau ›" Command="{Binding TrangSauCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0" AutomationProperties.AutomationId="NhatKyTrangSau" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
